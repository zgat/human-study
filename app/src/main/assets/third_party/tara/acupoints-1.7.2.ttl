TARA:6893448 a owl:Class ;
    rdfs:label "BL 48" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 123. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 8, Acupuncture Points of the Shaoyin and Taiyang Meridians. ISBN 978-7-119-01758-7." ;
    tara-ap:hasChineseLabel "陽(阳)綱(纲)" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0008231 ;
    tara-ap:hasListedIndications "abdominal pain",
        "borborygmus",
        "diarrhea",
        "jaundice",
        "pain in the hypochondriac region" ;
    tara-ap:hasLocationalDescription """In the upper back region, at the same level as the inferior border of the spinous process of the tenth thoracic vertebra (T10), 3 B-cun lateral to the posterior median line.
 - Note: BL 48, BL 19 and GV 7 are located at the same level as the inferior border of the spinous process of the tenth thoracic vertebra (T10).""" ;
    tara-ap:hasMethodDescription "Puncture obliquely 0.3-0.5 inch. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Yanggang" ;
    tara-ap:hasSpecificReferenceLocation UBERON:0004634,
        ILX:0795312 ;
    tara-ap:hasSynonym "B 48",
        "Bladder 48",
        "UB 48",
        "Urinary Bladder 48" ;
    tara-ap:hasVasculatureInformation "The posterior branches of the intercostal artery and vein. Innervation: The lateral cutaneous branches of the posterior rami of the eighth and ninth thoracic nerves." ;
    tara-ap:isLocatedOnMeridian TARA:7525476 ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( TARA:5151019 [ a owl:Restriction ;
                        owl:onProperty tara-op:isLocatedOnMeridian ;
                        owl:someValuesFrom TARA:7525476 ] ) ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificReferenceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0004634 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificReferenceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom ILX:0795312 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasGeneralSurfaceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0008231 ] ] .

TARA:6894093 a owl:Class ;
    rdfs:label "SP 2" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 70. https://iris.who.int/handle/10665/353407",
