    foaf:depiction "https://cdn.humanatlas.io/digital-objects/ref-organ/blood-vasculature-male/v1.3/assets/3d-vh-m-blood-vasculature.glb"^^xsd:anyURI,
        "https://upload.wikimedia.org/wikipedia/commons/6/65/Iliac_veins.gif"^^xsd:anyURI .

