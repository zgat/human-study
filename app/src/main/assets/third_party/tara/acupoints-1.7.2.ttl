        TARA:0926802 .

TARA:5282844 a owl:Class ;
    rdfs:label "Stomach Meridian Acupoint" ;
    dcterms:bibliographicCitation "WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. https://iris.who.int/handle/10665/353407" ;
    dcterms:description "An acupuncture point that is located along the Stomach Meridian of Foot-Yangming (ST), which consists of 45 standardized acupoints beginning at ST 1 (Chengqi) on the face between the eyeball and the infraorbital margin directly below the pupil, traveling down across the face, neck, chest, and abdomen and continuing along the anterior-lateral aspect of the leg, and ending at ST 45 (Lidui) on the lateral side of the second toe near the corner of the nail." ;
    tara-ap:hasSynonym "Acupoint of Stomach Meridian",
        "Acupoint of the Stomach Meridian",
        "Acupoint of the stomach meridian of foot-yangming",
        "Acupuncture point of the stomach meridian",
        "Acupuncture point of the stomach meridian of foot-yangming",
        "ST Acupoint" ;
    tara-ap:isLocatedOnMeridian TARA:6221269 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( TARA:5151019 [ a owl:Restriction ;
                        owl:onProperty tara-op:isLocatedOnMeridian ;
                        owl:someValuesFrom TARA:6221269 ] ) ] .

TARA:5361067 a owl:Class ;
    rdfs:label "Triple Energizer Meridian Acupoint" ;
    dcterms:bibliographicCitation "WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. https://iris.who.int/handle/10665/353407" ;
    dcterms:description "An acupuncture point that is located along the Triple Energizer Meridian of Hand-Shaoyang (TE), which consists of 23 standardized acupoints beginning at TE 1 (Guanchong) on the ulnar side of the ring finger near the corner of the nail, traveling up the dorsal-middle aspect of the arm, ascending over the shoulder and the side of the neck, and circling around the ear, and ending at TE 23 (Sizhukong) in the depression at the lateral end of the eyebrow." ;
    tara-ap:hasSynonym "Acupoint of Triple Energizer Meridian",
        "Acupoint of the Triple Energizer Meridian",
        "Acupuncture point of triple energizer meridian",
        "Acupuncture point of triple energizer meridian of hand-shaoyang",
        "SJ Acupoint",
        "TB Acupoint",
        "TE Acupoint",
        "TW Acupoint" ;
    tara-ap:isLocatedOnMeridian TARA:3898257 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( TARA:5151019 [ a owl:Restriction ;
                        owl:onProperty tara-op:isLocatedOnMeridian ;
                        owl:someValuesFrom TARA:3898257 ] ) ] .

TARA:5629511 a owl:Class ;
    rdfs:label "Spleen Meridian Acupoint" ;
    dcterms:bibliographicCitation "WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. https://iris.who.int/handle/10665/353407" ;
    dcterms:description "An acupuncture point that is located along the Spleen Meridian of Foot-Taiyin (SP), which consists of 21 standardized acupoints beginning at SP 1 (Yinbai) on the medial side of the great toe near the corner of the nail, traveling up along the medial aspect of the leg and continuing up the abdomen and chest, and ending at SP 21 (Dabao) on the lateral thorax in the sixth intercostal space on the midaxillary line." ;
    tara-ap:hasSynonym "Acupoint of Spleen Meridian",
        "Acupoint of the Spleen Meridian",
        "Acupoint of the spleen meridian of foot-taiyin",
        "Acupuncture point of the spleen meridian",
        "Acupuncture point of the spleen meridian of foot-taiyin",
        "SP Acupoint" ;
    tara-ap:isLocatedOnMeridian TARA:4167850 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( TARA:5151019 [ a owl:Restriction ;
                        owl:onProperty tara-op:isLocatedOnMeridian ;
                        owl:someValuesFrom TARA:4167850 ] ) ] .

TARA:5660399 a owl:Class ;
    rdfs:label "Erjian" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.",
        "[Additional Synonyms] Acupuncture: A Comprehensive Text. Shanghai College of Traditional Medicine. Translated and edited by J. O'Connor and D. Bensky. Chicago: Eastland Press, 1981. Section II, Ch. 8: Other New and Miscellaneous Points." ;
    tara-ap:hasListedIndications "febrile disease",
        "nebula",
        "pain in the eye",
        "redness of the eye",
        "swelling of the eye" ;
    tara-ap:hasLocationalDescription "Fold the auricle, the point is at the apex of the auricle." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.1-0.2 inch or prick to cause bleeding." ;
    tara-ap:hasSynonym "EX-HN 6",
        "M-HN 10" ;
    rdfs:subClassOf TARA:3535998 .

TARA:5850983 a owl:Class ;
    rdfs:label "Sifeng" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.",
        "[Additional Synonyms] Acupuncture: A Comprehensive Text. Shanghai College of Traditional Medicine. Translated and edited by J. O'Connor and D. Bensky. Chicago: Eastland Press, 1981. Section II, Ch. 8: Other New and Miscellaneous Points." ;
    tara-ap:hasListedIndications "malnutrition and indigestion syndrome in children",
        "whooping cough" ;
    tara-ap:hasLocationalDescription "On the palmar surface, in the midpoint of the transverse creases of the proximal interphalangeal joints of the index, middle, ring and little fingers." ;
    tara-ap:hasMethodDescription "Prick to cause bleeding, or squeeze out a small amount of yellowish viscous fluid locally." ;
    tara-ap:hasSynonym "EX-UE 10",
        "M-UE 9" ;
    rdfs:subClassOf TARA:3535998 .

TARA:6269212 a owl:Class ;
    rdfs:label "Zhongkui" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.",
        "[Additional Synonyms] Acupuncture: A Comprehensive Text. Shanghai College of Traditional Medicine. Translated and edited by J. O'Connor and D. Bensky. Chicago: Eastland Press, 1981. Section II, Ch. 8: Other New and Miscellaneous Points." ;
    tara-ap:hasListedIndications "hiccup",
        "nausea",
        "vomiting" ;
    tara-ap:hasLocationalDescription "On the midpoint of the proximal interphalangeal joint of the middle finger at dorsum aspect." ;
    tara-ap:hasMethodDescription "Moxibustion is applied with three moxa cones." ;
    tara-ap:hasSynonym "EX-UE 4",
        "M-UE 16" ;
    rdfs:subClassOf TARA:3535998 .

TARA:6659923 a owl:Class ;
    rdfs:label "Bafeng" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.",
        "[Additional Synonyms] Acupuncture: A Comprehensive Text. Shanghai College of Traditional Medicine. Translated and edited by J. O'Connor and D. Bensky. Chicago: Eastland Press, 1981. Section II, Ch. 8: Other New and Miscellaneous Points." ;
    tara-ap:hasListedIndications "beriberi",
        "redness of the dorsum of the foot",
        "swelling of the dorsum of the foot",
        "toe pain" ;
    tara-ap:hasLocationalDescription "On the dorsum of foot, in the depressions on the webs between toes, proximal to the margins of the webs, at the junction of the red and white skin, eight points in all." ;
    tara-ap:hasMethodDescription "Puncture obliquely 0.5-0.8 inch. Moxibustion is applicable." ;
    tara-ap:hasSynonym "EX-LE 10",
        "M-LE 8" ;
    rdfs:subClassOf TARA:3535998 .

TARA:6941032 a owl:Class ;
    rdfs:label "Baichongwo" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.",
        "[Additional Synonyms] Acupuncture: A Comprehensive Text. Shanghai College of Traditional Medicine. Translated and edited by J. O'Connor and D. Bensky. Chicago: Eastland Press, 1981. Section II, Ch. 8: Other New and Miscellaneous Points." ;
    tara-ap:hasListedIndications "eczema",
        "gastrointestinal parasitic disease",
        "rubella" ;
    tara-ap:hasLocationalDescription "1 cun above Xuehai (SP 10)." ;
    tara-ap:hasMethodDescription "Pu ncture perpendicularly 1.0-1.2 inches. Moxibustion is applicable." ;
    tara-ap:hasSynonym "M-LE 34" ;
    rdfs:subClassOf TARA:3535998 .

TARA:6946713 a owl:Class ;
    rdfs:label "Yuyao" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.",
        "[Additional Synonyms] Acupuncture: A Comprehensive Text. Shanghai College of Traditional Medicine. Translated and edited by J. O'Connor and D. Bensky. Chicago: Eastland Press, 1981. Section II, Ch. 8: Other New and Miscellaneous Points." ;
    tara-ap:hasListedIndications "cloudiness of the cornea",
        "pain in the eye",
        "pain in the supraorbital region",
        "ptosis",
        "redness of the eye",
        "swelling of the eye",
        "twitching of the eyelids" ;
    tara-ap:hasLocationalDescription "At the midpoint of the eyebrow, directly above the pupil." ;
    tara-ap:hasMethodDescription "Puncture subcutaneously 0.3-0.5 inch." ;
    tara-ap:hasSynonym "EX-HN 4",
        "M-HN 6" ;
    rdfs:subClassOf TARA:3535998 .

TARA:7233436 a owl:Class ;
    rdfs:label "Luozhen" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.",
        "[Additional Synonyms] Acupuncture: A Comprehensive Text. Shanghai College of Traditional Medicine. Translated and edited by J. O'Connor and D. Bensky. Chicago: Eastland Press, 1981. Section II, Ch. 8: Other New and Miscellaneous Points." ;
    tara-ap:hasListedIndications "pain in the arm",
        "pain in the shoulder",
        "sore neck" ;
    tara-ap:hasLocationalDescription "On the dorsum of the hand, between the second and third metacarpal bones, about 0.5 cun posterior to metacarpophalangeal joint." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.5-0.8 inch." ;
    tara-ap:hasSynonym "M-UE 24" ;
    rdfs:subClassOf TARA:3535998 .

TARA:7471145 a owl:Class ;
    rdfs:label "Yuye" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.",
        "[Additional Synonyms] Acupuncture: A Comprehensive Text. Shanghai College of Traditional Medicine. Translated and edited by J. O'Connor and D. Bensky. Chicago: Eastland Press, 1981. Section II, Ch. 8: Other New and Miscellaneous Points." ;
    tara-ap:hasListedIndications "aphasia with stiffness of tongue",
        "swelling of the tongue",
        "vomiting" ;
    tara-ap:hasLocationalDescription "On the veins on both sides of the frenulum of the tongue, Jinjin is on the left, Yuye, on the right." ;
    tara-ap:hasSynonym "EX-HN 13",
        "M-HN 20b" ;
    rdfs:subClassOf TARA:3535998 .

TARA:7532145 a owl:Class ;
    rdfs:label "Lanweixue" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.",
        "[Additional Synonyms] Acupuncture: A Comprehensive Text. Shanghai College of Traditional Medicine. Translated and edited by J. O'Connor and D. Bensky. Chicago: Eastland Press, 1981. Section II, Ch. 8: Other New and Miscellaneous Points." ;
    tara-ap:hasListedIndications "acute appendicitis",
        "chronic appendicitis",
        "indigestion",
        "paralysis in the lower extremities" ;
    tara-ap:hasLocationalDescription "The tender spot about 2 cun below Zusanli (ST 36)." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 1.0-1.2 inches." ;
    tara-ap:hasSynonym "EX-LE 7",
        "M-LE 13" ;
    rdfs:subClassOf TARA:3535998 .

TARA:7584875 a owl:Class ;
    rdfs:label "Yaotongxue" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.",
        "[Additional Synonyms] Acupuncture: A Comprehensive Text. Shanghai College of Traditional Medicine. Translated and edited by J. O'Connor and D. Bensky. Chicago: Eastland Press, 1981. Section II, Ch. 8: Other New and Miscellaneous Points." ;
    tara-ap:hasListedIndications "acute lumbar sprain" ;
    tara-ap:hasLocationalDescription "On the dorsum of the hand, midway between the transverse wrist crease and metacarpophalangeal joint, between the second and third metacarpal bones, and between the fourth and fifth metacarpal bones, four points in all on both hands." ;
    tara-ap:hasMethodDescription "Puncture obliquely 0.5-1.0 inch toward the centre of metacarpus from both sides." ;
    tara-ap:hasSynonym "EX-UE 7" ;
    rdfs:subClassOf TARA:3535998 .

TARA:7596288 a owl:Class ;
    rdfs:label "Yiming" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.",
        "[Additional Synonyms] Acupuncture: A Comprehensive Text. Shanghai College of Traditional Medicine. Translated and edited by J. O'Connor and D. Bensky. Chicago: Eastland Press, 1981. Section II, Ch. 8: Other New and Miscellaneous Points." ;
    tara-ap:hasListedIndications "eye disease",
        "insomnia",
        "tinnitus" ;
    tara-ap:hasLocationalDescription "1 cun posterior to Yifeng (TE 17)." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.5-0.8 inch." ;
    tara-ap:hasSynonym "EX-HN 14",
        "M-HN 13" ;
    rdfs:subClassOf TARA:3535998 .

TARA:7932600 a owl:Class ;
    rdfs:label "Large Intestine Meridian Acupoint" ;
    dcterms:bibliographicCitation "WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. https://iris.who.int/handle/10665/353407" ;
    dcterms:description "An acupuncture point that is located along the Large Intestine Meridian of Hand-Yangming (LI), which consists of 20 standardized acupoints beginning at LI 1 (Shangyang) on the radial side of the index finger near the corner of the nail, traveling up the dorsal-radial aspect of the arm and across the shoulder and side of the neck to the face, and ending at LI 20 (Yingxiang) in the nasolabial sulcus beside the ala of the nose." ;
    tara-ap:hasSynonym "Acupoint of Large Intestine Meridian",
        "Acupoint of the Large Intestine Meridian",
        "Acupoint of the large intestine meridian of hand-yangming",
        "Acupuncture point of the large intestine meridian",
        "Acupuncture point of the large intestine meridian of hand-yangming",
        "LI Acupoint" ;
    tara-ap:isLocatedOnMeridian TARA:4610474 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( TARA:5151019 [ a owl:Restriction ;
                        owl:onProperty tara-op:isLocatedOnMeridian ;
                        owl:someValuesFrom TARA:4610474 ] ) ] .

TARA:8009041 a owl:Class ;
    rdfs:label "Dingchuan" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.",
        "[Additional Synonyms] Acupuncture: A Comprehensive Text. Shanghai College of Traditional Medicine. Translated and edited by J. O'Connor and D. Bensky. Chicago: Eastland Press, 1981. Section II, Ch. 8: Other New and Miscellaneous Points." ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0000974 ;
    tara-ap:hasListedIndications "asthma",
        "cough",
        "neck rigidity",
        "pain in the back",
        "pain in the shoulder",
        "rubella" ;
    tara-ap:hasLocationalDescription "0.5 cun lateral to Dazhui (GV 14)." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.5-0.8 inch. Moxibustion is applicable." ;
    tara-ap:hasSpecificReferenceLocation UBERON:0004616 ;
    tara-ap:hasSynonym "EX-B 1",
        "M-BW 1" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara-op:hasGeneralSurfaceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0000974 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificReferenceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0004616 ] ],
        TARA:3535998 .

TARA:8343475 a owl:Class ;
    rdfs:label "Bitong" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.",
        "[Additional Synonyms] Acupuncture: A Comprehensive Text. Shanghai College of Traditional Medicine. Translated and edited by J. O'Connor and D. Bensky. Chicago: Eastland Press, 1981. Section II, Ch. 8: Other New and Miscellaneous Points." ;
    tara-ap:hasListedIndications "nasal boils",
        "nasal obstruction",
        "rhinitis" ;
    tara-ap:hasLocationalDescription "At the highest point of the nasolabial groove." ;
    tara-ap:hasMethodDescription "Puncture subcutaneously upward 0.3-0.5 inch." ;
    tara-ap:hasSynonym "M-HN 14" ;
    rdfs:subClassOf TARA:3535998 .

TARA:8364824 a owl:Class ;
    rdfs:label "Governor Vessel Acupoint" ;
    dcterms:bibliographicCitation "WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. https://iris.who.int/handle/10665/353407" ;
    dcterms:description "An acupuncture point that is located along the Governor Vessel (GV / Du Mai), one of the eight extraordinary vessels, which consists of 28 standardized acupoints beginning at GV 1 (Changqiang) in the perineal region midway between the tip of the coccyx and the anus, traveling up along the posterior midline of the body over the spine and across the top of the head, and ending at GV 28 (Yinjiao) in the oral cavity at the frenulum of the upper lip." ;
    tara-ap:hasSynonym "Acupoint of Governor Vessel",
        "Acupoint of the Du channel",
        "Acupoint of the Governor Vessel",
        "Acupuncture point of the Du channel",
        "Acupuncture point of the Governor Vessel",
        "Du Acupoint",
        "Du Channel Acupoint",
        "GV Acupoint" ;
    tara-ap:isLocatedOnMeridian TARA:0386099 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( TARA:5151019 [ a owl:Restriction ;
                        owl:onProperty tara-op:isLocatedOnMeridian ;
                        owl:someValuesFrom TARA:0386099 ] ) ] .

TARA:8574156 a owl:Class ;
    rdfs:label "Bizhong" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.",
        "[Additional Synonyms] Acupuncture: A Comprehensive Text. Shanghai College of Traditional Medicine. Translated and edited by J. O'Connor and D. Bensky. Chicago: Eastland Press, 1981. Section II, Ch. 8: Other New and Miscellaneous Points." ;
    tara-ap:hasListedIndications "contracture of the upper extremities",
        "pain of the forearm",
        "paralysis",
        "spasm of the upper extremities" ;
    tara-ap:hasLocationalDescription "On the lateral aspect of the forearm, midway between the transverse wrist crease and elbow crease, between the radius and the ulna." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 1.0-1.2 inches. Moxibustion is applicable." ;
    tara-ap:hasSynonym "M-UE 30" ;
    rdfs:subClassOf TARA:3535998 .

TARA:8759132 a owl:Class ;
    rdfs:label "Medial Xiyan" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.",
        "[Additional Synonyms] Acupuncture: A Comprehensive Text. Shanghai College of Traditional Medicine. Translated and edited by J. O'Connor and D. Bensky. Chicago: Eastland Press, 1981. Section II, Ch. 8: Other New and Miscellaneous Points." ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0001465 ;
    tara-ap:hasListedIndications "knee pain",
        "weakness of the lower extremities" ;
    tara-ap:hasLocationalDescription "A Xiyan point located in the depression, medial to the patellar ligament, locating the point with the knee flexed." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.5- 1.0 inch. Moxibustion is applicable." ;
    tara-ap:hasSpecificReferenceLocation UBERON:0003676 ;
    tara-ap:hasSynonym "EX-LE 4",
        "Neixiyan" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificReferenceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0003676 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasGeneralSurfaceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0001465 ] ],
        TARA:0926802 .

TARA:8819424 a owl:Class ;
    rdfs:label "Zhoujian" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.",
        "[Additional Synonyms] Acupuncture: A Comprehensive Text. Shanghai College of Traditional Medicine. Translated and edited by J. O'Connor and D. Bensky. Chicago: Eastland Press, 1981. Section II, Ch. 8: Other New and Miscellaneous Points." ;
    tara-ap:hasListedIndications "scrofula" ;
    tara-ap:hasLocationalDescription "On the tip of the ulnar olecranon when the elbow is flexed." ;
    tara-ap:hasSynonym "EX-UE 1",
        "M-UE 46" ;
    rdfs:subClassOf TARA:3535998 .

TARA:8866697 a owl:Class ;
    rdfs:label "Kidney Meridian Acupoint" ;
    dcterms:bibliographicCitation "WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. https://iris.who.int/handle/10665/353407" ;
    dcterms:description "An acupuncture point that is located along the Kidney Meridian of Foot-Shaoyin (KI), which consists of 27 standardized acupoints beginning at KI 1 (Yongquan) on the sole of the foot in the depression formed when the toes are flexed, traveling up along the medial aspect of the leg and continuing up the abdomen and chest close to the midline, and ending at KI 27 (Shufu) on the anterior chest in the depression at the inferior border of the clavicle." ;
    tara-ap:hasSynonym "Acupoint of Kidney Meridian",
        "Acupoint of the Kidney Meridian",
        "Acupoint of the kidney meridian of foot-shaoyin",
        "Acupuncture point of the kidney meridian",
        "Acupuncture point of the kidney meridian of foot-shaoyin",
        "KI Acupoint" ;
    tara-ap:isLocatedOnMeridian TARA:4813389 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( TARA:5151019 [ a owl:Restriction ;
                        owl:onProperty tara-op:isLocatedOnMeridian ;
                        owl:someValuesFrom TARA:4813389 ] ) ] .

TARA:9268434 a owl:Class ;
    rdfs:label "Qiuhou" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.",
        "[Additional Synonyms] Acupuncture: A Comprehensive Text. Shanghai College of Traditional Medicine. Translated and edited by J. O'Connor and D. Bensky. Chicago: Eastland Press, 1981. Section II, Ch. 8: Other New and Miscellaneous Points." ;
    tara-ap:hasListedIndications "eye disease" ;
    tara-ap:hasLocationalDescription "At the junction of the lateral 1/4 and the medial 3/4 of the infraorbital margin." ;
    tara-ap:hasMethodDescription "Push the eyeball upward gently, then puncture perpendicularly 0.5-1.2 inches along the orbital margin slowly without movements of lifting, thrusting, twisting and rotating." ;
    tara-ap:hasSynonym "EX-HN 7",
        "M-HN 8" ;
    rdfs:subClassOf TARA:3535998 .

TARA:9492402 a owl:Class ;
    rdfs:label "Jianqian" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.",
        "[Additional Synonyms] Acupuncture: A Comprehensive Text. Shanghai College of Traditional Medicine. Translated and edited by J. O'Connor and D. Bensky. Chicago: Eastland Press, 1981. Section II, Ch. 8: Other New and Miscellaneous Points." ;
    tara-ap:hasListedIndications "pain in the arm",
        "pain in the shoulder",
        "paralysis in the upper extremities" ;
    tara-ap:hasLocationalDescription "Midway between the end of the anterior axillary fold and Jianyu (LI 15)." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.8-1.2 inches. Moxibustion is applicable." ;
    tara-ap:hasSynonym "Jianneiling",
        "M-UE 48" ;
    rdfs:subClassOf TARA:3535998 .

TARA:9534465 a owl:Class ;
    rdfs:label "Taiyang" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.",
        "[Additional Synonyms] Acupuncture: A Comprehensive Text. Shanghai College of Traditional Medicine. Translated and edited by J. O'Connor and D. Bensky. Chicago: Eastland Press, 1981. Section II, Ch. 8: Other New and Miscellaneous Points." ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0001456 ;
    tara-ap:hasListedIndications "deviation of the eye",
        "deviation of the mouth",
        "eye disease",
        "headache" ;
    tara-ap:hasLocationalDescription "In the depression about one finger breadth posterior to the midpoint between the lateral end of the eyebrow and the outer canthus." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.3-0.5 inch, or prick to cause bleeding." ;
    tara-ap:hasSpecificReferenceLocation UBERON:0006726,
        UBERON:0010163 ;
    tara-ap:hasSynonym "EX-HN 5",
        "M-HN 9" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificReferenceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0010163 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasGeneralSurfaceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0001456 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificReferenceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0006726 ] ],
        TARA:3535998 .

TARA:9610280 a owl:Class ;
    rdfs:label "Sishencong" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.",
        "[Additional Synonyms] Acupuncture: A Comprehensive Text. Shanghai College of Traditional Medicine. Translated and edited by J. O'Connor and D. Bensky. Chicago: Eastland Press, 1981. Section II, Ch. 8: Other New and Miscellaneous Points." ;
    tara-ap:hasListedIndications "epilepsy",
        "headache",
        "insomnia",
        "poor memory",
        "vertigo" ;
    tara-ap:hasLocationalDescription "A group of 4 points, at the vertex, 1 cun respectively posterior, anterior and lateral to Baihui (GV 20). (See Fig. 119)" ;
    tara-ap:hasMethodDescription "Puncture subcutaneously 0.5-1.0 inch. Moxibustion is applicable." ;
    tara-ap:hasSynonym "EX-HN 1",
        "M-HN 1" ;
    rdfs:subClassOf TARA:3535998 .

TARA:9907701 a owl:Class ;
    rdfs:label "Shiqizhui" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.",
        "[Additional Synonyms] Acupuncture: A Comprehensive Text. Shanghai College of Traditional Medicine. Translated and edited by J. O'Connor and D. Bensky. Chicago: Eastland Press, 1981. Section II, Ch. 8: Other New and Miscellaneous Points." ;
    tara-ap:hasListedIndications "dysmenorrhea",
        "irregular menstruation",
        "lumbar pain",
        "paralysis in the lower extremities",
        "thigh pain" ;
    tara-ap:hasLocationalDescription "Below the spinous process of the fifth lumbar vertebra." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.8-1.2 inches. Moxibustion is applicable." ;
    tara-ap:hasSynonym "EX-B 8",
        "M-BW 25",
        "Shiqizhuixia" ;
    rdfs:subClassOf TARA:3535998 .

