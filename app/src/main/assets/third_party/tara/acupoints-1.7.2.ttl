    tara-ap:hasChineseLabel "中衝(冲)" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0003623 ;
    tara-ap:hasInnervationInformation "The palmar digital proprial nerve of the median nerve." ;
    tara-ap:hasListedIndications "aphasia with stiffness of the tongue",
        "aphasia with swelling of the tongue",
        "cardiac pain",
        "convulsion",
        "febrile disease",
        "feverish sensation in the palm",
        "heat stroke",
        "loss of consciousness",
        "palpitation" ;
    tara-ap:hasLocationalDescription "On the middle finger, at the centre of the tip of the middle finger. Remarks: Alternative location for PC 9 - On the middle finger, 0.1 F-cun proximal to the radial corner of the middle fingernail, at the intersection of the vertical line of the radial side of the nail and the horizontal line of the base of the fingernail." ;
    tara-ap:hasMethodDescription "Puncture superficially 0.1 inch or prick with a three-edged needle to cause bleeding. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Zhongchong" ;
    tara-ap:hasSpecialPointRole TARA:2954517 ;
    tara-ap:hasSpecificReferenceLocation UBERON:0009565 ;
    tara-ap:hasSynonym "HC 9",
        "P 9",
        "PE 9",
        "Per 9",
        "Pericardium 9" ;
    tara-ap:hasVasculatureInformation "The arterial and venous network formed by the palmar digital proprial artery and vein." ;
    tara-ap:isLocatedOnMeridian TARA:4694897 ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( TARA:5151019 [ a owl:Restriction ;
