TARA:3283628 a owl:Class ;
    rdfs:label "BL 20" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 109. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 8, Acupuncture Points of the Shaoyin and Taiyang Meridians. ISBN 978-7-119-01758-7." ;
    tara-ap:hasChineseLabel "脾兪(俞)" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0008231 ;
    tara-ap:hasInnervationInformation "The medial cutaneous branches of the posterior rami of the eleventh and twelfth thoracic nerves; deeper, their lateral branches." ;
    tara-ap:hasListedIndications "abdominal distension",
        "anorexia",
        "backache",
        "bloody stools",
        "diarrhea",
        "dysentery",
        "edema",
        "epigastric pain",
        "jaundice",
        "profuse menstruation",
        "vomiting" ;
    tara-ap:hasLocationalDescription "In the upper back region, at the same level as the inferior border of the spinous process of the 11th thoracic vertebra (T11), 1.5 B-cun lateral to the posterior median line." ;
    tara-ap:hasMethodDescription "Puncture obliquely 0.5-0.7 inch. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Pishu" ;
    tara-ap:hasSpecialPointRole TARA:0077876 ;
    tara-ap:hasSpecificReferenceLocation UBERON:0004635,
        ILX:0795312 ;
    tara-ap:hasSynonym "B 20",
        "Back-Shu Point of the Spleen",
        "Bladder 20",
        "UB 20",
        "Urinary Bladder 20" ;
    tara-ap:hasVasculatureInformation "The medial branches of the posterior branches of the intercostal artery and vein." ;
    tara-ap:isLocatedOnMeridian TARA:7525476 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificReferenceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0004635 ] ],
