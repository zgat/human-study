    rdfs:label "cranial skeletal system" ;
    IAO:0000115 "Skeletal subdivision of the head including skull (cranium plus mandible), pharyngeal and/or hyoid apparatus." ;
    IAO:0000116 "we use 'cranial skeletal system', so that we can include the skull, which has joints/sutures as parts (recall, we follow FMA in distinguishing between the skeleton and skeletal system - only the latter includes joints)" ;
    IAO:0000232 "that the cranial skeleton includes the pharyngeal arch skeleton. It is thus more inclusive that the cranium itself, and extends beyond the head in tetrapods. The AAO class called 'skull' belongs here, as it includes the whole splanchnocranium" ;
    OboInOwl:hasDbXref "AAO:0000109",
        "AAO:0000971",
        "AAO:0010185",
        "TAO:0000737",
        "VSAO:0000049",
        "XAO:0003075",
        "ZFA:0000737" ;
    OboInOwl:hasNarrowSynonym "cranial skeleton",
        "osteocranium" ;
    OboInOwl:hasRelatedSynonym "cranium" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0011137 ],
        UBERON:0000075 .

UBERON:0010720 a owl:Class ;
    rdfs:label "hindlimb zeugopod skeleton" ;
    IAO:0000115 "Subdivision of skeleton consisting of all skeletal elements in an hindlimb zeugopod region. Typically consists of the tibia and the fibula." ;
    OboInOwl:hasDbXref "AAO:0000216",
        "VSAO:0005014" ;
    OboInOwl:hasExactSynonym "crural skeleton",
        "crus skeleton",
        "hindlimb zygopod skeleton",
        "posterior zeugopodium skeleton",
        "skeleton cruris" ;
    OboInOwl:hasRelatedSynonym "hind epipodium",
        "hindlimb epipodium",
        "mesomere 2 of pelvic appendage",
        "posterior zeugopodium" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0003823 ],
        UBERON:0011584 .

UBERON:0010740 a owl:Class ;
    rdfs:label "bone of appendage girdle complex" ;
    IAO:0000115 "A bone that is part of an appendage girdle complex (i.e. any bone in a limb, fin or girdle)." ;
    OboInOwl:hasDbXref "EMAPA:35494",
        "MA:0000688" ;
    OboInOwl:hasRelatedSynonym "bone of extended limb/fin region",
        "limb bone" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0002091 ],
        [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0010707 ],
        UBERON:0001474 .

UBERON:0010759 a owl:Class ;
    rdfs:label "equine distal sesamoid" ;
    IAO:0000115 "Lies on the palmar aspect of the coffin joint between the second phalanx and third phalanx. articulates closely with the distal phalanx, to which it is connected by the impar ligament of the navicular bone. The impar ligament is very strong and permits relatively little motion between the navicular bone and the distal phalanx." ;
    OboInOwl:hasDbXref "SCTID:370654009",
        "Wikipedia:Navicular_bone#Horse_anatomy" ;
    OboInOwl:hasRelatedSynonym "distal sesamoid bone",
        "navicular bone" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0002470 ],
        UBERON:0001479,
        UBERON:0011141,
        UBERON:0011250 .

UBERON:0011187 a owl:Class ;
    rdfs:label "ventral tubercle of humerus" ;
    IAO:0000115 "The greater tubercle of the humerus is situated lateral to the head of the humerus and posteriolateral to the lesser tubercle. Its upper surface is rounded and marked by three flat impressions. the highest of these gives ('superior facet') insertion to the Supraspinatus the middle ('middle facet') to the Infraspinatus. the lowest one ('inferior facet'), and the body of the bone for about 2.5 cm. below it, to the Teres minor. The lateral surface of the greater tubercle is convex, rough, and continuous with the lateral surface of the body. Between the greater tubercle and the lesser tubercle is the intertubercular sulcus (bicipital groove)." ;
    OboInOwl:hasDbXref "FMA:23390",
        "NCIT:C32700",
        "SCTID:181934009",
        "UMLS:C1512275",
        "Wikipedia:Greater_tubercle" ;
    OboInOwl:hasExactSynonym "greater tubercle",
        "greater tubercle of humerus",
        "greater tuberosity of humerus",
        "tuberculum majus",
        "tuberculum majus humeri" ;
    OboInOwl:hasRelatedSynonym "greater tubercle of the humerus",
        "greater tuberosity" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0004411 ],
        UBERON:0005813,
        UBERON:4100000 ;
    foaf:depiction "http://upload.wikimedia.org/wikipedia/commons/3/3b/Gray326.png"^^xsd:anyURI .

UBERON:0011582 a owl:Class ;
    rdfs:label "paired limb/fin skeleton" ;
    IAO:0000115 "The collection of all skeletal elements in an individual limb or fin." ;
    OboInOwl:hasDbXref "VSAO:0000301" ;
    OboInOwl:hasExactSynonym "limb/fin skeleton",
        "skeletal parts of limb/fin",
        "skeleton of limb/fin" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0002091 ],
        [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0004708 ],
        UBERON:0004120,
        UBERON:0010912 .

UBERON:0012139 a owl:Class ;
    rdfs:label "segment of autopod" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0002470 ],
        UBERON:0002529 .

UBERON:0012151 a owl:Class ;
    rdfs:label "skeleton of manual digitopodium" ;
    IAO:0000115 "A subdivision of the manus skeleton consisting of both manual acropodial skeleton and metacarpal skeleton, but excluding the carpal skeleton." ;
    OboInOwl:hasRelatedSynonym "manual digitopodium" ;
    rdfs:seeAlso "https://github.com/obophenotype/uberon/wiki/Subdivisions-of-the-autopod"^^xsd:anyURI ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0001442 ],
        [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0002398 ],
        [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0012141 ],
        UBERON:0012150 .

UBERON:0012152 a owl:Class ;
    rdfs:label "skeleton of pedal digitopodium" ;
    IAO:0000115 "A subdivision of the pes skeleton consisting of both pedal acropodial skeleton and metatarsal skeleton, but excluding the tarsal skeleton." ;
    OboInOwl:hasRelatedSynonym "pedal digitopodium" ;
    rdfs:seeAlso "https://github.com/obophenotype/uberon/wiki/Subdivisions-of-the-autopod"^^xsd:anyURI ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0001445 ],
        [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0002387 ],
        [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0012142 ],
        UBERON:0012150 .

UBERON:0012322 a owl:Class ;
    rdfs:label "ascending cervical artery" ;
    IAO:0000115 "The ascending cervical artery is a small branch which arises from the inferior thyroid artery as that vessel is passing behind the carotid sheath; it runs up on the anterior tubercles of the transverse processes of the cervical vertebrC& in the interval between the Scalenus anterior and Longus capitis. To the muscles of the neck it gives twigs which anastomose with branches of the vertebral, and it sends one or two spinal branches into the vertebral canal through the intervertebral foramina to be distributed to the medulla spinalis and its membranes, and to the bodies of the vertebrC&, in the same manner as the spinal branches from the vertebral. It anastomoses with the ascending pharyngeal and occipital arteries." ;
    OboInOwl:hasDbXref "FMA:52489",
        "SCTID:161846001",
        "Wikipedia:Ascending_cervical_artery" ;
    OboInOwl:hasRelatedSynonym "ascending cervical" ;
    rdfs:subClassOf UBERON:0012320 .

UBERON:0012357 a owl:Class ;
    rdfs:label "digitopodium bone" ;
    IAO:0000115 "A bone that is part of a the digitopodium skeleton - i.e. the acropodial skeleton or the metapodial skeleton." ;
    OboInOwl:hasRelatedSynonym "digit bone" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0012140 ],
        [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0012150 ],
        UBERON:0011250 .

UBERON:0013646 a owl:Class ;
    rdfs:label "buccal nerve" ;
    IAO:0000115 "The buccal nerve (also called the long buccal nerve) is a nerve in the face. It is a branch of the mandibular nerve (which is itself a branch of the trigeminal nerve) and transmits sensory information from skin over the buccal membrane (in general, the cheek) and from the second and third molar teeth." ;
    OboInOwl:hasDbXref "BAMS:bucn",
        "FMA:53066",
        "SCTID:280253000",
        "Wikipedia:Buccal_nerve" ;
    OboInOwl:hasExactSynonym "buccinator nerve",
        "long buccal nerve" ;
    OboInOwl:hasRelatedSynonym "buccinator branch",
        "long buccal nerve" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0000375 ],
        UBERON:0011779 .

UBERON:0014848 a owl:Class ;
    rdfs:label "tendon of quadriceps femoris" ;
    OboInOwl:hasDbXref "FMA:46900",
        "SCTID:245175008" ;
    OboInOwl:hasExactSynonym "common tendon of quadriceps femoris",
        "quadriceps femoris tendon",
        "quadriceps tendon" ;
    OboInOwl:hasRelatedSynonym "common quadriceps femoris tendon",
        "common quadriceps tendon",
        "common tendon of quadriceps femoris muscle complex" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0001377 ],
        UBERON:0000043,
        UBERON:0003589 .

UBERON:0015050 a owl:Class ;
    rdfs:label "tarsus endochondral element" ;
    IAO:0000115 "A tarsus bone or its cartilage or pre-cartilage precursor." ;
    OboInOwl:hasBroadSynonym "tarsus skeletal element" ;
    OboInOwl:hasExactSynonym "tarsus element" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0004454 ],
