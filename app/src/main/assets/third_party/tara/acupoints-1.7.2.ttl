UBERON:0013630 a owl:Class ;
    rdfs:label "short bone" ;
    IAO:0000115 "Short bones are designated as those bones that are as wide as they are long. Their primary function is to provide support and stability with little to no movement. They are one of five types of bones: long, short, flat, irregular and sesamoid. Examples of these bones include the tarsals in the foot and the carpals in the hand." ;
    IAO:0000116 "TODO - make subclass links" ;
    OboInOwl:hasDbXref "FMA:7475",
        "NCIT:C33545",
        "SCTID:332807009",
        "Wikipedia:Short_bone" ;
    rdfs:subClassOf UBERON:0001474 .

