UBERON:0006137 a owl:Class ;
    rdfs:label "proper palmar digital artery" ;
    IAO:0000115 "The proper palmar digital arteries travel along the sides of the phalanges (along the contiguous sides of the index, middle, ring, and little fingers), each artery lying just below its corresponding digital nerve. Alternative names for these arteries are: proper volar digital arteries, collateral digital arteries, arteriae digitales palmares propriae, or aa. digitales volares propriae. They anastomose freely in the subcutaneous tissue of the finger tips and by smaller branches near the interphalangeal joints. Each also gives off a couple of dorsal branches which anastomose with the dorsal digital arteries, and supply the soft parts on the back of the second and third phalanges, including the matrix of the fingernail. The proper palmar digital artery for the medial side of the little finger arises directly from the ulnar artery deep to the palmaris brevis muscle, but the rest arise from the common palmar digital arteries." ;
    OboInOwl:hasDbXref "EMAPA:37218",
        "FMA:70804",
        "MA:0001959",
        "SCTID:91778006",
        "Wikipedia:Proper_palmar_digital_arteries" ;
    OboInOwl:hasExactSynonym "arteriae digitales palmares propriae",
        "proper palmal digital arteries",
        "proper palmar digital arteries",
        "proper palmar digital arteries set" ;
    OboInOwl:hasRelatedSynonym "arteriae digitales palmares propriae",
        "proper volar digital arteries",
        "proper volar digital artery",
        "set of proper palmar digital arteries" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty RO:0002170 ;
            owl:someValuesFrom UBERON:0001410 ],
        UBERON:0006141 ;
    foaf:depiction "http://upload.wikimedia.org/wikipedia/commons/a/a9/Gray1237.svg"^^xsd:anyURI .

UBERON:0007153 a owl:Class ;
    rdfs:label "superior epigastric artery" ;
    IAO:0000115 "An artery that arises from the internal thoracic arteryand anastomoses with the inferior epigastric artery at the umbilicus and supplies the anterior part of the abdominal wall and some of the diaphragm." ;
    OboInOwl:hasBroadSynonym "superior epigastric",
        "superior epigastric branch" ;
    OboInOwl:hasDbXref "EMAPA:18752",
