    rdfs:label "Influential Point of Qi" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 6, An Introduction to Acupunture Points, Sec. III, Specific Points. ISBN 978-7-119-01758-7." ;
    dcterms:description "One of the eight influential points, the Influential Point of Qi can be employed to treat disorders of the Zang organs. Tanzhong (CV 17) is the Influential Point of Qi." ;
    tara-ap:hasSpecialPointRole TARA:0521663 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( TARA:7010544 [ a owl:Restriction ;
                        owl:onProperty tara-op:hasSpecialPointRole ;
                        owl:someValuesFrom TARA:0521663 ] ) ] .

TARA:9657915 a owl:Class ;
    rdfs:label "Lower He-Sea Point of the Bladder" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 6, An Introduction to Acupunture Points, Sec. III, Specific Points. ISBN 978-7-119-01758-7." ;
    dcterms:description "The Lower He-Sea Point of the the Bladder meridian. One of the five Shu Points, the He-Sea point signifies the confluence of rivers in the sea, where the meridian qi is the most flourishing. In addition, each of the six fu organs has another He-Sea point in the three yang meridians of the foot, known as the Lower He-Sea point. The Lower He-Sea points are mostly employed to treat the disorders of the six fu organs in clinic." ;
    tara-ap:hasSpecialPointRole TARA:4568236 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( TARA:4830205 [ a owl:Restriction ;
                        owl:onProperty tara-op:hasSpecialPointRole ;
                        owl:someValuesFrom TARA:4568236 ] ) ] .

TARA:9719785 a owl:Class ;
    rdfs:label "Influential Point of Bone" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 6, An Introduction to Acupunture Points, Sec. III, Specific Points. ISBN 978-7-119-01758-7." ;
    dcterms:description "One of the eight influential points, the Influential Point of Bone can be employed to treat disorders of the bones. Dazhu (BL 11) is the Influential Point of bone." ;
    tara-ap:hasSpecialPointRole TARA:3049719 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( TARA:7010544 [ a owl:Restriction ;
                        owl:onProperty tara-op:hasSpecialPointRole ;
                        owl:someValuesFrom TARA:3049719 ] ) ] .

TARA:9763906 a owl:Class ;
    rdfs:label "Influential Point of Blood" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 6, An Introduction to Acupunture Points, Sec. III, Specific Points. ISBN 978-7-119-01758-7." ;
    dcterms:description "One of the eight influential points, the Influential Point of Blood can be employed to treat disorders of blood. Geshu (BL 17) is the Influential Point of blood." ;
    tara-ap:hasSpecialPointRole TARA:3965890 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( TARA:7010544 [ a owl:Restriction ;
                        owl:onProperty tara-op:hasSpecialPointRole ;
                        owl:someValuesFrom TARA:3965890 ] ) ] .

TARA:9924428 a owl:Class ;
    rdfs:label "Influential Point of the Marrow" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 6, An Introduction to Acupunture Points, Sec. III, Specific Points. ISBN 978-7-119-01758-7." ;
    dcterms:description "One of the eight influential points, the Influential Point of Marrow can be employed to treat disorders of the marrow. Xuanzhong (GB 39) is the Influential Point of marrow." ;
    tara-ap:hasSpecialPointRole TARA:5049050 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( TARA:7010544 [ a owl:Restriction ;
                        owl:onProperty tara-op:hasSpecialPointRole ;
                        owl:someValuesFrom TARA:5049050 ] ) ] .

tara-ap:hasAssociatedOrgan a owl:AnnotationProperty ;
    rdfs:label "Associated Organ"@en ;
    IAO:0000112 "'Lung Meridian' tara-ap:hasAssociatedOrgan 'Lung'."@en ;
    dcterms:description """An annotation property that records the organ a Meridian is associated with according to traditional Chinese medicine theory, as a simple IRI annotation.
- Corresponds to the object property tara-op:hasAssociatedOrgan, which is used for logical axioms."""@en ;
    dcterms:references tara-op:hasAssociatedOrgan ;
    rdfs:domain TARA:7226516 ;
    rdfs:range UBERON:0001062 ;
    rdfs:subPropertyOf tara-ap:hasMeridianAnnotationProperty .

tara-ap:hasSpecialPointRole a owl:AnnotationProperty ;
    rdfs:label "Special Point Role"@en ;
    IAO:0000112 "'LU 1' tara-ap:hasSpecialPointRole 'Front-Mu Point of the Lung'."@en ;
    dcterms:description "An annotation property that records the special point role(s) IRI designated to an acupoint as a textual annotation. Corresponds to the object property tara-op:hasSpecialPointRole, which is used for the logical classification of Special Points."@en ;
    dcterms:references tara-op:hasSpecialPointRole ;
    rdfs:domain TARA:1132428 ;
    rdfs:range TARA:4176111 ;
    rdfs:subPropertyOf tara-ap:hasAcupointAnnotationProperty .

tara-ap:isLocatedOnMeridian a owl:AnnotationProperty ;
    rdfs:label "Acupoint of Meridian"@en ;
    IAO:0000112 "'LU 1' tara-ap:isLocatedOnMeridian 'Lung Meridian'."@en ;
    dcterms:description "An annotation property that records the Meridian along which an Acupoint is located, as a simple textual/IRI annotation. Corresponds to the object property tara-op:isLocatedOnMeridian, which is used for logical axioms."@en ;
    dcterms:references tara-op:isLocatedOnMeridian ;
    rdfs:domain TARA:1132428 ;
    rdfs:range TARA:7226516 ;
    rdfs:subPropertyOf tara-ap:hasAcupointAnnotationProperty .

tara-ap:isMeridianLocationOf a owl:AnnotationProperty ;
    rdfs:label "Meridian of Acupoint"@en ;
    IAO:0000112 "'Lung Meridian' tara-ap:isMeridianLocationOf 'LU 1'"@en ;
    dcterms:description """An annotation property that relates a Meridian to an Acupoint that is located along its linear trajectory, as a simple IRI annotation.
- Corresponds to the object property tara-op:isMeridianLocationOf, which is used for logical axioms."""@en ;
    dcterms:references tara-op:isMeridianLocationOf ;
    rdfs:domain TARA:7226516 ;
    rdfs:range TARA:5151019 ;
    rdfs:subPropertyOf tara-ap:hasMeridianAnnotationProperty .

tara-op:iaoObjectProperty a owl:ObjectProperty ;
    rdfs:label "iao:topObjectProperty" ;
    dcterms:description "A grouping object property to group all the IAO object properties specific to TARA ontology." .

ILX:0792339 a owl:Class ;
    rdfs:label "Third posterior intercostal artery" ;
    ilxtr:hasExistingId FMA:12286,
        ILX:0792339 ;
    rdfs:subClassOf UBERON:0039835 .

ILX:0794900 a owl:Class ;
    rdfs:label "supraclavicular nerve" ;
    IAO:0000115 "Cutaneous nerve of the neck originating from nerve point of the neck and providing sensory innervation to skin over the clavicle, shoulder and chest. REVA annotation term." ;
    ilxtr:hasExistingId ILX:0794900 ;
    rdfs:subClassOf UBERON:0001021 .

ILX:0795007 a owl:Class ;
    rdfs:label "superior lateral cutaneous nerve of arm" ;
    IAO:0000115 "The superior lateral cutaneous nerve of arm (or superior lateral brachial cutaneous nerve) is the continuation of the posterior branch of the axillary nerve, after it pierces the deep fascia. It is derived from the ventral rami of C5 and C6." ;
    isPartOf: UBERON:0001493 ;
    ilxtr:hasExistingId ILX:0795007 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0001493 ],
        ILX:0797544 .

ILX:0795021 a owl:Class ;
    rdfs:label "Inferior lateral cutaneous nerve of arm" ;
    IAO:0000115 "The inferior lateral cutaneous nerve of arm is a nerve found in humans and other animals. It is also called the inferior lateral brachial cutaneous nerve. It is a branch of the radial nerve that provides sensory and vasomotor innervation to the lower, lateral aspect of the arm.  It is derived from the ventral rami of C5 and C6." ;
    isPartOf: UBERON:0001492 ;
    ilxtr:hasExistingId ILX:0795021 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0001492 ],
        ILX:0797544 .

ILX:0795288 a owl:Class ;
    rdfs:label "dorsal wrist" ;
    IAO:0000115 "The posterior aspect of the wrist, containing the extensor tendons and underlying carpal bones." ;
    isPartOf: UBERON:0008785 ;
    ILX:0777130 "https://www.uptodate.com/contents/anatomy-and-basic-biomechanics-of-the-wrist" ;
    ilxtr:hasExistingId FMA:24924,
        ILX:0795288 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0008785 ],
        UBERON:0001062 .

ILX:0795310 a owl:Class ;
    rdfs:label "cubital fossa" ;
    IAO:0000115 "A triangular depression on the anterior aspect of the elbow, containing important neurovascular structures." ;
    isPartOf: UBERON:0001460 ;
    ILX:0777130 "https://en.wikipedia.org/wiki/Cubital_fossa" ;
    ilxtr:hasExistingId FMA:39848,
        ILX:0795310 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0001460 ],
        UBERON:0004704 .

ILX:0795318 a owl:Class ;
    rdfs:label "fourth metacarpal bone" ;
    IAO:0000115 "The long bone in the hand that connects the fourth finger to the carpal bones of the wrist. The fourth metacarpal bone is shorter and smaller than the third. The base is small and quadrilateral." ;
    isPartOf: UBERON:0001442 ;
    ILX:0777130 "https://www.imaios.com/en/e-anatomy/anatomical-structure/metacarpal-iv-121123560" ;
    ilxtr:hasExistingId ILX:0795318 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0001442 ],
        UBERON:0001474 .

rdfs:comment a owl:AnnotationProperty .

skos:hiddenLabel a owl:AnnotationProperty ;
    rdfs:label "hidden label" ;
    rdfs:subPropertyOf tara-ap:skosAnntotationProperty,
        rdfs:label ;
    skos:definition "The property skos:hiddenLabel is used to assign a hidden lexical label to a resource. A hidden lexical label is a string of characters that a Knowledge Organization System (KOS) designer would like to be accessible to applications performing text-based indexing and search operations, but would not like to be visible to users on visual displays." .

BFO:0000006 a owl:Class ;
    rdfs:label "spatial region" ;
    IAO:0000115 "(Elucidation) a spatial region is a continuant entity that is a continuant_part_of spaceR as defined relative to some frame R. (axiom label in BFO2 Reference: [035-001])" ;
    IAO:0000116 "Spatial region doesn't have a closure axiom because the subclasses don't exhaust all possibilites. An example would be the union of a spatial point and a spatial line that doesn't overlap the point, or two spatial lines that intersect at a single point. In both cases the resultant spatial region is neither 0-dimensional, 1-dimensional, 2-dimensional, or 3-dimensional." ;
    IAO:0000119 "BFO 2020 (ISO/IEC 21838-2:2021)." ;
    IAO:0000412 obo:bfo.owl ;
    rdfs:subClassOf BFO:0000141 ;
    owl:disjointWith BFO:0000140 .

BFO:0000017 a owl:Class ;
    rdfs:label "realizable entity" ;
    IAO:0000112 "The role of being a doctor; the function of your reproductive organs; the disposition of your blood to coagulate; the disposition of a piece of metal to conduct electricity." ;
    IAO:0000115 "A specifically dependent continuant  that inheres in continuant  entities and are not exhibited in full at every time in which it inheres in an entity or group of entities. The exhibition or actualization of a realizable entity is a particular manifestation, functioning or process that occurs under certain circumstances."@en ;
    IAO:0000116 "Distinguished from quality (the other main subtype of specifically dependent continuant) by the fact that a realizable entity need not be manifested/realized at every time it exists (e.g. a role can exist unrealized), whereas a quality is fully manifested whenever it is borne at all." ;
    IAO:0000119 "BFO 2020 (ISO/IEC 21838-2:2021)." ;
    IAO:0000412 obo:bfo.owl ;
    rdfs:subClassOf BFO:0000020 ;
    owl:disjointWith BFO:0000019 .

BFO:0000066 a owl:ObjectProperty ;
    rdfs:label "occurs in"@en ;
    IAO:0000111 "occurs in"@en ;
    IAO:0000115 "b occurs_in c =def b is a process and c is a material entity or immaterial entity& there exists a spatiotemporal region r and b occupies_spatiotemporal_region r.& forall(t) if b exists_at t then c exists_at t & there exist spatial regions s and s’ where & b spatially_projects_onto s at t& c is occupies_spatial_region s’ at t& s is a proper_continuant_part_of s’ at t"@en ;
    IAO:0000118 "occurs_in"@en,
        "unfolds in"@en,
        "unfolds_in"@en ;
    rdfs:comment "Paraphrase of definition: a relation between a process and an independent continuant, in which the process takes place entirely within the independent continuant" ;
    rdfs:domain BFO:0000003 ;
    rdfs:isDefinedBy obo:bfo.owl ;
    rdfs:range BFO:0000004 ;
    rdfs:subPropertyOf tara-op:bfoObjectProperty ;
    owl:inverseOf BFO:0000067 ;
    owl:propertyChainAxiom ( partOf: BFO:0000066 ),
        ( BFO:0000066 partOf: ) .

IAO:0000030 a owl:Class ;
    rdfs:label "information content entity" ;
    IAO:0000112 "Examples of information content entites include journal articles, data, graphical layouts, and graphs."@en ;
    IAO:0000115 "A generically dependent continuant that is about some thing."@en ;
    IAO:0000116 "2014-03-10: The use of \"thing\" is intended to be general enough to include universals and configurations (see https://groups.google.com/d/msg/information-ontology/GBxvYZCk1oc/-L6B5fSBBTQJ)."@en,
        "information_content_entity 'is_encoded_in' some digital_entity in obi before split (040907). information_content_entity 'is_encoded_in' some physical_document in obi before split (040907). Previous. An information content entity is a non-realizable information entity that 'is encoded in' some digital or physical entity."@en ;
    IAO:0000119 "OBI_0000142"@en ;
    IAO:0000412 "http://purl.obolibrary.org/obo/iao.owl" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty IAO:0000136 ;
            owl:someValuesFrom BFO:0000001 ],
        BFO:0000031 .

IAO:0000125 a owl:NamedIndividual ;
    rdfs:label "pending final vetting"@en ;
    IAO:0000115 "All definitions, placement in the asserted IS_A hierarchy and required minimal metadata are complete. The class is awaiting a final review by someone other than the term editor."@en .

IAO:0000310 a owl:Class ;
    rdfs:label "document" ;
    IAO:0000112 "A journal article, patent application, laboratory notebook, or a book."@en ;
    IAO:0000115 "A collection of information content entities intended to be understood together as a whole."@en ;
    IAO:0000412 "http://purl.obolibrary.org/obo/iao.owl"@en ;
    rdfs:subClassOf IAO:0000030 .

IAO:0000311 a owl:Class ;
    rdfs:label "publication" ;
    IAO:0000112 "journal article, newspaper story, book, etc."@en ;
    IAO:0000115 "A document that is the output of a publishing process."@en ;
    IAO:0000412 "http://purl.obolibrary.org/obo/iao.owl"@en ;
    rdfs:comment "Revisit the term in Octorber 2020. Improve the defintion."@en ;
    rdfs:subClassOf IAO:0000310 .

RO:0000085 a owl:ObjectProperty ;
    rdfs:label "has function"@en ;
    IAO:0000112 "this enzyme has function this catalysis function (more colloquially: this enzyme has this catalysis function)"@en ;
    IAO:0000115 "a relation between an independent continuant (the bearer) and a function, in which the function specifically depends on the bearer for its existence"@en ;
    IAO:0000116 "A bearer can have many functions, and its functions can exist for different periods of time, but none of its functions can exist when the bearer does not exist. A function need not be realized at all the times that the function exists."@en ;
    IAO:0000118 "has_function"@en ;
    rdfs:domain BFO:0000004 ;
    rdfs:range BFO:0000034 ;
    rdfs:subPropertyOf RO:0000053 .

RO:0000086 a owl:ObjectProperty ;
    rdfs:label "has quality"@en ;
    IAO:0000112 "this apple has quality this red color"@en ;
    IAO:0000115 "a relation between an independent continuant (the bearer) and a quality, in which the quality specifically depends on the bearer for its existence"@en ;
    IAO:0000116 "A bearer can have many qualities, and its qualities can exist for different periods of time, but none of its qualities can exist when the bearer does not exist."@en ;
    IAO:0000118 "has_quality"@en ;
    rdfs:range BFO:0000019 ;
    rdfs:subPropertyOf RO:0000053 .

UBERON:0000015 a owl:Class ;
    rdfs:label "non-material anatomical boundary" ;
    IAO:0000115 "A non-material anatomical entity of two dimensions. Anatomical boundaries are contiguous structures." ;
    ilxtr:hasExistingId UBERON:0000015,
        FMA:50705,
        ILX:0727149 ;
    OboInOwl:hasDbXref "AEO:0000192",
        "CARO:0000010",
        "FMA:50705" ;
    OboInOwl:hasExactSynonym "anatomical boundary" ;
    rdfs:comment "Except in the case of abstracted fiat boundaries such as the midline plane of an organism, all 2D anatomical entities have a 3 dimensional projection. For example, the surface of the shell of a muscle has a distinct shape that projects into the third dimension. Note that boundaries are 2D structures. They have no thickness - and so can not be sites of gene expression or gene product localisation. For this, use boundary region terms." ;
    rdfs:subClassOf UBERON:0000466 .

UBERON:0000045 a owl:Class ;
    rdfs:label "ganglion" ;
    IAO:0000115 "A biological tissue mass, most commonly a mass of nerve cell bodies." ;
    IAO:0000116 "TODO - check vert vs invert. Other species: Any of a number of aggregations of neurons, glial cells and their processes, surrounded by a glial cell and connective tissue sheath (plural: ganglia). // Subdivision of neural tree (organ) which primarily consists of cell bodies of neurons located outside the neuraxis (brain and spinal cord); together with a nucleus and its associated nerve, it constitutes a neural tree (organ). Examples: spinal ganglion, trigeminal ganglion, superior cervical ganglion, celiac ganglion, inferior hypogastric (pelvic) ganglion. // a cluster of nerve cells and associated glial cells (nuclear location) // Portion of tissue that contains cell bodies of neurons and is located outside the central nervous system." ;
    dcterms:contributor <https://orcid.org/0000-0002-6601-2165> ;
    OboInOwl:hasDbXref "AAO:0010426",
        "AEO:0000135",
        "BAMS:G",
