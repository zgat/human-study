        "upper end of ulna" ;
    OboInOwl:hasRelatedSynonym "caput ulnae" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0001424 ],
        UBERON:0004380,
        UBERON:0004386 .

