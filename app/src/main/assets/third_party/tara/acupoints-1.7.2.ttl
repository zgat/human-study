    tara-ap:hasSynonym "Conception Vessel 22",
        "RN 22",
        "Ren 22",
        "VC 22" ;
    tara-ap:hasVasculatureInformation "Superficially, the jugular arch and the branch of the inferior thyroid artery; deeper, the trachea; inferiorly, at the posterior aspect of the sternum, the inominate vein at aortic arch." ;
    tara-ap:isLocatedOnMeridian TARA:6789717 ;
