TARA:2003524 a owl:Class ;
    rdfs:label "Influential Point of Tendons" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 6, An Introduction to Acupunture Points, Sec. III, Specific Points. ISBN 978-7-119-01758-7." ;
    dcterms:description "One of the eight influential points, the Influential Point of Tendons can be employed to treat disorders of tendons. Yanglingquan (GB 34) is the Influential Point of tendons." ;
    tara-ap:hasSpecialPointRole TARA:4591653 ;
    owl:equivalentClass [ a owl:Class ;
