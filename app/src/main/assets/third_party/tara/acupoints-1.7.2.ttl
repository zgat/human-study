    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0005473 ],
        UBERON:0001062 .

ILX:0795316 a owl:Class ;
    rdfs:label "fourth posterior sacral foramen" ;
    IAO:0000115 "The fourth opening in the posterior sacrum for sacral nerve passage." ;
    isPartOf: UBERON:0005473 ;
    ILX:0777130 "https://www.elsevier.com/resources/anatomy/nervous-system/peripheral-nervous-system/posterior-root-of-first-sacral-nerve/17108" ;
    ilxtr:hasExistingId FMA:31772,
        ILX:0795316 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0005473 ],
        UBERON:0001062 .

ILX:0795317 a owl:Class ;
    rdfs:label "biceps femoris tendon" ;
    IAO:0000115 "The biceps femoris tendon is the rounded tendon that attaches the muscle bellies of the long and short heads of the biceps femoris muscle to the head of the fibula." ;
    isPartOf: UBERON:0008784 ;
    ILX:0777130 "https://www.elsevier.com/resources/anatomy/muscular-system/muscles-of-lower-limb/biceps-femoris-tendon/22415" ;
    ilxtr:hasExistingId FMA:45930,
        ILX:0795317 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0008784 ],
        UBERON:0000043 .

ILX:0795321 a owl:Class ;
    rdfs:label "seventh intercostal space" ;
    IAO:0000115 "The anatomical space between the seventh and eighth ribs, containing intercostal muscles, vessels, and nerves." ;
    isPartOf: UBERON:0001443 ;
    ILX:0777130 "https://en.wikipedia.org/wiki/Intercostal_space" ;
    ilxtr:hasExistingId FMA:321204,
        ILX:0795321 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0001443 ],
        UBERON:0012198 .

ILX:0795322 a owl:Class ;
    rdfs:label "midclavicular line" ;
    IAO:0000115 "Midclavicular line is an important vertical reference line on the anterior chest wall. It connects the midclavicular point (superiorly) with the middle of the inguinal ligament (inferiorly)." ;
    isPartOf: UBERON:0001443 ;
    ILX:0777130 "https://www.imaios.com/en/e-anatomy/anatomical-structure/midclavicular-line-15368877400" ;
    ilxtr:hasExistingId FMA:20251,
        ILX:0795322 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0001443 ],
        UBERON:0006800 .

ILX:0795324 a owl:Class ;
    rdfs:label "iliotibial band" ;
    IAO:0000115 "Your iliotibial band is a strong, thick band of tissue that runs down the outside of your thigh. It extends all the way from the hip bone to the top of the shinbone." ;
    isPartOf: UBERON:0008784 ;
    ILX:0777130 "https://en.wikipedia.org/wiki/Iliotibial_tract" ;
    ilxtr:hasExistingId FMA:51048,
        ILX:0795324 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0008784 ],
        UBERON:0001062 .

ILX:0795326 a owl:Class ;
    rdfs:label "posterior hairline" ;
    IAO:0000115 "The demarcation at the posterior margin of the scalp where hair growth begins, near the nape of the neck." ;
    isPartOf: UBERON:0000033 ;
    ILX:0777130 "https://www.ncbi.nlm.nih.gov/medgen/868215" ;
    ilxtr:hasExistingId FMA:285422,
        ILX:0795326 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0000033 ],
        UBERON:0006800 .

ILX:0795504 a owl:Class ;
    rdfs:label "tendon of extensor digitorum longus" ;
    IAO:0000115 "The tendon of the muscle that extends the lateral four toes and dorsiflexes the foot." ;
    ilxtr:hasExistingId FMA:47080,
        ILX:0795504 ;
    OboInOwl:abbrev "http://purl.org/sig/ont/fma/fma47080" ;
    rdfs:subClassOf UBERON:0000043 .

ILX:0797475 a owl:Class ;
    rdfs:label "Lateral supraclavicular nerve" ;
    IAO:0000115 "A terminal cutaneous branch of the supraclavicular nerves (C3-C4) that supplies sensation to the skin over the acromion, upper deltoid region, and posterior shoulder." ;
    isPartOf: UBERON:0003725 ;
    ilxtr:hasExistingId FMA:78654,
        ILX:0797475 ;
    OboInOwl:hasExactSynonym "Posterior supraclavicular nerve",
        "Supra-acromial nerve" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0003725 ],
        ILX:0797474 .

ILX:0797476 a owl:Class ;
    rdfs:label "Intermediate supraclavicular nerve" ;
    IAO:0000115 "A cutaneous branch of the cervical plexus that descends across the clavicle to supply the skin over the upper pectoral and deltoid regions." ;
    isPartOf: UBERON:0003725 ;
    ilxtr:hasExistingId FMA:78651,
        ILX:0797476 ;
    OboInOwl:hasExactSynonym "Middle supraclavicular nerve" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0003725 ],
        ILX:0797474 .

ILX:0797480 a owl:Class ;
    rdfs:label "Transverse cervical nerve" ;
    IAO:0000115 "A superficial branch of the cervical plexus (C2-C3) providing sensory innervation to the skin of the anterior neck." ;
    isPartOf: UBERON:0003725 ;
    ilxtr:hasExistingId FMA:6873,
        ILX:0797480 ;
    OboInOwl:hasExactSynonym "Cervical cutaneous nerve",
        "Transverse cutaneous nerve of neck" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0003725 ],
        UBERON:0001027 .

ILX:0797489 a owl:Class ;
    rdfs:label "Proper palmar digital nerve" ;
    IAO:0000115 "A terminal digital nerve supplying sensation to the sides of the fingers and adjacent palmar skin." ;
    isPartOf: UBERON:0003447 ;
    ilxtr:hasExistingId ILX:0797489 ;
    OboInOwl:hasExactSynonym "Proper digital nerve of hand" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0003447 ],
        UBERON:0001027 .

ILX:0797494 a owl:Class ;
    rdfs:label "Radial recurrent artery" ;
    IAO:0000115 "A branch of the radial artery that ascends toward the elbow and participates in the periarticular arterial anastomosis." ;
    isPartOf: UBERON:0001404 ;
    ilxtr:hasExistingId FMA:22748,
        ILX:0797494 ;
    OboInOwl:hasExactSynonym "Arteria recurrens radialis" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0001404 ],
        UBERON:0001637 .

ILX:0797495 a owl:Class ;
    rdfs:label "Radial recurrent vein" ;
    IAO:0000115 "A vein accompanying the radial recurrent artery that drains the lateral elbow region into the radial venous system." ;
    ilxtr:hasExistingId ILX:0797495 ;
    OboInOwl:hasExactSynonym "Vena recurrens radialis" ;
    rdfs:subClassOf UBERON:0001638 .

ILX:0797496 a owl:Class ;
    rdfs:label "Posterior circumflex humeral artery" ;
    IAO:0000115 "A branch of the axillary artery that passes through the quadrangular space to supply the deltoid region and shoulder joint." ;
    isPartOf: UBERON:0001394 ;
    ilxtr:hasExistingId FMA:22684,
        ILX:0797496 ;
    OboInOwl:hasExactSynonym "Arteria circumflexa humeri posterior" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0001394 ],
        UBERON:0001637 .

ILX:0797503 a owl:Class ;
    rdfs:label "Dorsal digital vein of foot" ;
    IAO:0000115 "A superficial vein draining the dorsal aspect of a toe and contributing to the dorsal venous network of the foot." ;
    isPartOf: UBERON:0012356 ;
    ilxtr:hasExistingId FMA:44392,
        ILX:0797503 ;
    OboInOwl:hasExactSynonym "Dorsal digital vein of pes" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0012356 ],
        UBERON:0004562 .

ILX:0797506 a owl:Class ;
    rdfs:label "Superior ulnar collateral artery" ;
    IAO:0000115 "A branch of the brachial artery that accompanies the ulnar nerve posterior to the medial epicondyle and contributes to the arterial anastomosis around the elbow." ;
    isPartOf: UBERON:0001398 ;
    ilxtr:hasExistingId FMA:22706,
        ILX:0797506 ;
    OboInOwl:hasExactSynonym "Arteria collateralis ulnaris superior" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0001398 ],
        UBERON:0001637 .

ILX:0797544 a owl:Class ;
    rdfs:label "Lateral brachial cutaneous nerve" ;
    IAO:0000115 "The lateral brachial cutaneous nerve is a collective anatomical term for two distinct sensory nerves—the superior and inferior lateral brachial cutaneous nerves—that provide somatic sensation to the skin on the lateral (outer) aspect of the upper arm." ;
    ilxtr:hasExistingId ILX:0797544 ;
    rdfs:subClassOf UBERON:0004217 .

skos:note a owl:AnnotationProperty ;
