dc:contributor a owl:AnnotationProperty ;
    rdfs:label "Contributor" ;
    rdfs:subPropertyOf tara-ap:dctermsMetadata .

dc:creator a owl:AnnotationProperty ;
    rdfs:label "Creator" ;
    rdfs:subPropertyOf tara-ap:dctermsMetadata .

dc:date a owl:AnnotationProperty ;
    rdfs:label "Date" ;
    rdfs:subPropertyOf tara-ap:dctermsMetadata .

dc:identifier a owl:AnnotationProperty ;
    rdfs:label "Identifier" ;
    rdfs:subPropertyOf tara-ap:dctermsMetadata .

dc:relation a owl:AnnotationProperty ;
    rdfs:label "Relation" ;
    rdfs:subPropertyOf tara-ap:dctermsMetadata .

dcterms:coverage a owl:AnnotationProperty ;
    rdfs:label "Coverage"@en ;
    rdfs:comment "Spatial topic and spatial applicability may be a named place or a location specified by its geographic coordinates. Temporal topic may be a named period, date, or date range. A jurisdiction may be a named administrative entity or a geographic place to which the resource applies. Recommended best practice is to use a controlled vocabulary such as the Thesaurus of Geographic Names [TGN]. Where appropriate, named places or time periods can be used in preference to numeric identifiers such as sets of coordinates or date ranges."@en ;
    rdfs:range dcterms:LocationPeriodOrJurisdiction ;
    rdfs:subPropertyOf dc:coverage ;
    skos:definition "The spatial or temporal topic of the resource, the spatial applicability of the resource, or the jurisdiction under which the resource is relevant."@en .

dcterms:format a owl:AnnotationProperty ;
    rdfs:label "Format"@en ;
    dcterms:bibliographicCitation "[MIME] http://www.iana.org/assignments/media-types/" ;
    rdfs:comment "Examples of dimensions include size and duration. Recommended best practice is to use a controlled vocabulary such as the list of Internet Media Types [MIME]."@en ;
    rdfs:range dc:contributor ;
    rdfs:seeAlso <http://www.iana.org/assignments/media-types/> ;
    rdfs:subPropertyOf dc:format ;
    skos:definition "The file format, physical medium, or dimensions of the resource."@en .

dcterms:identifier a owl:AnnotationProperty ;
    rdfs:label "Identifier"@en ;
    rdfs:comment "Recommended best practice is to identify the resource by means of a string conforming to a formal identification system."@en ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf dc:identifier ;
    skos:definition "An unambiguous reference to the resource within a given context."@en .

dcterms:rights a owl:AnnotationProperty ;
    rdfs:label "Rights"@en ;
    rdfs:comment "Typically, rights information includes a statement about various property rights associated with the resource, including intellectual property rights."@en ;
    rdfs:range dcterms:RightsStatement ;
    rdfs:subPropertyOf dc:rights ;
    skos:definition "Information about rights held in and over the resource."@en .

TARA:0022762 a owl:Class ;
    rdfs:label "CV 3" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 221. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Acupuncture Points of the Governor and the Conception Vessels and the Extra Points. ISBN 978-7-119-01758-7." ;
    tara-ap:hasChineseLabel "中極(极)" ;
    tara-ap:hasGeneralSurfaceLocation ILX:0795303 ;
    tara-ap:hasInnervationInformation "The branch of the iliohypogastric nerve." ;
    tara-ap:hasListedIndications "dysmenorrhea",
        "enuresis",
        "frequency of urination",
        "hernia",
        "impotence",
        "irregular menstruation",
        "morbid leukorrhea",
        "nocturnal emission",
        "pain in the lower abdomen",
        "prolapse of the uterus",
        "retention of urine",
        "uterine bleeding",
        "vaginitis" ;
    tara-ap:hasLocationalDescription "On the lower abdomen, 4 B-cun inferior to the centre of the umbilicus, on the anterior median line." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.5-1.0 inch. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Zhongji" ;
    tara-ap:hasSpecialPointRole TARA:5308180 ;
    tara-ap:hasSpecificReferenceLocation UBERON:0007118,
        ILX:0795285 ;
    tara-ap:hasSynonym "Conception Vessel 3",
        "Front-Mu Point of the Bladder",
        "RN 3",
        "Ren 3",
        "VC 3" ;
    tara-ap:hasVasculatureInformation "The branches of superficial epigastric artery and vein, and the branches of inferior epigastric artery and vein." ;
    tara-ap:isLocatedOnMeridian TARA:6789717 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificReferenceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0007118 ] ],
        [ a owl:Class ;
            owl:intersectionOf ( TARA:5151019 [ a owl:Restriction ;
                        owl:onProperty tara-op:isLocatedOnMeridian ;
                        owl:someValuesFrom TARA:6789717 ] ) ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasGeneralSurfaceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom ILX:0795303 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificReferenceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom ILX:0795285 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecialPointRole ;
            owl:someValuesFrom TARA:1670028 ] .

TARA:0093665 a owl:Class ;
    rdfs:label "BL 61" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 130. https://iris.who.int/handle/10665/353407",
