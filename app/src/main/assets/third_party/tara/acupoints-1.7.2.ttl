        "Wikipedia:Trapezius_muscle" ;
    OboInOwl:hasExactSynonym "trapezius" ;
    OboInOwl:hasRelatedSynonym "musculus trapezius",
        "spinotrapezius" ;
    rdfs:subClassOf UBERON:0001482,
        UBERON:0010313 ;
    foaf:depiction "http://upload.wikimedia.org/wikipedia/commons/6/60/Trapezius.png"^^xsd:anyURI .

