UBERON:0000483 a owl:Class ;
    rdfs:label "epithelium" ;
    IAO:0000115 "Portion of tissue, that consists of one or more layers of epithelial cells connected to each other by cell junctions and which is underlain by a basal lamina. Examples: simple squamous epithelium, glandular cuboidal epithelium, transitional epithelium, myoepithelium[CARO]." ;
