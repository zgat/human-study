    tara-ap:hasGeneralSurfaceLocation UBERON:0016416 ;
    tara-ap:hasInnervationInformation "The branch of the fifth intercostal nerve." ;
    tara-ap:hasListedIndications "asthma",
        "cough",
        "insufficient lactation",
        "mastitis",
        "pain in the chest" ;
    tara-ap:hasLocationalDescription """In the anterior thoracic region, in the fifth intercostal space, 4 B-cun lateral to the anterior median line.
 - Note: In males, ST 18 is located at the intersection of nipple line and the fifth intercostal space. In females, ST 18 is located at the midpoint of the inferior crease of the breast.""" ;
    tara-ap:hasMethodDescription "Puncture obliquely 0.3-0.5 inch. Moxibustion is applicable." ;
    tara-ap:hasRelatedArtery UBERON:0005612 ;
