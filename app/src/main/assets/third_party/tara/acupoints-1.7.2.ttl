obo:OBI_0000066 a owl:Class ;
    rdfs:label "investigation"@en ;
    IAO:0000112 "Lung cancer investigation using expression profiling, a stem cell transplant investigation, biobanking is not an investigation, though it may be part of an investigation"@en ;
    IAO:0000115 "a planned process that consists of parts: planning, study design execution, documentation and which produce conclusion(s)."@en ;
    IAO:0000118 "study"@en ;
    IAO:0000412 "http://purl.obolibrary.org/obo/obi.owl"@en ;
    rdfs:subClassOf obo:COB_0000035 .

RO:0000079 a owl:ObjectProperty ;
    rdfs:label "function of"@en ;
    IAO:0000112 "this catalysis function is a function of this enzyme"@en ;
    IAO:0000115 "a relation between a function and an independent continuant (the bearer), in which the function specifically depends on the bearer for its existence"@en ;
    IAO:0000116 "A function inheres in its bearer at all times for which the function exists, however the function need not be realized at all the times that the function exists."@en ;
    IAO:0000118 "function_of"@en,
        "is function of"@en ;
    rdfs:comment "This relation is modeled after the BFO relation of the same name which was in BFO2, but is used in a more restricted sense - specifically, we model this relation as functional (inherited from characteristic-of). Note that this relation is now removed from BFO2020." ;
    rdfs:domain BFO:0000034 ;
    rdfs:subPropertyOf RO:0000052 ;
    owl:inverseOf RO:0000085 .

RO:0000080 a owl:ObjectProperty ;
    rdfs:label "quality of"@en ;
    IAO:0000112 "this red color is a quality of this apple"@en ;
    IAO:0000115 "a relation between a quality and an independent continuant (the bearer), in which the quality specifically depends on the bearer for its existence"@en ;
    IAO:0000116 "A quality inheres in its bearer at all times for which the quality exists."@en ;
    IAO:0000118 "is quality of"@en,
        "quality_of"@en ;
    rdfs:comment "This relation is modeled after the BFO relation of the same name which was in BFO2, but is used in a more restricted sense - specifically, we model this relation as functional (inherited from characteristic-of). Note that this relation is now removed from BFO2020." ;
    rdfs:subPropertyOf RO:0000052 ;
    owl:inverseOf RO:0000086 .

RO:0001015 a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "location of"@en ;
    IAO:0000111 "is location of"@en ;
    IAO:0000112 "my head is the location of my brain"@en,
        "this cage is the location of this rat"@en ;
    IAO:0000115 "a relation between two independent continuants, the location and the target, in which the target is entirely within the location"@en ;
    IAO:0000116 "Most location relations will only hold at certain times, but this is difficult to specify in OWL. See http://purl.obolibrary.org/obo/ro/docs/temporal-semantics/"@en ;
    rdfs:subPropertyOf tara-op:roObjectProperty ;
    owl:inverseOf RO:0001025 .

RO:0002350 a owl:ObjectProperty ;
    rdfs:label "member of"@en ;
    IAO:0000112 "An organism that is a member of a population of organisms" ;
    IAO:0000115 "is member of is a mereological relation between a item and a collection." ;
    IAO:0000118 "is member of",
        "member part of" ;
    IAO:0000119 "SIO" ;
    rdfs:subPropertyOf partOf: ;
    owl:inverseOf RO:0002351 .

RO:0002475 a owl:AnnotationProperty ;
    rdfs:label "has no connections with" ;
    IAO:0000112 "'pectoral appendage skeleton' has no connections with 'pelvic appendage skeleton'" ;
    IAO:0000115 "A is has_no_connections_with B if there are no parts of A or B that have a connection with the other." ;
    OboInOwl:hasDbXref "RO:0002475" ;
    OboInOwl:is_class_level true ;
    OboInOwl:is_metadata_tag true ;
    OboInOwl:shorthand "has_no_connections_with" ;
    rdfs:subPropertyOf tara-ap:oboInOwlAnnotationProperty .

