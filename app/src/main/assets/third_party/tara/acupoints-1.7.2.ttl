    tara-ap:hasChineseLabel "天容" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0000974 ;
    tara-ap:hasInnervationInformation "Superficially, the anterior branch of the great auricular nerve, the cervical branch of the facial nerve; deeper, the superior cervical ganglion of the sympathetic trunk." ;
    tara-ap:hasListedIndications "deafness",
        "foreign body sensation in the throat",
        "goiter",
        "sore throat",
        "swelling of the cheek",
        "tinnitus" ;
    tara-ap:hasLocationalDescription """In the anterior region of the neck, posterior to the angle of the mandible, in the depression anterior to the sternocleidomastoid muscle.
 - Note: The sternocleidomastoid muscle is more distinct when the head is turned to the opposite side against resistance.""" ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.5-0.7 inch. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Tianrong" ;
    tara-ap:hasRelatedArtery UBERON:0001532 ;
    tara-ap:hasRelatedNerve UBERON:0001989,
