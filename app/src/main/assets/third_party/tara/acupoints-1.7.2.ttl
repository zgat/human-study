            owl:someValuesFrom UBERON:0008895 ],
        UBERON:0034921 .

UBERON:0010364 a owl:Class ;
    rdfs:label "dermal skeleton" ;
    IAO:0000115 "Skeletal subdivision that undergoes direct development and includes elements that either develop in association with the basement membrane of the ectoderm or are homologous with such elements; includes dermatocranium, components of the appendicular skeleton, teeth and tooth-like elements of the oropharynx, and integumentary elements." ;
    OboInOwl:hasBroadSynonym "exoskeleton" ;
    OboInOwl:hasDbXref "VSAO:0000035",
        "XAO:0004025" ;
    OboInOwl:hasRelatedSynonym "dermal skeletal system",
        "dermoskeleton",
        "desmoskeleton" ;
    rdfs:comment "This ontology covers metazoa, so we do not use exoskeleton as primary label, as in VSAO" ;
    rdfs:subClassOf UBERON:0010912 .

