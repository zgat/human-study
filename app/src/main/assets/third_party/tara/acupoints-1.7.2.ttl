UBERON:0001705 a owl:Class ;
    rdfs:label "nail" ;
    IAO:0000115 "A horn-like keratin structure covering the dorsal aspect of the terminal phalanges of fingers and toes[WP]." ;
    IAO:0000232 "Use this class for both the nails of primates and the homologous claws of mammals such as mouse." ;
