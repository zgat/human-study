    foaf:depiction "http://upload.wikimedia.org/wikipedia/commons/9/9c/Gray1240.png"^^xsd:anyURI .

UBERON:0001423 a owl:Class ;
    rdfs:label "radius bone" ;
    IAO:0000115 "The major preaxial endochondral bone in the anterior zeugopod[Phenoscape]." ;
    OboInOwl:hasDbXref "AAO:0000788",
        "CALOHA:TS-2199",
        "EMAPA:19103",
        "FMA:23463",
        "GAID:185",
