TARA:6220650 a owl:Class ;
    rdfs:label "Front-Mu Point of the Heart" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 6, An Introduction to Acupunture Points, Sec. III, Specific Points. ISBN 978-7-119-01758-7." ;
    dcterms:description "The Front-Mu Point of the Heart meridian. Front-Mu points are those points on the chest and abdomen where the qi of the respective zang-fu organs is infused and converged. Located close to their corresponding zang-fu organs, the Front-Mu points play a significant role in the diagnosis and treatment of the disorders of the internal organs." ;
    tara-ap:hasSpecialPointRole TARA:9515358 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( TARA:8746709 [ a owl:Restriction ;
                        owl:onProperty tara-op:hasSpecialPointRole ;
                        owl:someValuesFrom TARA:9515358 ] ) ] .

TARA:6308255 a owl:Class ;
    rdfs:label "GB 24 (Male)" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 183. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 9, Acupuncture Points of the Jueyin and Shaoyang Meridians. ISBN 978-7-119-01758-7." ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0016416 ;
    tara-ap:hasInnervationInformation "The seventh intercostal nerve." ;
    tara-ap:hasListedIndications "acid regurgitation",
        "hiccup",
        "jaundice",
        "mastitis",
        "pain in the hypochondriac region",
        "vomiting" ;
    tara-ap:hasLocationalDescription """In the anterior thoracic region, in the seventh intercostal space, 4 B-cun lateral to the anterior median line.
 - Note 1: GB 24 is inferior to the centre of the nipple, one rib inferior to LR 14.
 - Note 2: In females, GB 24 can be found at the intersection of the midclavicular line and the seventh intercostal space.""" ;
    tara-ap:hasMethodDescription "Puncture obliquely 0.3-0.5 inch. Moxibustion is applicable." ;
    tara-ap:hasSpecificReferenceLocation UBERON:0002030,
        ILX:0795285,
        ILX:0795321 ;
    tara-ap:hasSynonym "Gallbladder 24 (Male)" ;
    tara-ap:hasVasculatureInformation "The seventh intercostal artery and vein." ;
    tara-ap:isLocatedOnMeridian TARA:5283975 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificReferenceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom ILX:0795285 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificReferenceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0002030 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasGeneralSurfaceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0016416 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificReferenceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom ILX:0795321 ] ],
        TARA:0214009 .

TARA:6484209 a owl:Class ;
    rdfs:label "Back-Shu Point of the Bladder" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 6, An Introduction to Acupunture Points, Sec. III, Specific Points. ISBN 978-7-119-01758-7." ;
    dcterms:description "The Back-Shu Point of the Bladder meridian. Back-Shu points are specific points on the back where the qi of the respective zang-fu organs is infused. Situated close to their respectively related zang-fu organs, the Back-Shu points present abnormal reactions to the dysfunction of their corresponding zang-fu organs. They are often used for disorders of the internal organs." ;
    tara-ap:hasSpecialPointRole TARA:2579465 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( TARA:3861175 [ a owl:Restriction ;
                        owl:onProperty tara-op:hasSpecialPointRole ;
                        owl:someValuesFrom TARA:2579465 ] ) ] .

TARA:6904005 a owl:Class ;
    rdfs:label "Back-Shu Point of the Liver" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 6, An Introduction to Acupunture Points, Sec. III, Specific Points. ISBN 978-7-119-01758-7." ;
    dcterms:description "The Back-Shu Point of the Liver meridian. Back-Shu points are specific points on the back where the qi of the respective zang-fu organs is infused. Situated close to their respectively related zang-fu organs, the Back-Shu points present abnormal reactions to the dysfunction of their corresponding zang-fu organs. They are often used for disorders of the internal organs." ;
    tara-ap:hasSpecialPointRole TARA:3996418 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( TARA:3861175 [ a owl:Restriction ;
                        owl:onProperty tara-op:hasSpecialPointRole ;
                        owl:someValuesFrom TARA:3996418 ] ) ] .

TARA:7083740 a owl:Class ;
    rdfs:label "Influential Point of the Fu Organs" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 6, An Introduction to Acupunture Points, Sec. III, Specific Points. ISBN 978-7-119-01758-7." ;
    dcterms:description "One of the eight influential points, the Influential Point of the Fu Organs can be employed to treat disorders of the Fu organs. Zhongwan (CV 12) is the Influential Point of the Fu organs." ;
    tara-ap:hasSpecialPointRole TARA:5906686 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( TARA:7010544 [ a owl:Restriction ;
                        owl:onProperty tara-op:hasSpecialPointRole ;
                        owl:someValuesFrom TARA:5906686 ] ) ] .

TARA:7406349 a owl:Class ;
    rdfs:label "Lower He-Sea Point of the Small Intestine" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 6, An Introduction to Acupunture Points, Sec. III, Specific Points. ISBN 978-7-119-01758-7." ;
    dcterms:description "The Lower He-Sea Point of the the Small Intestine meridian. One of the five Shu Points, the He-Sea point signifies the confluence of rivers in the sea, where the meridian qi is the most flourishing. In addition, each of the six fu organs has another He-Sea point in the three yang meridians of the foot, known as the Lower He-Sea point. The Lower He-Sea points are mostly employed to treat the disorders of the six fu organs in clinic." ;
    tara-ap:hasSpecialPointRole TARA:7154478 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( TARA:4830205 [ a owl:Restriction ;
                        owl:onProperty tara-op:hasSpecialPointRole ;
                        owl:someValuesFrom TARA:7154478 ] ) ] .

TARA:7524444 a owl:Class ;
    rdfs:label "Xi-Cleft Point of the Yin Heel Vessel" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 6, An Introduction to Acupunture Points, Sec. III, Specific Points. ISBN 978-7-119-01758-7." ;
    dcterms:description "The Xi-Cleft Point of the Yin Heel Vessel (an extra meridian). The Xi-Cleft Point is the site where the qi and blood of the meridian are deeply converged. The Xi-Cleft Point is used to treat acute disorders in the area supplied by its pertaining meridian and those of its pertaining zang or fu organ." ;
    tara-ap:hasSpecialPointRole TARA:9345451 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( TARA:4598552 [ a owl:Restriction ;
                        owl:onProperty tara-op:hasSpecialPointRole ;
                        owl:someValuesFrom TARA:9345451 ] ) ] .

TARA:7546644 a owl:Class ;
    rdfs:label "Influential Point of the Zang Organs" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 6, An Introduction to Acupunture Points, Sec. III, Specific Points. ISBN 978-7-119-01758-7." ;
    dcterms:description "One of the eight influential points, the Influential Point of the Zang Organs can be employed to treat disorders of the Zang organs. Zhangmen (LR 13) is the Influential Point of the Zang organs." ;
    tara-ap:hasSpecialPointRole TARA:1028514 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( TARA:7010544 [ a owl:Restriction ;
                        owl:onProperty tara-op:hasSpecialPointRole ;
                        owl:someValuesFrom TARA:1028514 ] ) ] .

TARA:7793286 a owl:Class ;
    rdfs:label "CV 1 (Male)" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 220. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Acupuncture Points of the Governor and the Conception Vessels and the Extra Points. ISBN 978-7-119-01758-7." ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0002356 ;
    tara-ap:hasInnervationInformation "The branch of the perineal nerve." ;
    tara-ap:hasListedIndications "enuresis",
        "hemorrhoids",
        "irregular menstruation",
        "mental disorder",
        "nocturnal emission",
        "retention of urine",
        "vaginitis" ;
    tara-ap:hasLocationalDescription """In the perineal region, at the midpoint of the line connecting the anus with the posterior border of the scrotum in males and the posterior commissure of labium majoris in females.
 - Note: CV 1 is located midway between the anus and the genital organ, with the subject lying on the side or in knee-chest position.""" ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.5-1.0 inch. Moxibustion is applicable." ;
    tara-ap:hasSpecificReferenceLocation UBERON:0001245,
        UBERON:0001300,
        UBERON:0003133 ;
    tara-ap:hasSynonym "Conception Vessel 1 (Male)" ;
    tara-ap:hasVasculatureInformation "The branches of the perineal artery and vein." ;
    tara-ap:isLocatedOnMeridian TARA:6789717 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificReferenceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0001300 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasGeneralSurfaceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0002356 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificReferenceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0001245 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificReferenceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0003133 ] ],
        TARA:8693603 .

TARA:7805520 a owl:Class ;
    rdfs:label "Back-Shu Point of the Pericardium" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 6, An Introduction to Acupunture Points, Sec. III, Specific Points. ISBN 978-7-119-01758-7." ;
    dcterms:description "The Back-Shu Point of the Pericardium meridian. Back-Shu points are specific points on the back where the qi of the respective zang-fu organs is infused. Situated close to their respectively related zang-fu organs, the Back-Shu points present abnormal reactions to the dysfunction of their corresponding zang-fu organs. They are often used for disorders of the internal organs." ;
