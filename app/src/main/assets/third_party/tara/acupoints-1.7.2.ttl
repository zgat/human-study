TARA:1160697 a owl:Class ;
    rdfs:label "Lower He-Sea Point of the Triple Energizer" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 6, An Introduction to Acupunture Points, Sec. III, Specific Points. ISBN 978-7-119-01758-7." ;
    dcterms:description "The Lower He-Sea Point of the Triple Energizer meridian. One of the five Shu Points, the He-Sea point signifies the confluence of rivers in the sea, where the meridian qi is the most flourishing. In addition, each of the six fu organs has another He-Sea point in the three yang meridians of the foot, known as the Lower He-Sea point. The Lower He-Sea points are mostly employed to treat the disorders of the six fu organs in clinic." ;
    tara-ap:hasSpecialPointRole TARA:4955207 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( TARA:4830205 [ a owl:Restriction ;
                        owl:onProperty tara-op:hasSpecialPointRole ;
                        owl:someValuesFrom TARA:4955207 ] ) ] .

TARA:1317028 a owl:Class ;
    rdfs:label "LR 14 (Male)" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 202. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 9, Acupuncture Points of the Jueyin and Shaoyang Meridians. ISBN 978-7-119-01758-7." ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0016416 ;
    tara-ap:hasInnervationInformation "The sixth intercostal nerve." ;
    tara-ap:hasListedIndications "abdominal distension",
        "acid regurgitation",
        "depression",
        "febrile disease",
        "hiccup",
        "hypochondriac pain",
        "mastitis" ;
    tara-ap:hasLocationalDescription """In the anterior thoracic region, in the sixth intercostal space, 4 B-cun lateral to the anterior median line.
 - Note: LR 14 is inferior to the centre of the nipple, 2 B-cun lateral to ST 19. In females, LR 14 is located at the intersection of the midclavicular line and the sixth intercostal space.""" ;
    tara-ap:hasMethodDescription "Puncture obliquely 0.3-0.5 inch. Moxibustion is applicable." ;
    tara-ap:hasSpecificReferenceLocation UBERON:0002030,
        ILX:0795285,
        ILX:0795307 ;
    tara-ap:hasSynonym "Liver 14 (Male)" ;
    tara-ap:hasVasculatureInformation "The sixth intercostal artery and vein." ;
    tara-ap:isLocatedOnMeridian TARA:5419503 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificReferenceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom ILX:0795307 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasGeneralSurfaceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0016416 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificReferenceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0002030 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificReferenceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom ILX:0795285 ] ],
        TARA:7479763 .

