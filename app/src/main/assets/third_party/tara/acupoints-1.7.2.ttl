            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0009879 ],
        UBERON:0015022,
        UBERON:0015063 .

UBERON:0015061 a owl:Class ;
    rdfs:label "limb endochondral element" ;
    IAO:0000115 "A limb bone or its cartilage or pre-cartilage precursor." ;
    OboInOwl:hasBroadSynonym "limb bone skeletal element" ;
    OboInOwl:hasExactSynonym "limb bone endochondral element" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0002101 ],
        [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0004381 ],
        UBERON:0010363 .

UBERON:0019221 a owl:Class ;
    rdfs:label "digit 1 or 5" ;
    IAO:0000115 "Either of the outermost digits in a five-digit autopod, or their phylogenetic equivalent." ;
    OboInOwl:hasRelatedSynonym "lateral digit",
        "outer digit",
        "outermost digit" ;
    rdfs:seeAlso "https://github.com/obophenotype/uberon/issues/592"^^xsd:anyURI ;
    rdfs:subClassOf UBERON:0002544 .

UBERON:0019243 a owl:Class ;
    rdfs:label "skin crease" ;
    IAO:0000115 "A skin crease (anatomically known as a flexure line or skin furrow) is a permanent, fixed linear depression on the surface of the skin that is directly attached to the underlying deep tissues, fascia, or joints. Source: https://pubmed.ncbi.nlm.nih.gov/27081433/" ;
    ilxtr:hasExistingId UBERON:0019243,
        ILX:0736980 ;
    OboInOwl:hasDbXref "SCTID:280385004",
        "http://www.snomedbrowser.com/Codes/Details/280385004" ;
    OboInOwl:hasRelatedSynonym "skin groove" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0000014 ],
        UBERON:3000961 .

UBERON:0034925 a owl:Class ;
    rdfs:label "anatomical collection" ;
    IAO:0000115 "A collection of anatomical structures that are alike in terms of their morphology or developmental origin." ;
    IAO:0000116 "resolve if this should be a subclass of disconnected anatomical group. Some collections (e.g. the skeleton or skull) are arguably connected" ;
    rdfs:subClassOf UBERON:0000465 .

UBERON:0035652 a owl:Class ;
    rdfs:label "fibular nerve" ;
    IAO:0000115 "Any nerve that innervates the fibularis. Includes the common fibular nerve, and its branches",
        "Any nerve that innervates the fibularis. Includes the common fibular nerve, and its branches." ;
    ilxtr:hasExistingId UBERON:0035652,
        ILX:0734454 ;
    OboInOwl:hasDbXref "EMAPA:36511",
        "MESH:A08.800.800.720.450.760.640",
        "MESH:D010543" ;
    OboInOwl:hasExactSynonym "peroneal nerve" ;
    rdfs:subClassOf UBERON:0001021 .

UBERON:0036014 a owl:Class ;
    rdfs:label "gluteal sulcus" ;
    IAO:0000115 "A horizontal crease formed by the inferior aspect of the buttocks and the posterior upper leg." ;
    OboInOwl:hasDbXref "FMA:20233",
        "SCTID:362679004",
        "Wikipedia:Gluteal_sulcus" ;
    OboInOwl:hasExactSynonym "gluteal fold",
        "sulcus glutealis" ;
    OboInOwl:hasRelatedSynonym "gluteal crease",
        "horizontal gluteal crease" ;
    rdfs:comment "Children with developmental dysplasia of the hips are born with uneven gluteal folds and can be diagnosed with physical examination and sonogram" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0001137 ],
        [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0002355 ],
        UBERON:0007651 .

UBERON:8480009 a owl:Class ;
    rdfs:label "tendon of semitendinosus" ;
    IAO:0000115 "A tendon that attaches to a semitendinosus." ;
    dcterms:contributor <https://orcid.org/0000-0002-0819-0473> ;
    dcterms:date "2022-09-15T07:47:19+00:00"^^xsd:dateTime ;
    OboInOwl:hasExactSynonym "semitendinosus tendon" ;
    rdfs:subClassOf UBERON:0000043 .

TARA:0214009 a owl:Class ;
    rdfs:label "GB 24" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 183. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 9, Acupuncture Points of the Jueyin and Shaoyang Meridians. ISBN 978-7-119-01758-7." ;
    tara-ap:hasChineseLabel "日月" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0016416 ;
    tara-ap:hasInnervationInformation "The seventh intercostal nerve." ;
    tara-ap:hasListedIndications "acid regurgitation",
        "hiccup",
        "jaundice",
        "mastitis",
        "pain in the hypochondriac region",
        "vomiting" ;
    tara-ap:hasLocationalDescription """In the anterior thoracic region, in the seventh intercostal space, 4 B-cun lateral to the anterior median line.
 - Note 1: GB 24 is inferior to the centre of the nipple, one rib inferior to LR 14.
 - Note 2: In females, GB 24 can be found at the intersection of the midclavicular line and the seventh intercostal space.""" ;
    tara-ap:hasMethodDescription "Puncture obliquely 0.3-0.5 inch. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Riyue" ;
    tara-ap:hasSpecialPointRole TARA:4192840 ;
    tara-ap:hasSpecificReferenceLocation UBERON:0002030,
        ILX:0795285,
        ILX:0795321,
        ILX:0795322 ;
    tara-ap:hasSynonym "Front-Mu Point of the Gallbladder",
        "G 24",
        "Gallbladder 24" ;
    tara-ap:hasVasculatureInformation "The seventh intercostal artery and vein." ;
    tara-ap:isLocatedOnMeridian TARA:5283975 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara-op:hasGeneralSurfaceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0016416 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificReferenceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0002030 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificReferenceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom ILX:0795321 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificReferenceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom ILX:0795285 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificReferenceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom ILX:0795322 ] ],
        [ a owl:Class ;
            owl:intersectionOf ( TARA:5151019 [ a owl:Restriction ;
                        owl:onProperty tara-op:isLocatedOnMeridian ;
                        owl:someValuesFrom TARA:5283975 ] ) ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecialPointRole ;
            owl:someValuesFrom TARA:9940480 ] .

TARA:6412285 a owl:Class ;
    rdfs:label "ST 18" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 54. https://iris.who.int/handle/10665/353407",
