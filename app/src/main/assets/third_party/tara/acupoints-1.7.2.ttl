IAO:0000118 a owl:AnnotationProperty ;
    rdfs:label "alternative label"@en ;
    IAO:0000114 IAO:0000125 ;
    IAO:0000115 "An alternative name for a class or property, distinct from the editor preferred term (see IAO:0000111).",
        "A label for a class or property that can be used to refer to the class or property instead of the preferred rdfs:label. Alternative labels should be used to indicate community- or context-specific labels, abbreviations, shorthand forms and the like."@en ;
    IAO:0000119 "GROUP:OBI:<http://purl.obolibrary.org/obo/obi>"@en ;
    rdfs:comment "Consider re-defing to: An alternative name for a class or property which can mean the same thing as the preferred name (semantically equivalent, narrow, broad or related)." ;
    rdfs:subPropertyOf tara-ap:iaoAnnotationProperty .

