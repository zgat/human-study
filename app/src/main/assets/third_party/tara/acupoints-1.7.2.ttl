    tara-ap:hasChineseLabel "(浮)郄" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0001465 ;
    tara-ap:hasInnervationInformation "The posterior femoral cutaneous nerve and the common peroneal nerve." ;
    tara-ap:hasListedIndications "contracture of the tendons in the popliteal fossa",
        "numbness of the femoral region",
        "numbness of the gluteal region" ;
    tara-ap:hasLocationalDescription """On the posterior aspect of the knee, just medial to the biceps femoris tendon, 1 B-cun proximal to the popliteal crease.
 - Note: With the knee in slight flexion, BL 38 is located medial to the biceps femoris tendon, 1 B-cun proximal to BL 39.""" ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.5-1.0 inch. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Fuxi" ;
    tara-ap:hasSpecificReferenceLocation UBERON:0001374,
        ILX:0795317,
        ILX:0795330 ;
    tara-ap:hasSynonym "B 38",
        "Bladder 38",
        "UB 38",
        "Urinary Bladder 38" ;
    tara-ap:hasVasculatureInformation "The superolateral genicular artery and vein." ;
    tara-ap:isLocatedOnMeridian TARA:7525476 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificReferenceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom ILX:0795330 ] ],
