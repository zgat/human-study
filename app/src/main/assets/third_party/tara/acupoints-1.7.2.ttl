        "Wikipedia:External_iliac_vein",
        "galen:ExternalIliacVein" ;
    OboInOwl:hasRelatedSynonym "vena iliaca externa" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty RO:0002170 ;
            owl:someValuesFrom UBERON:0001139 ],
