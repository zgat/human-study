            owl:someValuesFrom UBERON:0001398 ],
        UBERON:0004260 .

ILX:0797512 a owl:Class ;
    rdfs:label "Superior ulnar collateral vein" ;
    IAO:0000115 "A vein accompanying the superior ulnar collateral artery that drains into the brachial venous system." ;
    isPartOf: UBERON:0001413 ;
