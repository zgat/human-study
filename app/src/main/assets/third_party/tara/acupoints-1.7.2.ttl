UBERON:0002088 a owl:Class ;
    rdfs:label "lateral thoracic vein" ;
    IAO:0000115 "The lateral thoracic vein is a tributary of the axillary vein. It runs with the lateral thoracic artery and drains the serratus ventralis muscle and the Pectoralis major muscle. Normally, the thoracoepigastric vein exists between this vein and superficial epigastric vein (a tributary of femoral vein), to act as a shunt for blood if the portal system (through the liver) develops hypertension or a blockage. [WP,unvetted]." ;
    OboInOwl:hasDbXref "EMAPA:37163",
        "FMA:71210",
        "MA:0002162",
        "SCTID:53595001",
        "Wikipedia:Lateral_thoracic_vein" ;
    OboInOwl:hasRelatedSynonym "vena thoracica lateralis" ;
    rdfs:subClassOf UBERON:0005194 ;
    foaf:depiction "http://upload.wikimedia.org/wikipedia/commons/e/e9/Gray576.png"^^xsd:anyURI .

