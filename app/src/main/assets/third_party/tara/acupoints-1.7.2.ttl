UBERON:0004647 a owl:Class ;
    rdfs:label "liver lobule" ;
    IAO:0000115 "The polygonal structure of the liver that consists of hepatocytes radiating outward from a hepatic vein." ;
    IAO:0000232 "should not be confused with the anatomic lobes of the liver (caudate lobe, quadrate lobe, left lobe, and right lobe), or any of the functional lobe classification systems.[WP]" ;
    OboInOwl:hasDbXref "EMAPA:35499",
        "FMA:14471",
        "MA:0002494",
        "NCIT:C32732",
        "SCTID:362194004",
