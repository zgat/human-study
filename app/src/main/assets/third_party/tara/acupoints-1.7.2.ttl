    tara-ap:hasChineseLabel "中髎(髎)" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0005473 ;
    tara-ap:hasInnervationInformation "On the course of the posterior ramus of the third sacral nerve." ;
    tara-ap:hasListedIndications "constipation",
        "diarrhea",
        "dysuria",
        "irregular menstruation",
        "low back pain",
        "morbid leukorrhea" ;
    tara-ap:hasLocationalDescription """In the sacral region, in the third posterior sacral foramen.
 - Note: The third posterior sacral foramen is located in the first depression, moving downward from BL 32.""" ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.8-1.2 inches. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Zhongliao" ;
    tara-ap:hasSpecificReferenceLocation ILX:0795315 ;
    tara-ap:hasSynonym "B 33",
        "Bladder 33",
        "UB 33",
        "Urinary Bladder 33" ;
    tara-ap:hasVasculatureInformation "The posterior branches of the lateral sacral artery and vein." ;
    tara-ap:isLocatedOnMeridian TARA:7525476 ;
    rdfs:subClassOf [ a owl:Restriction ;
