tara-ap:foafAnnotationProperty a owl:AnnotationProperty ;
    rdfs:label "foaf:topAnnotationProperty" ;
    dcterms:description "An annotation property to group all foaf: annotation properties specific to TARA Acupoints Ontology." .

tara-ap:hasRelatedVasculature a owl:AnnotationProperty ;
    rdfs:label "Related Vasculature"@en ;
    IAO:0000112 """This gruping property is never meant to be used for direct annotations. Dierect annotations must be asserted through its specific subproperties.

The acupoint 'LU 1' has the following vasculature information:
- "Superolaterally, the axillary artery and vein, the thoracoacromial artery and vein."

Based on the information above we can use the following subproperties to assert:
- 'LU 1' tara-ap:hasRelatedArtery 'axillary artery'.
- 'LU 1' tara-ap:hasRelatedArtery 'thoraco-acromial artery'.
- 'LU 1' tara-ap:hasRelatedVein 'axillary vein'.
- 'LU 1' tara-ap:hasRelatedVein 'thoracoacromial vein'."""@en ;
    dcterms:description """A grouping annotation property whose subproperties record the IRIs of the blood vessels (such as arteries and veins) in the vicinity of an acupoint's penetrated region (relevant to safe needling).
- Corresponds to the object property tara-op:hasRelatedVasculature, which is used for logical axioms."""@en ;
    dcterms:references tara-op:hasRelatedVasculature ;
    rdfs:domain TARA:1132428 ;
    rdfs:isDefinedBy tara-ap:hasVasculatureInformation ;
    rdfs:range UBERON:0001062 ;
    rdfs:subPropertyOf tara-ap:hasRelatedSubSurfaceAnatomy .

tara-op:bfoObjectProperty a owl:ObjectProperty ;
    rdfs:label "bfo:topObjectProperty" ;
    dcterms:description "A grouping object property to group all the BFO object properties specific to TARA ontology." .

tara-op:hasAcupointObjectProperty a owl:ObjectProperty ;
    IAO:0000112 "This grouping property is never meant to be used for direct assertion of axioms. Direct axioms must be asserted through its specific, leaf-level subproperties." ;
    dcterms:description "An object property grouping all acupoint-specific object properties in TARA Acupoints Ontology. Therefore, the domain for this property is 'Acupuncture Point' which is inherited by all its subproperties." ;
    dcterms:isReferencedBy tara-ap:hasAcupointAnnotationProperty ;
    rdfs:domain TARA:1132428 ;
    rdfs:subPropertyOf tara-op:topTARAObjectProperty .

tara-op:hasRelatedVasculature a owl:ObjectProperty ;
    rdfs:label "hasRelatedVasculature" ;
    IAO:0000112 """This grouping property is never meant to be used for direct assertion of axioms. Direct axioms must be asserted through its specific, leaf-level subproperties.

The acupoint 'LU 1' has the following vasculature information:
- "Superolaterally, the axillary artery and vein, the thoracoacromial artery and vein."

Based on the information above, we can use the following subproperties to assert:
- 'LU 1' tara-ap:hasRelatedArtery some 'axillary artery'.
- 'LU 1' tara-ap:hasRelatedArtery some 'thoraco-acromial artery'.
- 'LU 1' tara-ap:hasRelatedVein some 'axillary vein'.
- 'LU 1' tara-ap:hasRelatedVein some 'thoracoacromial vein'.""" ;
    IAO:0000115 "An acupoint x hasRelatedVasculature a vessel y if and only if x hasRelatedSubSurfaceAnatomy y."@en ;
    IAO:0000116 "Inherits its subproperty-of relation to RO:0002131 (overlaps) from its parent property hasRelatedSubSurfaceAnatomy; rdfs:subPropertyOf is transitive, so no separate RO assertion is required here. - Fahim Imam"@en ;
    dcterms:description "An object property that relates an acupoint to a blood vessel in the vicinity of its penetrated region, relevant to safe needling."@en ;
    dcterms:isReferencedBy tara-ap:hasRelatedVasculature ;
    dcterms:requires tara-ap:hasVasculatureInformation ;
    rdfs:isDefinedBy tara-ap:hasVasculatureInformation ;
    rdfs:subPropertyOf tara-op:hasRelatedSubSurfaceAnatomy .

BFO:0000140 a owl:Class ;
    rdfs:label "continuant fiat boundary" ;
    IAO:0000112 "The North Pole (a fiat point); the Equator (a fiat line); the plane separating the Northern from the Southern hemisphere (a fiat surface)." ;
    IAO:0000115 "b is a continuant fiat boundary = Def. b is an immaterial entity that is of zero, one or two dimensions and does not include a spatial region as part. (axiom label in BFO2 Reference: [029-001])" ;
    IAO:0000119 "BFO 2020 (ISO/IEC 21838-2:2021), axiom [029-001]." ;
    IAO:0000412 obo:bfo.owl ;
    rdfs:subClassOf BFO:0000141 .

BFO:0000141 a owl:Class ;
    rdfs:label "immaterial entity" ;
    IAO:0000112 "A spatial region; a site; a continuant fiat boundary." ;
    IAO:0000115 "b is an immaterial entity =Def. b is an independent continuant which is such that there is no time t when it has a material entity as continuant part." ;
    IAO:0000119 "BFO 2020 (ISO/IEC 21838-2:2021)." ;
    IAO:0000412 obo:bfo.owl ;
    rdfs:subClassOf BFO:0000004 .

