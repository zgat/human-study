UBERON:0001476 a owl:Class ;
    rdfs:label "deltoid" ;
    IAO:0000115 "A muscle of shoulder which attaches to the scapula, clavicle and humerus.[FMA,generalized]." ;
    OboInOwl:hasDbXref "AAO:0010716",
        "EFO:0001412",
        "EHDAA2:0000339",
        "EMAPA:18177",
        "FMA:32521",
