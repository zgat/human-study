ILX:0797509 a owl:Class ;
    rdfs:label "Inferior ulnar collateral artery" ;
    IAO:0000115 "A branch of the brachial artery arising above the elbow that contributes to the arterial anastomosis around the medial aspect of the elbow joint." ;
    isPartOf: UBERON:0001398 ;
    ilxtr:hasExistingId FMA:22710,
        ILX:0797509 ;
    OboInOwl:hasExactSynonym "Arteria collateralis ulnaris inferior" ;
