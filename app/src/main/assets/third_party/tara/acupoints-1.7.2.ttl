    tara-ap:hasChineseLabel "絲(丝)竹空" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0000033 ;
    tara-ap:hasInnervationInformation "The zygomatic branch of the facial nerve and the branch of the auriculotemporal nerve." ;
    tara-ap:hasListedIndications "blurred vision",
        "eyelid twitching",
        "facial paralysis",
        "headache",
        "pain in the eye",
        "redness of the eye",
        "toothache" ;
    tara-ap:hasLocationalDescription """On the head, in the depression at the lateral end of the eyebrow.
