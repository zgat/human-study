    tara-ap:hasSpecificReferenceLocation UBERON:0001128,
        UBERON:0001684 ;
    tara-ap:hasSynonym "Small Intestine 17" ;
    tara-ap:hasVasculatureInformation "Anteriorly, the external jugular vein; deeper, the internal carotid artery and internal jugular vein." ;
    tara-ap:isLocatedOnMeridian TARA:9093316 ;
