tara-op:hasRelatedVein a owl:ObjectProperty ;
    rdfs:label "hasRelatedVein" ;
    IAO:0000112 """The acupoint 'LU 1' has the following vasculature information:
- "Superolaterally, the axillary artery and vein, the thoracoacromial artery and vein."

Based on the information above, we can assert the following axioms:
- 'LU 1' tara-op:hasRelatedVein some 'axillary vein'.
- 'LU 1' tara-op:hasRelatedVein some 'thoracoacromial vein'."""@en ;
    IAO:0000115 "An acupoint x hasRelatedVein y if and only if x hasRelatedVasculature y and y is a vein."@en ;
    IAO:0000116 "Inherits its subproperty-of relation to RO:0002131 (overlaps) from its ancestor properties hasRelatedVasculature and hasRelatedSubSurfaceAnatomy; rdfs:subPropertyOf is transitive, so no separate RO assertion is required here. - Fahim Imam"@en ;
    dcterms:description "An object property that associates an acupoint to a specific related vein occupying its location."@en ;
    dcterms:isReferencedBy tara-ap:hasRelatedVein ;
    dcterms:requires tara-ap:hasVasculatureInformation ;
    rdfs:isDefinedBy tara-ap:hasVasculatureInformation ;
    rdfs:subPropertyOf tara-op:hasRelatedVasculature .

tara-op:hasRelatedArtery a owl:ObjectProperty ;
    rdfs:label "hasRelatedArtery" ;
    IAO:0000112 """The acupoint 'LU 1' has the following vasculature information:
- "Superolaterally, the axillary artery and vein, the thoracoacromial artery and vein."

Based on the information above, we can assert the following axioms:
- 'LU 1' tara-op:hasRelatedArtery some 'axillary artery'.
- 'LU 1' tara-op:hasRelatedArtery some 'thoraco-acromial artery'."""@en ;
    IAO:0000115 "An acupoint x hasRelatedArtery y if and only if x hasRelatedVasculature y and y is an artery."@en ;
    IAO:0000116 "Inherits its subproperty-of relation to RO:0002131 (overlaps) from its ancestor properties hasRelatedVasculature and hasRelatedSubSurfaceAnatomy; rdfs:subPropertyOf is transitive, so no separate RO assertion is required here. - Fahim Imam"@en ;
    dcterms:description "An object property that associates an acupoint to a specific related artery occupying its location."@en ;
    dcterms:isReferencedBy tara-ap:hasRelatedArtery ;
    dcterms:requires tara-ap:hasVasculatureInformation ;
    rdfs:isDefinedBy tara-ap:hasVasculatureInformation ;
    rdfs:subPropertyOf tara-op:hasRelatedVasculature .

ILX:0795285 a owl:Class ;
    rdfs:label "anterior median line" ;
    IAO:0000115 "A vertical line running along the midline of the anterior body surface, aligned with the sternum. On the anterior abdominal and chest walls, the anterior median line can be seen extending from the jugular notch, crossing over the sternum and linea alba in their midline, and reaching out to the midline pubic symphysis." ;
    isPartOf: UBERON:0000916 ;
    ILX:0777130 "https://www.imaios.com/en/e-anatomy/anatomical-structure/anterior-median-line-1536887700" ;
    ilxtr:hasExistingId FMA:20310,
        ILX:0795285 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0000916 ],
        UBERON:0006800 .

tara-op:hasSpecialPointRole a owl:ObjectProperty ;
    rdfs:label "hasSpecialPointRole" ;
    IAO:0000112 "'LU 1'  tara-op:hasSpecialPointRole some 'Front-Mu Point of the Lung Role'."@en ;
    IAO:0000115 "An Acupoint x hasSpecialPointRole a role y if and only if x has_role y, where y is a Special_Acupoint_Role realized in acupuncture practice."@en ;
    IAO:0000116 "Declared as a subproperty of RO:0000087 (has_role) rather than the more generic RO:0000053 (bearer_of), because its range is specifically restricted to instances of Special_Acupoint_Role, a subclass of BFO:0000023 Role; has_role is the RO relation specific to realizable entities of type Role, giving a more precise commitment than the fully general bearer_of. - Fahim Imam"@en ;
    dcterms:description "An object property that relates an acupoint to the special role it bears. It is the inverse of isSpecialPointRoleOf and is the sole property used in this ontology to assert special-point classification for acupoints."@en ;
    dcterms:isReferencedBy tara-ap:hasSpecialPointRole ;
    rdfs:range TARA:4176111 ;
    rdfs:subPropertyOf RO:0000087,
        tara-op:hasAcupointObjectProperty .

tara-op:hasRelatedNerve a owl:ObjectProperty ;
    rdfs:label "hasRelatedNerve" ;
    IAO:0000112 """The acupoint 'LU 1' has the following innervation information: 
- "The intermediate supraclavicular nerve, the branches of the anterior thoracic nerve, and the lateral cutaneous branch of the first intercostal nerve."

Based on the information above, we can assert the following axioms:
- 'LU 1' tara-op:hasRelatedNerve some 'Intermediate Supraclavicular Nerve'.
- 'LU 1' tara-op:hasRelatedNerve some 'medial pectoral nerve'.
- 'LU 1' tara-op:hasRelatedNerve some 'First intercostal nerve'.

Note: The medial pectoral nerve (also known as the medial anterior thoracic nerve) is (typically) a branch of the medial cord of the brachial plexus and is derived from ventral rami  C8-T1."""@en ;
    IAO:0000115 """An acupoint x hasRelatedNerve a nerve y if and only if x hasRelatedSubsurfaceAnatomy y.

An acupoint x hasRelatedNerve a nerve y if and only if x hasRelatedInnervation a neuron population z and z hasAxonLocation y."""@en ;
    IAO:0000116 "Inherits its subproperty-of relation to RO:0002131 (overlaps) from its ancestor properties hasRelatedInnervation and hasRelatedSubSurfaceAnatomy; rdfs:subPropertyOf is transitive, so no separate RO assertion is required here. - Fahim Imam"@en ;
    dcterms:description "An object property that relates an acupoint to a related nerve occupying or passing through the 3D tissue volume penetrated by an acupoint needle."@en ;
    dcterms:isReferencedBy tara-ap:hasRelatedNerve ;
    dcterms:requires tara-ap:hasInnervationInformation ;
    rdfs:isDefinedBy tara-ap:hasInnervationInformation ;
    rdfs:subPropertyOf tara-op:hasRelatedInnervation .

tara-op:isMeridianLocationOf a owl:ObjectProperty ;
    rdfs:label "isMeridianLocationOf"@en ;
    IAO:0000112 "'Lung Meridian' tara-op:isMeridianLocationOf some 'LU 1'."@en ;
    dcterms:description "An object property that relates a meridian to an acupoint that is located along its linear trajectory. It serves as the exact inverse relation of 'isLocatedOnMeridian'."@en ;
    dcterms:isReferencedBy tara-ap:isMeridianLocationOf ;
    rdfs:range TARA:5151019 ;
    rdfs:subPropertyOf tara-kb:hasMeridianObjectProperty .

tara-op:isLocatedOnMeridian a owl:ObjectProperty ;
    rdfs:label "isLocatedOnMeridian" ;
    IAO:0000112 "'LU 1' tara-op:isLocatedOnMeridian some 'Lung Meridian'."@en ;
    IAO:0000115 "An acupoint a isLocatedOnMeridian a Meridian b if and only if a is located_in b, where b is the one-dimensional fiat channel along which a is conventionally situated."@en ;
    dcterms:description "An object property that relates an Acupoint to the Meridian along which it is located."@en ;
    dcterms:isReferencedBy tara-ap:isLocatedOnMeridian ;
    rdfs:comment "Declared as a subproperty of RO:0001025 (located_in) rather than RO:0002350 (member_of), because a Meridian is modeled as a BFO:0000009 (one-dimensional continuant fiat boundary), a channel that acupoints are located along, rather than as an aggregate whose identity is exhausted by the sum of its acupoints; located_in correctly expresses this geometric relationship without implying that the meridian is merely a collection of its acupoints."@en ;
    rdfs:range TARA:7226516 ;
    rdfs:subPropertyOf tara-op:hasAcupointObjectProperty ;
    owl:inverseOf tara-op:isMeridianLocationOf .

TARA:5151019 a owl:Class ;
    rdfs:label "Meridian Acupuncture Point" ;
    IAO:0000115 "An Acupoint that isLocatedOnMeridian one of the twelve principal meridians, the Governor Vessel, or the Conception Vessel." ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 6, An Introduction to Acupunture Points. ISBN 978-7-119-01758-7."@en ;
    dcterms:description "Acupuncture points of the fourteen meridians, also known as \"meridian points,\" acupuncture points of the fourteen meridians are distributed along the twelve main meridian, the Governor Vessel and the Conception Vessel, totally amounting to 361." ;
    tara-ap:hasSynonym "Acupoint of Meridian",
        "Meridian Acupoint",
        "Meridian Point",
        "Meridian Points" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( TARA:1132428 [ a owl:Restriction ;
                        owl:onProperty tara-op:isLocatedOnMeridian ;
                        owl:someValuesFrom TARA:7226516 ] ) ] .

tara-op:hasGeneralSurfaceLocation a owl:ObjectProperty ;
    rdfs:label "hasGeneralSurfaceLocation" ;
    IAO:0000112 """The acupoint 'LU 1' has the following locational description:
- "On the anterior thoracic region, at the same level as the first intercostal space, lateral to the infraclavicular fossa, 6 B-cun lateral to the anterior median line."

Based on the description above, 'LU 1' has three specific reference locations within the general surface of 'Anterior Thoracic Region'. So, we can assert the following axiom for the general location:
- 'LU 1' tara-op:hasGeneralSurfaceLocation some ( 'part of' some 'Anterior Thoracic Region') .

After assering the general location, we can assert the axioms for its specific reference locations using this property's subproperty, hasSpecificReferenceLocation:
- 'LU 1' tara-op:hasSpecificReferenceLocation some ( 'part of' some 'First Intercostal Space').
- 'LU 1' tara-op:hasSpecificReferenceLocation some ( 'part of' some 'Infraclavicular Fossa').
- 'LU 1' tara-op:hasSpecificReferenceLocation some ( 'part of ' some 'Anterior Median Line')."""@en ;
    IAO:0000115 "An Acupoint x hasGeneralSurfaceLocation a region y if and only if x hasRelatedSurfaceAnatomy y, and y is the coarse-grained body region within which x is situated."@en ;
    IAO:0000116 "Inherits its subproperty-of relation to RO:0001025 (located_in) from its parent property hasRelatedSurfaceAnatomy; rdfs:subPropertyOf is transitive, so no separate RO assertion is required here. - Fahim Imam"@en ;
    dcterms:description "An object property that relates an acupoint to the general body region on whose surface it is located. It provides a coarse-grained anatomical grouping for the acupoint and is used together with hasSpecificReferenceLocation, which further specifies particular anatomical landmarks within this general region."@en ;
    dcterms:isReferencedBy tara-ap:hasGeneralSurfaceLocation ;
    dcterms:replaces "tara-op:locatedOnTheSurfaceOf" ;
    dcterms:requires tara-ap:hasLocationalDescription ;
    rdfs:isDefinedBy tara-ap:hasLocationalDescription ;
    rdfs:subPropertyOf tara-op:hasRelatedSurfaceAnatomy .

tara-op:hasSpecificReferenceLocation a owl:ObjectProperty ;
    rdfs:label "hasSpecificReferenceLocation" ;
    IAO:0000112 """The acupoint 'LU 1' has the following locational description:
- "On the anterior thoracic region, at the same level as the first intercostal space, lateral to the infraclavicular fossa, 6 B-cun lateral to the anterior median line."

Based on the description above, 'LU 1' has three specific reference locations within the general surface of 'Anterior Thoracic Region'. So, for the general location, we can assert the following axiom using this property's superproperty, hasGeneralSurfaceLocation:
- 'LU 1' tara-op:hasGeneralSurfaceLocation some ( 'part of' some 'Anterior Thoracic Region'.

After asserting the axiom for the general location, we can use this property to assert the axioms for the specific reference locations:
- 'LU 1' tara-op:hasSpecificReferenceLocation some ( 'part of' some 'First Intercostal Space').
- 'LU 1' tara-op:hasSpecificReferenceLocation some ( 'part of' some 'Infraclavicular Fossa').
- 'LU 1' tara-op:hasSpecificReferenceLocation some ( 'part of ' some 'Anterior Median Line')."""@en ;
    IAO:0000115 "An acupoint x hasSpecificReferenceLocation a landmark y if and only if x hasGeneralSurfaceLocation y, and y is a specific anatomical landmark, fossa, or line used to further localize x within its general surface region."@en ;
    IAO:0000116 "Inherits its subproperty-of relation to RO:0001025 (located_in) from its parent property hasRelatedSurfaceAnatomy; rdfs:subPropertyOf is transitive, so no separate RO assertion is required here. - Fahim Imam"@en ;
    dcterms:description "An object property that relates an acupoint to one or more specific anatomical landmarks within the general body region identified by hasGeneralSurfaceLocation, providing a finer-grained localization of the acupoint."@en ;
    dcterms:isReferencedBy tara-ap:hasSpecificReferenceLocation ;
    dcterms:replaces "tara-op:locatedInRelationTo" ;
    dcterms:requires tara-ap:hasLocationalDescription ;
    rdfs:isDefinedBy tara-ap:hasLocationalDescription ;
    rdfs:subPropertyOf tara-op:hasGeneralSurfaceLocation .

partOf: a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "part of",
        "part of"@en ;
    IAO:0000111 "is part of"@en ;
    IAO:0000112 "Every cell nucleus is part_of some cell.",
        "my brain is part of my body (continuant parthood, two material entities)"@en,
        "my stomach cavity is part of my stomach (continuant parthood, immaterial entity is part of material entity)"@en,
        "this day is part of this year (occurrent parthood)"@en ;
    IAO:0000115 "A primitive, reflexive, transitive relation holding between two continuants (or, in its occurrent-specific form, between two processes), such that b part_of c holds when, at every time t at which b exists, b is a continuant part of c at t.",
        "a core relation that holds between a part and its whole"@en ;
    IAO:0000116 "Simplified/summary rendering: BFO 2020 formally defines part_of via separate temporalized continuant_part_of and occurrent_part_of relations rather than a single non-temporalized elucidation; this entry gives the commonly cited summary form used across OBO ontologies.",
        "Everything is part of itself. Any part of any part of a thing is itself part of that thing. Two distinct things cannot be part of each other."@en,
        "Occurrents are not subject to change and so parthood between occurrents holds for all the times that the part exists. Many continuants are subject to change, so parthood between continuants will only hold at certain times, but this is difficult to specify in OWL. See http://purl.obolibrary.org/obo/ro/docs/temporal-semantics/"@en,
        """Parthood requires the part and the whole to have compatible classes: only an occurrent can be part of an occurrent; only a process can be part of a process; only a continuant can be part of a continuant; only an independent continuant can be part of an independent continuant; only an immaterial entity can be part of an immaterial entity; only a specifically dependent continuant can be part of a specifically dependent continuant; only a generically dependent continuant can be part of a generically dependent continuant. (This list is not exhaustive.)

A continuant cannot be part of an occurrent: use 'participates in'. An occurrent cannot be part of a continuant: use 'has participant'. A material entity cannot be part of an immaterial entity: use 'has location'. A specifically dependent continuant cannot be part of an independent continuant: use 'inheres in'. An independent continuant cannot be part of a specifically dependent continuant: use 'bearer of'."""@en ;
    IAO:0000118 "part_of"@en ;
    IAO:0000119 "BFO 2020 axiom family [002-xxx]; RO core.obo (BFO_0000050 part_of, is_a: RO:0002131 overlaps)." ;
    IAO:0000412 obo:bfo.owl ;
    rdfs:seeAlso "http://www.obofoundry.org/ro/#OBO_REL:part_of" ;
    rdfs:subPropertyOf RO:0002131,
        tara-op:bfoObjectProperty ;
    owl:inverseOf BFO:0000051 .

[] a owl:Axiom ;
    IAO:0000116 "This is redundant with the more specific 'independent and not spatial region' constraint. We leave in the redundant axiom for use with reasoners that do not use negation." ;
    owl:annotatedProperty rdfs:range ;
    owl:annotatedSource RO:0001025 ;
    owl:annotatedTarget BFO:0000004 .

[] a owl:Axiom ;
    IAO:0000116 "This is redundant with the more specific 'independent and not spatial region' constraint. We leave in the redundant axiom for use with reasoners that do not use negation." ;
    owl:annotatedProperty rdfs:domain ;
    owl:annotatedSource RO:0001025 ;
    owl:annotatedTarget BFO:0000004 .

[] a owl:AllDifferent ;
    owl:distinctMembers ( IAO:0000120 IAO:0000121 IAO:0000122 IAO:0000123 IAO:0000124 IAO:0000125 IAO:0000423 IAO:0000428 ) .

[] a swrl:Imp ;
    swrl:body [ a swrl:AtomList ;
            rdf:first [ a swrl:IndividualPropertyAtom ;
                    swrl:argument1 <urn:swrl#e> ;
                    swrl:argument2 <urn:swrl#d> ;
                    swrl:propertyPredicate RO:0000053 ] ;
            rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:ClassAtom ;
                            swrl:argument1 <urn:swrl#d> ;
                            swrl:classPredicate BFO:0000016 ] ;
                    rdf:rest () ] ] ;
    swrl:head [ a swrl:AtomList ;
            rdf:first [ a swrl:IndividualPropertyAtom ;
                    swrl:argument1 <urn:swrl#e> ;
                    swrl:argument2 <urn:swrl#d> ;
                    swrl:propertyPredicate RO:0000091 ] ;
            rdf:rest () ] .

[] a swrl:Imp ;
    swrl:body [ a swrl:AtomList ;
            rdf:first [ a swrl:IndividualPropertyAtom ;
                    swrl:argument1 <urn:swrl#e> ;
                    swrl:argument2 <urn:swrl#d> ;
                    swrl:propertyPredicate RO:0000053 ] ;
            rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:ClassAtom ;
                            swrl:argument1 <urn:swrl#d> ;
                            swrl:classPredicate BFO:0000019 ] ;
                    rdf:rest () ] ] ;
    swrl:head [ a swrl:AtomList ;
            rdf:first [ a swrl:IndividualPropertyAtom ;
                    swrl:argument1 <urn:swrl#e> ;
                    swrl:argument2 <urn:swrl#d> ;
                    swrl:propertyPredicate RO:0000086 ] ;
            rdf:rest () ] .

[] a swrl:Imp ;
    swrl:body [ a swrl:AtomList ;
            rdf:first [ a swrl:IndividualPropertyAtom ;
                    swrl:argument1 <urn:swrl#e> ;
                    swrl:argument2 <urn:swrl#d> ;
                    swrl:propertyPredicate RO:0000053 ] ;
            rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:ClassAtom ;
                            swrl:argument1 <urn:swrl#d> ;
                            swrl:classPredicate BFO:0000023 ] ;
                    rdf:rest () ] ] ;
    swrl:head [ a swrl:AtomList ;
            rdf:first [ a swrl:IndividualPropertyAtom ;
                    swrl:argument1 <urn:swrl#e> ;
                    swrl:argument2 <urn:swrl#d> ;
                    swrl:propertyPredicate RO:0000087 ] ;
            rdf:rest () ] .

[] a swrl:Imp ;
    swrl:body [ a swrl:AtomList ;
            rdf:first [ a swrl:IndividualPropertyAtom ;
                    swrl:argument1 <urn:swrl#e> ;
                    swrl:argument2 <urn:swrl#d> ;
                    swrl:propertyPredicate RO:0000053 ] ;
            rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:ClassAtom ;
                            swrl:argument1 <urn:swrl#d> ;
                            swrl:classPredicate BFO:0000034 ] ;
                    rdf:rest () ] ] ;
