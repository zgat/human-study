UBERON:0034964 a owl:Class ;
    rdfs:label "superficial epigastric artery" ;
    IAO:0000115 "An artery that arises from the femoral artery and supplies the abdominal wall. It distributes branches to the superficial subinguinal lymph glands, the superficial fascia, and the integument; it anastomoses with branches of the inferior epigastric, and with its fellow of the opposite side." ;
    OboInOwl:hasDbXref "FMA:20734",
