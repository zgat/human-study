                    owl:onProperty partOf: ;
                    owl:someValuesFrom ILX:0795317 ] ] .

TARA:3361879 a owl:Class ;
    rdfs:label "TE 21" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 168. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 9, Acupuncture Points of the Jueyin and Shaoyang Meridians. ISBN 978-7-119-01758-7." ;
    tara-ap:hasChineseLabel "耳門(门)" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0001456 ;
    tara-ap:hasInnervationInformation "The branches of the auriculotemporal nerve and facial nerve." ;
    tara-ap:hasListedIndications "deafness",
        "otorrhea",
        "stiffness of the lip",
        "tinnitus",
        "toothache" ;
    tara-ap:hasLocationalDescription """On the face, in the depression between the supratragic notch and the condylar process of the mandible.
 - Note: When the mouth is slightly opened, TE 21 is located in the depression anterior to the supratragic notch, directly superior to SI 19.""" ;
    tara-ap:hasPinyinLabel "Ermen" ;
    tara-ap:hasSpecificReferenceLocation UBERON:0004657 ;
    tara-ap:hasSynonym "SJ 21",
        "San Jiao 21",
        "TB 21",
        "TH 21",
        "TW 21",
        "Triple Burner 21",
        "Triple Energizer 21",
        "Triple Heater 21",
        "Triple Warmer 21" ;
    tara-ap:hasVasculatureInformation "The superficial temporal artery and vein." ;
    tara-ap:isLocatedOnMeridian TARA:3898257 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara-op:hasGeneralSurfaceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0001456 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificReferenceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0004657 ] ],
        [ a owl:Class ;
            owl:intersectionOf ( TARA:5151019 [ a owl:Restriction ;
                        owl:onProperty tara-op:isLocatedOnMeridian ;
                        owl:someValuesFrom TARA:3898257 ] ) ] .

TARA:3361967 a owl:Class ;
    rdfs:label "GV 16" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 211. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Acupuncture Points of the Governor and the Conception Vessels and the Extra Points. ISBN 978-7-119-01758-7." ;
    tara-ap:hasChineseLabel "風(风)府" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0000974 ;
    tara-ap:hasInnervationInformation "The branches of the third cervical nerve and the great occipital nerve." ;
    tara-ap:hasListedIndications "blurred vision",
        "epistaxis",
        "headache",
        "hemiplegia",
        "mental disorder",
        "neck rigidity",
        "post-apoplexy aphasia",
        "sore throat" ;
    tara-ap:hasLocationalDescription """In the posterior region of the neck, directly inferior to the external occipital protuberance, in the depression between the trapezius muscles.
 - Note: With the head slightly extended in the seated position, loosen the trapezius muscle, then move superiorly from the midpoint of the posterior hairline to the occipital bone, GV 16 will be found.""" ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.5-0.8 inch. Deep puncture is not advisable. Medullary bulb is in the deep layer, special attention should be paid in acupuncture." ;
    tara-ap:hasPinyinLabel "Fengfu" ;
    tara-ap:hasSpecificReferenceLocation UBERON:0002380,
        UBERON:0013469 ;
    tara-ap:hasSynonym "Du 16",
        "Governor Vessel 16",
        "VG 16" ;
    tara-ap:isLocatedOnMeridian TARA:0386099 ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( TARA:5151019 [ a owl:Restriction ;
                        owl:onProperty tara-op:isLocatedOnMeridian ;
                        owl:someValuesFrom TARA:0386099 ] ) ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificReferenceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0002380 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasGeneralSurfaceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0000974 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificReferenceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0013469 ] ] .

TARA:3369897 a owl:Class ;
    rdfs:label "TE 1" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 158. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 9, Acupuncture Points of the Jueyin and Shaoyang Meridians. ISBN 978-7-119-01758-7." ;
    tara-ap:hasChineseLabel "關(关,関)衝(冲)" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0003624 ;
    tara-ap:hasInnervationInformation "The palmar digital proprial nerve derived from the ulnar nerve." ;
    tara-ap:hasListedIndications "febrile disease",
        "headache",
        "irritability",
        "redness of the eye",
        "sore throat",
        "stiffness of the tongue" ;
    tara-ap:hasLocationalDescription "On the ring finger, ulnar to the distal phalanx, 0.1 f-cun proximal to the ulnar corner of the fingernail, at the intersection of the vertical line of the ulnar side of the nail and the horizontal line of the base of the fingernail." ;
    tara-ap:hasMethodDescription "Puncture superficially 0.1 inch, or prick with a three-edged needle to cause bleeding. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Guanchong" ;
    tara-ap:hasSpecialPointRole TARA:2954517 ;
    tara-ap:hasSpecificReferenceLocation UBERON:0004300,
        UBERON:0011276 ;
    tara-ap:hasSynonym "SJ 1",
        "San Jiao 1",
        "TB 1",
        "TH 1",
        "TW 1",
        "Triple Burner 1",
        "Triple Energizer 1",
        "Triple Heater 1",
        "Triple Warmer 1" ;
    tara-ap:hasVasculatureInformation "The arterial and venous network formed by the palmar digital proprial artery and vein." ;
    tara-ap:isLocatedOnMeridian TARA:3898257 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara-op:hasGeneralSurfaceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0003624 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificReferenceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0011276 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificReferenceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0004300 ] ],
        [ a owl:Class ;
            owl:intersectionOf ( TARA:5151019 [ a owl:Restriction ;
                        owl:onProperty tara-op:isLocatedOnMeridian ;
                        owl:someValuesFrom TARA:3898257 ] ) ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecialPointRole ;
            owl:someValuesFrom TARA:3839815 ] .

TARA:3386254 a owl:Class ;
    rdfs:label "GV 20" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 213. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Acupuncture Points of the Governor and the Conception Vessels and the Extra Points. ISBN 978-7-119-01758-7." ;
    tara-ap:hasChineseLabel "百會(会)" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0000033 ;
    tara-ap:hasInnervationInformation "The branch of the great occipital nerve." ;
    tara-ap:hasListedIndications "aphasia by apoplexy",
        "coma",
        "headache",
        "mental disorder",
        "nasal obstruction",
        "prolapse of the rectum",
        "prolapse of the uterus",
        "tinnitus",
        "vertigo" ;
    tara-ap:hasLocationalDescription """On the head, 5 B-cun superior to the anterior hairline, on the anterior median line.
 - Note 1: GV 20 is located in the depression 1 B-cun anterior to the midpoint of the line from the anterior hairline to the posterior hairline.
 - Note 2: When the ears are folded, GV 20 is located at the midpoint of the connecting line between the auricular apices.""" ;
    tara-ap:hasMethodDescription "Puncture subcutaneously 0.3-0.5 inch. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Baihui" ;
    tara-ap:hasSpecificReferenceLocation ILX:0795285,
        ILX:0795292,
        ILX:0795326 ;
    tara-ap:hasSynonym "Du 20",
        "Governor Vessel 20",
        "VG 20" ;
    tara-ap:hasVasculatureInformation "The anastomotic network formed by the superficial temporal arteries and veins and the occipital arteries and veins on both sides." ;
    tara-ap:isLocatedOnMeridian TARA:0386099 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara-op:hasGeneralSurfaceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0000033 ] ],
        [ a owl:Class ;
            owl:intersectionOf ( TARA:5151019 [ a owl:Restriction ;
                        owl:onProperty tara-op:isLocatedOnMeridian ;
                        owl:someValuesFrom TARA:0386099 ] ) ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificReferenceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom ILX:0795285 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificReferenceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom ILX:0795292 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificReferenceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom ILX:0795326 ] ] .

TARA:3389422 a owl:Class ;
    rdfs:label "SI 17" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 96. https://iris.who.int/handle/10665/353407",
