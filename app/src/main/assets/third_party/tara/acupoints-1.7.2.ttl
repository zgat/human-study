    tara-ap:hasChineseLabel "郄門(门)" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0002386 ;
    tara-ap:hasInnervationInformation "The medial antebrachial cutaneous nerve; deeper, the median nerve; deepest, the anterior interosseous nerve." ;
    tara-ap:hasListedIndications "cardiac pain",
        "chest pain",
        "epilepsy",
        "epistaxis",
        "furuncle",
        "hematemesis",
        "hemoptysis",
        "palpitation" ;
    tara-ap:hasLocationalDescription """On the anterior aspect of the forearm, between the tendons of the palmaris longus and the flexor carpi radialis, 5 B-cun proximal to the palmar wrist crease.
 - Note 1: With the fist clenched, the wrist supinated, and the elbow slightly flexed, the two tendons become more prominent. PC 4 is located 1 B-cun distal to the midpoint of the line connecting PC 3 with PC 7.
 - Note 2: If the palmaris longus tendon is not present, PC 4 is medial to the flexor carpi radialis tendon.""" ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.5-1.0 inch. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Ximen" ;
