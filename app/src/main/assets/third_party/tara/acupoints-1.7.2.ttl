        "UMLS:C0032652",
        "Wikipedia:Popliteal_vein",
        "galen:PoplitealVein" ;
    OboInOwl:hasRelatedSynonym "vena poplitea" ;
    rdfs:subClassOf UBERON:0001638 ;
    foaf:depiction "http://upload.wikimedia.org/wikipedia/commons/6/66/Gray609.png"^^xsd:anyURI .

