        "Wikipedia:Sympathetic_nervous_system",
        "ZFA:0001576" ;
    OboInOwl:hasExactSynonym "pars sympathica divisionis autonomici systematis nervosi",
        "sympathetic nervous system",
        "sympathetic part of autonomic division of nervous system" ;
    OboInOwl:hasRelatedSynonym "pars sympathica divisionis autonomici systematis nervosi" ;
