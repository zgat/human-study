            owl:someValuesFrom UBERON:0009879 ],
        UBERON:0001447,
        UBERON:0002513,
        UBERON:0015099,
        UBERON:0018102 ;
    foaf:depiction "http://upload.wikimedia.org/wikipedia/commons/9/9e/Gray268.png"^^xsd:anyURI .

