UBERON:0004089 a owl:Class ;
    rdfs:label "midface" ;
    IAO:0000115 "The middle of the face including the nose and its associated bony structures[MW]." ;
    IAO:0000116 "this class is currently a union of the snout (e.g. in mouse), the midface and the lower face. Note that in MA, snout includes the whole jaw and should thus be more alike the lower face than the midface, so its placement here is not strictly accurate. In future we might introduce specific classes for each of these, and include the full parthood relationships. if this is done, then care should be taken to preserve inferences such as an abnormality of the lower face being an abnormality of the midface." ;
    OboInOwl:hasDbXref "FMA:285406",
        "MA:0001910" ;
    OboInOwl:hasRelatedSynonym "lower face",
        "midface/lower face",
        "snout" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0001456 ],
        UBERON:0001444 .

