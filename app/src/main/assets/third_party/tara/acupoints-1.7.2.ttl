    OboInOwl:hasExactSynonym "Vena collateralis ulnaris superior" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0001413 ],
        UBERON:0004260 .

ILX:0797513 a owl:Class ;
    rdfs:label "Inferior ulnar collateral vein" ;
