    tara-ap:hasChineseLabel "氣(气,気)舍(舎)" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0000974 ;
    tara-ap:hasInnervationInformation "The medial supraclavicular nerve and the muscular branch of ansa cervicalis." ;
    tara-ap:hasListedIndications "asthma",
        "goiter",
        "hiccup",
        "pain in the neck",
        "rigidity of the neck",
        "sore throat" ;
    tara-ap:hasLocationalDescription """In the anterior region of the neck, in the lesser supraclavicular fossa, superior to the sternal end of the clavicle, in the depression between the sternal and clavicular heads of the sternocleidomastoid muscle.
 - Note 1: The sternocleidomastoid muscle is more distinct when the head is turned to the opposite side against resistance.
 - Note 2: ST 11 is located superior to the clavicle, inferior to ST 9.""" ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.3-0.5 inch. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Qishe" ;
