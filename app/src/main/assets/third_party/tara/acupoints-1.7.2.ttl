        "SCTID:302543008",
        "UMLS:C0019552",
        "VHOG:0000346",
        "Wikipedia:Hip",
        "galen:Hip" ;
    OboInOwl:hasExactSynonym "hip region",
        "regio coxae" ;
    OboInOwl:hasRelatedSynonym "coxa" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0010709 ],
        UBERON:0000475 ;
    foaf:depiction "http://upload.wikimedia.org/wikipedia/commons/9/9f/Hip.jpg"^^xsd:anyURI .

