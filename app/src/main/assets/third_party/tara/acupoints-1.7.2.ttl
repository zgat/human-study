    OboInOwl:hasExactSynonym "arteria dorsalis pedis",
        "dorsal artery of foot" ;
    OboInOwl:hasRelatedSynonym "arteria dorsalis pedis" ;
    rdfs:subClassOf [ a owl:Restriction ;
