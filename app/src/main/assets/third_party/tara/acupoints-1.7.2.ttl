    tara-ap:hasChineseLabel "至陰(阴)" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0003635 ;
    tara-ap:hasInnervationInformation "The plantar digital proprial nerve and the lateral dorsal cutaneous nerve of foot." ;
    tara-ap:hasListedIndications "detention of after birth",
        "difficult labor",
        "epistaxis",
        "feverish sensation in the sole",
        "headache",
        "malposition of fetus",
        "nasal obstruction",
        "ophthalmalgia" ;
    tara-ap:hasLocationalDescription "On the little toe, lateral to the distal phalanx, 0.1 f-cun proximal to the lateral corner of the toenail; at the intersection of the vertical line of the lateral side of the nail and the horizontal line of the base of the toenail." ;
    tara-ap:hasMethodDescription "Puncture superficially 0.1 inch. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Zhiyin" ;
