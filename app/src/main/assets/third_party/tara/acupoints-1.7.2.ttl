TARA:0886544 a owl:Class ;
    rdfs:label "Special Point on the Head and Trunk Role" ;
    rdfs:subClassOf TARA:4176111 .

TARA:1787498 a owl:Class ;
    rdfs:label "Shu Point" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 6, An Introduction to Acupunture Points, Sec. III, Specific Points. ISBN 978-7-119-01758-7." ;
    dcterms:description "Represents one of the five Shu Points. Each of the twelve main meridians has, below the elbow or knee, five specific points, namely, Jing-Well, Ying-Spring, Shu-Stream, Jing-River and He-Sea, which are termed Five Shu points in general. They are situated in the above order from the distal end of extremities to the elbow or knee. It is said in the first chapter of Miraculous Pivot that \"the qi of the twelve main meridians and fifteen collaterals flow all over the body. The flow of qi running in the meridians from the extremities to the elbow or knee is flourishing gradually.\" The names of the five shu points image the flow of meridian qi as the flow of water." ;
    tara-ap:hasSpecialPointRole TARA:1375080 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( TARA:4943316 [ a owl:Restriction ;
                        owl:onProperty tara-op:hasSpecialPointRole ;
                        owl:someValuesFrom TARA:1375080 ] ) ] .

TARA:4943316 a owl:Class ;
    rdfs:label "Special Point on the Limbs" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 6, An Introduction to Acupunture Points, Sec. III, Specific Points. ISBN 978-7-119-01758-7." ;
    dcterms:description "A special, specific acupoint located on the Limbs. Specific points refer to those of the fourteen meridians that have special properties and are grouped under special names. Specific Points on the Limbs include: (1) Five Shu Points, (2) Yuan-Primary Points, (3) Luo-Conneetiog Points, (4) Xi-Cleft Points, and (5) Eight Confluent Points." ;
    tara-ap:hasSpecialPointRole TARA:8173108 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( TARA:7852472 [ a owl:Restriction ;
                        owl:onProperty tara-op:hasSpecialPointRole ;
                        owl:someValuesFrom TARA:8173108 ] ) ] .

tara-ap:hasAcupointInformation a owl:AnnotationProperty ;
    rdfs:label "Acupoint Information"@en ;
    IAO:0000112 "This property is never meant to be used for direct annotations. Dierect annotations must be asserted through its specific subproperties."@en ;
    dcterms:description "An annotation property that groups all textual, descriptive attributes of an acupoint, including its anatomical location, needling method, indications, vasculature, and innervation. Subproperties further specialize the type of description."@en ;
    rdfs:domain TARA:1132428 ;
    rdfs:subPropertyOf tara-ap:hasAcupointAnnotationProperty .

