    tara-ap:hasGeneralSurfaceLocation UBERON:0003823 ;
    tara-ap:hasInnervationInformation "Superficially, the medial crural cutaneous nerve; deeper, in the posterior aspect, the tibial nerve." ;
    tara-ap:hasListedIndications "abdominal distension",
        "abdominal pain",
        "borborygmus",
        "delayed labor",
        "diarrhea",
        "dizziness",
        "dysmenorrhea",
        "dysuria",
        "edema",
        "enuresis",
        "headache",
        "hernia",
        "impotence",
        "infertility",
        "insomnia",
        "irregular menstruation",
        "morbid leukorrhea",
        "motor impairment of the lower extremities",
        "muscular atrophy of the lower extremities",
        "nocturnal emission",
        "pain in the external genitalia",
        "pain in the lower extremities",
        "paralysis in the lower extremities",
        "prolapse of the uterus",
        "uterine bleeding",
        "vertigo" ;
    tara-ap:hasLocationalDescription """On the tibial aspect of the leg, posterior to the medial border of the tibia, 3 B-cun superior to the prominence of the medial malleolus.
 - Note: 1 B-cun superior to KI 8.""" ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.5-1.0 inch. Moxibustion is applicable. Acupuncture on this point is contraindicated in pregnant women." ;
