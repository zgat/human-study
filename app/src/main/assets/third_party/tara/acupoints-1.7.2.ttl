tara-ap:hasCompactURI a owl:AnnotationProperty ;
    rdfs:label "Compact URI"@en ;
    IAO:0000118 "CURIE" ;
    dcterms:description "A CURIE (Compact URI) for an ontology IRI is a shortened, human-readable abbreviation consisting of a prefix and a local identifier separated by a colon. For example, the full IRI http://purl.obolibrary.org/obo/UBERON_0000948 condenses into the CURIE UBERON:0000948."@en ;
    rdfs:subPropertyOf dcterms:identifier .

tara-ap:hasCurationSourceLink a owl:AnnotationProperty ;
    rdfs:label "Curation Source Link"@en ;
    dc:description "An annotation property that links an extracted metadata element, class, or individual to its precise origin in the data curation layer via a direct URL. For Google Sheets, the value must be a fully qualified, clickable URL containing specific worksheet identifier (gid) and target cell or row parameters (range), establishing strict machine-readable provenance down to the exact grid coordinate."@en ;
    rdfs:subPropertyOf dc:source .

tara-ap:hasDOI a owl:AnnotationProperty ;
    rdfs:subPropertyOf dc:identifier .

tara-ap:hasEnglishLabel a owl:AnnotationProperty ;
    rdfs:label "English Label" ;
    rdfs:subPropertyOf IAO:0000118 .

tara-ap:hasFigureSourceLink a owl:AnnotationProperty ;
    rdfs:label "Figure Source Link"@en ;
    dc:description "An annotation property that links a figure from a web resource to enhance the information about an ontological class or entity."@en ;
    rdfs:subPropertyOf dc:source .

tara-ap:hasListedIndications a owl:AnnotationProperty ;
    rdfs:label "Listed Indication(s)"@en ;
    IAO:0000112 "'LU 1' tara-ap:hasListedIndications \"cough, asthma, pain in the chest, shoulder and back; fullness of the chest\""@en ;
    dcterms:description "An annotation property that lists the clinical conditions and symptoms for which an acupoint is indicated according to traditional Chinese medicine."@en ;
    rdfs:domain TARA:1132428 ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf tara-ap:hasAcupointInformation .

tara-ap:hasMethodDescription a owl:AnnotationProperty ;
    rdfs:label "Acupuncture Method"@en ;
    IAO:0000112 "'LU 1' tara-ap:hasMethodDescription \"Puncture obliquely 0.5-0.8 cun towards the lateral aspect of the chest. To avoid injuring the lung, never puncture deeply towards the medial aspect. Moxibustion is applicable.\""@en ;
    dcterms:description "An annotation property that describes the recommended needling method for an acupoint, including needle angle, depth, and applicability of moxibustion."@en ;
    rdfs:domain TARA:1132428 ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf tara-ap:hasAcupointInformation .

tara-ap:hasNextAcupoint a owl:AnnotationProperty ;
    rdfs:label "Next Acupoint"@en ;
    IAO:0000112 "'LU 1' tara:hasNextAcupoint 'LU 2'."@en ;
    dcterms:description "An annotation property to link a meridian acupoint to its next acupoint along the same meridian."@en ;
    rdfs:domain TARA:5151019 ;
    rdfs:range TARA:5151019 ;
    rdfs:subPropertyOf tara-ap:hasAcupointAnnotationProperty .

tara-ap:hasPinyinLabel a owl:AnnotationProperty ;
    rdfs:label "Pinyin Label" ;
    rdfs:subPropertyOf IAO:0000118 .

tara-ap:hasPublicationDate a owl:AnnotationProperty ;
    rdfs:subPropertyOf dc:date .

tara-ap:hasPublicationVenue a owl:AnnotationProperty ;
    rdfs:subPropertyOf dc:relation .

tara-ap:hasSourceSheetColumnLabel a owl:AnnotationProperty ;
    rdfs:label "Source Sheet Column Label"@en ;
    dcterms:description "An annotation property used to link a formal concept, property, or class within an ontology to its exact literal string representation used as a column header in a data extraction spreadsheet or CSV file. As a subproperty of skos:hiddenLabel, it preserves the raw, unformatted, and informal terminology of the source data layer for ingestion and mapping purposes, without polluting the clean, formal vocabulary defined by skos:prefLabel."@en ;
    rdfs:subPropertyOf skos:hiddenLabel .

tara-ap:hasSynonym a owl:AnnotationProperty ;
    rdfs:label "Synonym" ;
    rdfs:subPropertyOf IAO:0000118 .

tara-op:isSpecialPointRoleOf a owl:ObjectProperty ;
    rdfs:subPropertyOf RO:0000081 .

isPartOf: a owl:AnnotationProperty ;
    rdfs:label "isPartOf" ;
    rdfs:subPropertyOf tara-ap:ilxAnnotationProperty .

ILX:0381387 a owl:AnnotationProperty ;
    rdfs:label "hasLaterality" ;
    rdfs:subPropertyOf tara-ap:ilxAnnotationProperty .

ILX:0383241 a owl:AnnotationProperty ;
    rdfs:label "isDeprecated" ;
    rdfs:subPropertyOf tara-ap:ilxAnnotationProperty .

ILX:0770273 rdfs:label "includesTerm" .

ILX:0777130 a owl:AnnotationProperty ;
    rdfs:label "hasDefinitionSource" ;
    rdfs:subPropertyOf tara-ap:ilxAnnotationProperty .

ILX:0778161 a owl:AnnotationProperty ;
    rdfs:label "subClassOf" ;
    rdfs:subPropertyOf tara-ap:ilxAnnotationProperty .

ilxtr:hasExistingId a owl:AnnotationProperty ;
    rdfs:subPropertyOf tara-ap:ilxAnnotationProperty .

OboInOwl:abbrev a owl:AnnotationProperty ;
    rdfs:label "abbreviation" ;
    rdfs:subPropertyOf tara-ap:oboInOwlAnnotationProperty .

OboInOwl:consider a owl:AnnotationProperty ;
    rdfs:subPropertyOf tara-ap:oboInOwlAnnotationProperty .

OboInOwl:created_by a owl:AnnotationProperty ;
    rdfs:label "created by" ;
    rdfs:subPropertyOf tara-ap:oboInOwlAnnotationProperty .

OboInOwl:creation_date a owl:AnnotationProperty ;
    rdfs:label "creation date" ;
    rdfs:subPropertyOf tara-ap:oboInOwlAnnotationProperty .

OboInOwl:hasAlternativeId a owl:AnnotationProperty ;
    rdfs:label "has_alternative_id" ;
    rdfs:subPropertyOf tara-ap:oboInOwlAnnotationProperty .

OboInOwl:hasBroadSynonym a owl:AnnotationProperty ;
    rdfs:label "has_broad_synonym",
        "has broad synonym"@en ;
    IAO:0000115 "An alternative label for a class or property which has a more general meaning than the preferred name/primary label." ;
    rdfs:seeAlso "https://github.com/information-artifact-ontology/ontology-metadata/issues/18" ;
    rdfs:subPropertyOf IAO:0000118 .

OboInOwl:hasDbXref a owl:AnnotationProperty ;
    rdfs:label "database_cross_reference",
        "has cross-reference" ;
    IAO:0000112 "disease characteristic (MONDO:0021125) has cross-reference (http://www.geneontology.org/formats/oboInOwl#hasDbXref) \"NCIT:C41009\"^^xsd:string" ;
    IAO:0000115 "An annotation property that links an ontology entity or a statement to a prefixed identifier or URI." ;
    dcterms:contributor <https://orcid.org/0000-0002-7356-1779> ;
    rdfs:subPropertyOf tara-ap:oboInOwlAnnotationProperty .

OboInOwl:hasExactSynonym a owl:AnnotationProperty ;
    rdfs:label "has_exact_synonym",
        "has exact synonym"@en ;
    IAO:0000115 "An alternative label for a class or property which has the exact same meaning than the preferred name/primary label." ;
    rdfs:seeAlso "https://github.com/information-artifact-ontology/ontology-metadata/issues/20" ;
    rdfs:subPropertyOf IAO:0000118 .

OboInOwl:hasNarrowSynonym a owl:AnnotationProperty ;
    rdfs:label "has_narrow_synonym",
        "has narrow synonym"@en ;
    IAO:0000115 "An alternative label for a class or property which has a more specific meaning than the preferred name/primary label." ;
    rdfs:seeAlso "https://github.com/information-artifact-ontology/ontology-metadata/issues/19" ;
    rdfs:subPropertyOf IAO:0000118 .

OboInOwl:hasRelatedSynonym a owl:AnnotationProperty ;
    rdfs:label "has_related_synonym",
        "has related synonym"@en ;
    IAO:0000115 "An alternative label for a class or property that has been used synonymously with the primary term name, but the usage is not strictly correct." ;
    rdfs:seeAlso "https://github.com/information-artifact-ontology/ontology-metadata/issues/21" ;
    rdfs:subPropertyOf IAO:0000118 .

OboInOwl:is_class_level a owl:AnnotationProperty ;
    rdfs:subPropertyOf tara-ap:oboInOwlAnnotationProperty .

OboInOwl:is_metadata_tag a owl:AnnotationProperty ;
    rdfs:subPropertyOf tara-ap:oboInOwlAnnotationProperty .

OboInOwl:shorthand a owl:AnnotationProperty ;
    rdfs:subPropertyOf tara-ap:oboInOwlAnnotationProperty .

rdfs:isDefinedBy a owl:AnnotationProperty .

rdfs:seeAlso a owl:AnnotationProperty ;
    rdfs:label "see also" ;
    OboInOwl:hasDbXref "http://www.w3.org/2000/01/rdf-schema#seeAlso" ;
    OboInOwl:is_metadata_tag true ;
    OboInOwl:shorthand "seeAlso" .

skos:altLabel a owl:AnnotationProperty ;
    rdfs:label "alternative label" ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:subPropertyOf tara-ap:skosAnntotationProperty,
        rdfs:label ;
    skos:definition "an alternative lexical label for a resource" ;
    skos:example "Acronyms, abbreviations, spelling variants, and irregular plural/singular forms may be included among the alternative labels for a concept. Mis-spelled terms are normally included as hidden labels (see skos:hiddenLabel)." ;
    skos:note "The range of skos:altLabel is the class of RDF plain literals.",
        "skos:prefLabel, skos:altLabel and skos:hiddenLabel are pairwise disjoint properties." .

skos:broadMatch a owl:AnnotationProperty ;
    rdfs:label "broad match" ;
    rdfs:subPropertyOf tara-ap:skosAnntotationProperty .

skos:changeNote a owl:AnnotationProperty ;
    rdfs:label "change note" ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:subPropertyOf skos:note ;
    skos:definition "a note about a modification to a concept" .

skos:closeMatch a owl:AnnotationProperty ;
    rdfs:label "close match" ;
    rdfs:subPropertyOf tara-ap:skosAnntotationProperty .

skos:definition a owl:AnnotationProperty ;
    rdfs:label "definition" ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:subPropertyOf dcterms:description,
        tara-ap:skosAnntotationProperty,
        skos:note ;
    skos:definition "a statement or formal explanation of the meaning of a concept" .

skos:editorialNote a owl:AnnotationProperty ;
    rdfs:label "editorial note" ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:subPropertyOf skos:note ;
    skos:definition "a note for an editor, translator or maintainer of the vocabulary" .

skos:exactMatch a owl:AnnotationProperty ;
    rdfs:label "exact match" ;
    rdfs:subPropertyOf tara-ap:skosAnntotationProperty .

skos:example a owl:AnnotationProperty ;
    rdfs:label "example" ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:subPropertyOf skos:note ;
    skos:definition "an example of the use of a concept" .

skos:historyNote a owl:AnnotationProperty ;
    rdfs:label "history note" ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:subPropertyOf skos:note ;
    skos:definition "a note about the past state, use, or meaning of a concept" .

skos:narrowMatch a owl:AnnotationProperty ;
    rdfs:label "narrow match" ;
    rdfs:subPropertyOf tara-ap:skosAnntotationProperty .

skos:prefLabel a owl:AnnotationProperty ;
    rdfs:label "Preferred Label" ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:subPropertyOf tara-ap:skosAnntotationProperty,
        rdfs:label ;
    skos:definition "the preferred lexical label for a resource, in a given language" ;
    skos:note "A resource has no more than one value of skos:prefLabel per language tag, and no more than one value of skos:prefLabel without language tag.",
        "The range of skos:prefLabel is the class of RDF plain literals.",
        "skos:prefLabel, skos:altLabel and skos:hiddenLabel are pairwise disjoint properties." .

skos:relatedMatch a owl:AnnotationProperty ;
    rdfs:label "related match" ;
    rdfs:subPropertyOf tara-ap:skosAnntotationProperty .

skos:scopeNote a owl:AnnotationProperty ;
    rdfs:label "scope note" ;
    rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
    rdfs:subPropertyOf skos:note ;
    skos:definition "a note that helps to clarify the meaning and/or the use of a concept" .

foaf:depiction a owl:AnnotationProperty ;
    rdfs:label "depiction" ;
    OboInOwl:hasDbXref "http://xmlns.com/foaf/0.1/depiction" ;
    OboInOwl:is_metadata_tag true ;
    OboInOwl:shorthand "depiction" ;
    rdfs:subPropertyOf tara-ap:foafAnnotationProperty .

foaf:homepage a owl:AnnotationProperty ;
    rdfs:subPropertyOf tara-ap:foafAnnotationProperty .

foaf:mbox a owl:AnnotationProperty ;
    rdfs:subPropertyOf tara-ap:foafAnnotationProperty .

foaf:page a owl:AnnotationProperty ;
    rdfs:subPropertyOf tara-ap:foafAnnotationProperty .

BFO:0000009 a owl:Class ;
    rdfs:label "one-dimensional continuant fiat boundary" ;
    IAO:0000112 "The Equator; all geopolitical boundaries; all lines of latitude and longitude; the median sulcus of the tongue; the line separating the outer surface of the mucosa of the lower lip from the outer surface of the skin of the chin." ;
    IAO:0000115 "(Elucidation) a one-dimensional continuant fiat boundary is a continuous fiat line whose location is defined in relation to some material entity." ;
    IAO:0000119 "BFO 2020 (ISO/IEC 21838-2:2021), axiom family [032-001]." ;
    IAO:0000412 obo:bfo.owl ;
    rdfs:subClassOf BFO:0000140 ;
    owl:disjointWith BFO:0000018,
        BFO:0000146 .

BFO:0000015 a owl:Class ;
    rdfs:label "process"@en ;
    IAO:0000112 "your process of aging; the life of an organism; the flight of a bird." ;
    IAO:0000115 "p is a process = Def. p is an occurrent that has temporal proper parts and for some time t, p s-depends_on some material entity at t. (axiom label in BFO2 Reference: [083-003])"@en ;
    rdfs:comment "An occurrent that has temporal proper parts and for some time t, p s-depends_on some material entity at t."@en ;
    rdfs:subClassOf BFO:0000003 .

BFO:0000018 a owl:Class ;
    rdfs:label "zero-dimensional continuant fiat boundary" ;
    IAO:0000115 "(Elucidation) a zero-dimensional continuant fiat boundary is a fiat point whose location is defined in relation to some material entity." ;
    IAO:0000119 "BFO 2020 (ISO/IEC 21838-2:2021), axiom family [031-001]." ;
    IAO:0000412 obo:bfo.owl ;
    rdfs:subClassOf BFO:0000140 .

BFO:0000024 a owl:Class ;
    rdfs:label "fiat object part" ;
    IAO:0000112 "The upper and lower lobes of the left lung; the dorsal and ventral surfaces of the body; the Western hemisphere of the Earth; the FMA regional parts of an intact human body." ;
    IAO:0000115 "(Elucidation) A fiat object part b is a material entity which is such that for all times t, if b exists at t then there is some object c such that b is a proper continuant part of c at t and b is demarcated from the remainder of c by one or more fiat surfaces." ;
    IAO:0000119 "BFO 2020 (ISO/IEC 21838-2:2021)." ;
    IAO:0000412 obo:bfo.owl ;
    rdfs:subClassOf BFO:0000040 ;
    owl:disjointWith BFO:0000027,
        BFO:0000030 .

BFO:0000027 a owl:Class ;
    rdfs:label "object aggregate" ;
    IAO:0000115 "(Elucidation) b is an object aggregate means: b is a material entity consisting exactly of a plurality of objects as member_parts at all times at which b exists. (axiom label in BFO2 Reference: [025-004])",
        "the aggregate of blood cells in your body; defined by fiat: the aggregate of members of an organization." ;
    IAO:0000119 "BFO 2020 (ISO/IEC 21838-2:2021)." ;
    IAO:0000412 obo:bfo.owl ;
    rdfs:subClassOf BFO:0000040 .

BFO:0000030 a owl:Class ;
    rdfs:label "object" ;
    IAO:0000112 "molecule; organism; organelle; solid portions of matter." ;
    IAO:0000115 "(Elucidation) b is an object means: b is a material entity which manifests causal unity of one or other of the types CUn listed above & is of a type (a material universal) instances of which are maximal relative to this criterion of causal unity. (axiom label in BFO2 Reference: [024-001])" ;
    IAO:0000119 "BFO 2020 (ISO/IEC 21838-2:2021)." ;
    IAO:0000412 obo:bfo.owl ;
    rdfs:subClassOf BFO:0000040 .

BFO:0000067 a owl:ObjectProperty ;
    rdfs:label "contains process"@en ;
    IAO:0000111 "site of"@en ;
    IAO:0000115 "[copied from inverse property 'occurs in'] b occurs_in c =def b is a process and c is a material entity or immaterial entity& there exists a spatiotemporal region r and b occupies_spatiotemporal_region r.& forall(t) if b exists_at t then c exists_at t & there exist spatial regions s and s’ where & b spatially_projects_onto s at t& c is occupies_spatial_region s’ at t& s is a proper_continuant_part_of s’ at t"@en ;
    rdfs:comment "Paraphrase of definition: a relation between an independent continuant and a process, in which the process takes place entirely within the independent continuant" ;
    rdfs:isDefinedBy obo:bfo.owl ;
    rdfs:subPropertyOf tara-op:bfoObjectProperty .

BFO:0000146 a owl:Class ;
    rdfs:label "two-dimensional continuant fiat boundary" ;
    IAO:0000115 "(Elucidation) a two-dimensional continuant fiat boundary (surface) is a self-connected fiat surface whose location is defined in relation to some material entity." ;
    IAO:0000119 "BFO 2020 (ISO/IEC 21838-2:2021), axiom family [033-001]." ;
    IAO:0000412 obo:bfo.owl ;
    rdfs:subClassOf BFO:0000140 .

obo:COB_0000035 a owl:Class ;
    rdfs:label "completely executed planned process"@en ;
    IAO:0000412 "http://purl.obolibrary.org/obo/obi.owl"@en ;
    rdfs:subClassOf obo:COB_0000082 .

obo:COB_0000082 a owl:Class ;
    rdfs:label "planned process"@en ;
    IAO:0000115 "A process that is initiated by an agent who intends to carry out a plan to achieve an objective through one or more actions as described in a plan specification."@en ;
    IAO:0000412 "http://purl.obolibrary.org/obo/obi.owl" ;
    rdfs:subClassOf BFO:0000015 .

IAO:0000027 a owl:Class ;
    rdfs:label "data entity" ;
    IAO:0000112 "Data items include counts of things, analyte concentrations, and statistical summaries."@en ;
    IAO:0000115 "An information content entity that is intended to be one or more truthful statement(s) about something (modulo, e.g., measurement precision or other systematic errors) and is constructed/acquired by a method which reliably tends to produce (approximately) truthful statements."@en ;
    IAO:0000412 "http://purl.obolibrary.org/obo/iao.owl" ;
    rdfs:subClassOf IAO:0000030 .

IAO:0000088 a owl:Class ;
    rdfs:label "report" ;
    IAO:0000112 "Examples of reports are gene lists and investigation reports. These are not published (journal) articles but may be included in a journal article."@en ;
    IAO:0000115 "A document assembled by an author for the purpose of providing information for the audience. A report is the output of a documenting process and has the objective to be consumed by a specific audience. Topic of the report is on something that has completed. A report is not a single figure. Examples of reports are journal article, patent application, grant progress report, case report (not patient record)."@en ;
    IAO:0000119 "GROUP: OBI; OBI_0000099"@en ;
    IAO:0000412 "http://purl.obolibrary.org/obo/iao.owl"@en ;
    rdfs:subClassOf IAO:0000310 .

IAO:0000120 a owl:NamedIndividual ;
    rdfs:label "metadata complete"@en ;
    IAO:0000115 "Class has all its metadata, but is either not guaranteed to be in its final location in the asserted IS_A hierarchy or refers to another class that is not complete."@en .

IAO:0000121 a owl:NamedIndividual ;
    rdfs:label "organizational term"@en ;
    IAO:0000115 "Term created to ease viewing/sort terms for development purpose, and will not be included in a release"@en .

IAO:0000123 a owl:NamedIndividual ;
    rdfs:label "metadata incomplete"@en ;
    IAO:0000115 "Class is being worked on; however, the metadata (including definition) are not complete or sufficiently clear to the branch editors."@en .

IAO:0000124 a owl:NamedIndividual ;
    rdfs:label "uncurated"@en ;
    IAO:0000115 "Nothing done yet beyond assigning a unique class ID and proposing a preferred term."@en .

IAO:0000136 a owl:ObjectProperty ;
    rdfs:label "is about"@en ;
    rdfs:subPropertyOf tara-op:iaoObjectProperty .

IAO:0000423 a owl:NamedIndividual ;
    rdfs:label "to be replaced with external ontology term"@en ;
    IAO:0000115 "Terms with this status should eventually replaced with a term from another ontology."@en ;
    IAO:0000119 "group:OBI"@en .

IAO:0000428 a owl:NamedIndividual ;
    rdfs:label "requires discussion"@en ;
    IAO:0000115 "A term that is metadata complete, has been reviewed, and problems have been identified that require discussion before release. Such a term requires editor note(s) to identify the outstanding issues."@en ;
    IAO:0000119 "group:OBI"@en .

RO:0000081 a owl:ObjectProperty ;
    rdfs:label "role of"@en ;
    IAO:0000112 "This investigator role is role of this person. Front-Mu Point of the Lung Role isSpecialPointRoleOf LU1.",
        "this investigator role is a role of this person"@en ;
    IAO:0000115 "A relation between a role and the independent continuant that bears it, in which the role specifically depends on the bearer for its existence; the inverse of has_role (RO:0000087).",
        "a relation between a role and an independent continuant (the bearer), in which the role specifically depends on the bearer for its existence"@en ;
    IAO:0000116 "Presented here by symmetry with RO:0000087 (has_role), of which it is the formal inverse; a verbatim RO source record for this specific ID's definition text could not be independently confirmed at time of writing, so this entry should be checked against the live RO release before being treated as an exact quotation.",
        "A role inheres in its bearer at all times for which the role exists, however the role need not be realized at all the times that the role exists."@en ;
    IAO:0000118 "is role of"@en,
        "role_of"@en ;
    IAO:0000119 "OBO Relations Ontology (RO), http://purl.obolibrary.org/obo/ro.owl." ;
    IAO:0000412 obo:ro.owl ;
    rdfs:comment "This relation is modeled after the BFO relation of the same name which was in BFO2, but is used in a more restricted sense - specifically, we model this relation as functional (inherited from characteristic-of). Note that this relation is now removed from BFO2020." ;
    rdfs:subPropertyOf RO:0000052 ;
    owl:inverseOf RO:0000087 .

RO:0000091 a owl:ObjectProperty ;
    rdfs:label "has disposition"@en ;
    IAO:0000115 "a relation between an independent continuant (the bearer) and a disposition, in which the disposition specifically depends on the bearer for its existence"@en ;
    rdfs:domain BFO:0000004 ;
    rdfs:range BFO:0000016 ;
    rdfs:subPropertyOf RO:0000053 ;
    owl:inverseOf RO:0000092 .

RO:0000092 a owl:ObjectProperty ;
    rdfs:label "disposition of"@en ;
    rdfs:comment "This relation is modeled after the BFO relation of the same name which was in BFO2, but is used in a more restricted sense - specifically, we model this relation as functional (inherited from characteristic-of). Note that this relation is now removed from BFO2020." ;
    rdfs:subPropertyOf RO:0000052 .

RO:0002176 a owl:ObjectProperty ;
    rdfs:label "connects"@en ;
    IAO:0000115 "c connects a if and only if there exist some b such that a and b are similar parts of the same system, and c connects b, specifically, c connects a with b. When one structure connects two others it unites some aspect of the function or role they play within the system."@en ;
    IAO:0000412 obo:ro.owl ;
    rdfs:subPropertyOf tara-op:roObjectProperty .

RO:0002351 a owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "has member"@en ;
    IAO:0000115 "has member is a mereological relation between a collection and an item." ;
    IAO:0000119 "SIO" ;
    rdfs:subPropertyOf BFO:0000051 .

RO:0004026 a owl:ObjectProperty ;
    rdfs:label "disease has location"@en ;
    IAO:0000115 "A relationship between a disease and an anatomical entity where the disease has one or more features that are located in that entity."@en ;
    IAO:0000412 obo:ro.owl ;
    rdfs:subPropertyOf tara-op:roObjectProperty .

RO:0004029 a owl:ObjectProperty ;
    rdfs:label "disease has feature"@en ;
    IAO:0000115 "A relationship between a disease and some feature of that disease, where the feature is either a phenotype or an isolated disease."@en ;
    IAO:0000412 obo:ro.owl ;
    rdfs:subPropertyOf tara-op:roObjectProperty .

UBERON:0000003 a owl:Class ;
    rdfs:label "naris" ;
    IAO:0000115 "Orifice of the olfactory system. The naris is the route by which odorants enter the olfactory system[MAH]." ;
    OboInOwl:hasDbXref "AAO:0000311",
        "EHDAA2:0001225",
        "EHDAA:9083",
        "EMAPA:17847",
        "MA:0000282",
        "SCTID:272650008",
        "VHOG:0000663",
        "galen:Naris" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0000033 ],
        [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0005725 ],
        UBERON:0000161 .

UBERON:0000030 a owl:Class ;
    rdfs:label "lamina propria" ;
    IAO:0000115 "A thin layer of loose connective tissue which lies beneath the epithelium and together with the epithelium constitutes the mucosa[WP]. The lamina propria contains capillaries and a central lacteal (lymph vessel) in the small intestine, as well as lymphoid tissue. Lamina propria also contains glands with the ducts opening on to the mucosal epithelium, that secrete mucus and serous secretions." ;
    OboInOwl:hasDbXref "BTO:0002330",
        "FMA:62517",
        "NCIT:C32918",
        "SCTID:298225002",
        "UMLS:C1179187",
        "Wikipedia:Lamina_propria" ;
    OboInOwl:hasExactSynonym "lamina propria mucosa",
        "lamina propria mucosae" ;
    OboInOwl:hasRelatedSynonym "tunica propria" ;
