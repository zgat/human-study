<http://purl.org/tara/ontology/acupoints.owl> a owl:Ontology ;
    dc:contributor "Fahim T. Imam, PhD - https://orcid.org/0000-0003-4752-543X",
        "Ilias Ziogas, PhD - https://orcid.org/0000-0002-9210-2455",
        "Maryann E. Martone, PhD - https://orcid.org/0000-0002-8406-3871",
        "Richard Harris, PhD - https://orcid.org/0000-0002-2067-8447" ;
    dc:creator "Fahim T. Imam, PhD - https://orcid.org/0000-0003-4752-543X" ;
    dc:source "Main Source: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. https://iris.who.int/handle/10665/353407"@en,
        "Supplementary Source: Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. ISBN 978-7-119-01758-7."@en ;
    dc:title "TARA Acupoints Ontology"@en ;
    dcterms:description """The TARA Acupoints Ontology is an ontology developed as part of the Topological Atlas and Repository for Acupoint Research (TARA) project funded by the National Institute of Health (NIH). The goal of TARA is to establish a new comprehensive resource for the acupuncture research and clinician community. The ontology will be used to support semantic search and annotations for clinical trial studies, anatomical maps, atlases, and datasets relevant to the TARA project.
- About TARA Research Project: https://www.acupunctureresearch.org/tara
- TARA Ontology GitHub Repository: https://purl.org/tara/ontology/repo
- TARA Ontology Files & Updates: https://purl.org/tara/ontology/updates"""@en ;
    dcterms:issued "September 09, 2026" ;
    dcterms:license "https://creativecommons.org/licenses/by-nc-nd/4.0/" ;
    rdfs:comment """This file includes imported terms from InterLex used by the TARA Acupoints Ontology. It includes the basic hierarchy and the partnomy of the imported terms.
-  TARA Ontology Termset: http://uri.interlex.org/base/ilx_0795339""",
        """This file includes an upper-level reference module for the TARA Acupoints Ontology. It contains a subset of the Basic Formal Ontology (BFO) and a minimal subset of object properties from the Relations Ontology (BFO/RO Core). For metadata/annotation properties, it includes a subset of the Information Artifact Ontology (IAO).
- About RO Core: https://github.com/oborel/obo-relations/wiki/ROCore
- About BFO: https://obofoundry.org/ontology/bfo.html
- About IAO: https://github.com/information-artifact-ontology/IAO"""@en,
        """This file includes imported subset of UBERON, specific to the TARA Acupoints Ontology.
- Hierarchy up to UBERON:0001062 (anatomical entity) 
- CL, GO, NCBITaxon, and PATO classes excluded
- OWL Axioms: Only named-class subClassOf restrictions for:
    - BFO:0000050 (part_of), RO_0001025 (located_in)
    - RO:0002170 (connected_to), and BFO:0000051 (has_part)"""@en ;
    owl:priorVersion "1.7.0" ;
    owl:versionIRI <http://purl.org/tara/ontology/release/1.7.2/asserted/acupoints.ttl> ;
    owl:versionInfo "1.7.2 - Asserted Ontology" .

protege:defaultLanguage a owl:AnnotationProperty .

BFO:0000029 a owl:Class ;
    rdfs:label "site" ;
    IAO:0000112 "a rabbit hole; a hole in the interior of a portion of cheese; an air traffic control region defined in the airspace above an airport; the lumen of your gut." ;
    IAO:0000115 "(Elucidation) b is a site means: b is a three-dimensional immaterial entity that is (partially or wholly) bounded by a material entity or it is a three-dimensional immaterial part thereof. (axiom label in BFO2 Reference: [034-002])" ;
    IAO:0000119 "BFO 2020 (ISO/IEC 21838-2:2021)." ;
    IAO:0000412 obo:bfo.owl ;
    rdfs:subClassOf BFO:0000141 ;
    owl:disjointWith BFO:0000140 .

