    tara-ap:hasSynonym "S 18",
        "Stomach 18" ;
    tara-ap:hasVasculatureInformation "The branches of the intercostal artery and vein." ;
    tara-ap:isLocatedOnMeridian TARA:6221269 ;
    rdfs:subClassOf [ a owl:Restriction ;
