dcterms:instructionalMethod a owl:AnnotationProperty ;
    rdfs:label "Instructional Method"@en ;
    rdfs:comment "Instructional Method will typically include ways of presenting instructional materials or conducting instructional activities, patterns of learner-to-learner and learner-to-instructor interactions, and mechanisms by which group and individual levels of learning are measured. Instructional methods include all aspects of the instruction and learning processes from planning and implementation through evaluation and feedback."@en ;
    rdfs:subPropertyOf tara-ap:dctermsMetadata ;
    skos:definition "A process, used to engender knowledge, attitudes and skills, that the described resource is designed to support."@en .

dcterms:isReferencedBy a owl:AnnotationProperty ;
    rdfs:label "Is Referenced By"@en ;
    rdfs:subPropertyOf dcterms:relation ;
    skos:definition "A related resource that references, cites, or otherwise points to the described resource."@en ;
    skos:note "This term is intended to be used with non-literal values as defined in the DCMI Abstract Model (http://dublincore.org/documents/abstract-model/). As of December 2007, the DCMI Usage Board is seeking a way to express this intention with a formal range declaration."@en .

dcterms:isReplacedBy a owl:AnnotationProperty ;
    rdfs:label "Is Replaced By"@en ;
    rdfs:subPropertyOf dcterms:relation ;
    skos:definition "A related resource that supplants, displaces, or supersedes the described resource."@en ;
    skos:note "This term is intended to be used with non-literal values as defined in the DCMI Abstract Model (http://dublincore.org/documents/abstract-model/). As of December 2007, the DCMI Usage Board is seeking a way to express this intention with a formal range declaration."@en .

dcterms:isRequiredBy a owl:AnnotationProperty ;
    rdfs:label "Is Required By"@en ;
    rdfs:subPropertyOf dcterms:relation ;
    skos:definition "A related resource that requires the described resource to support its function, delivery, or coherence."@en ;
    skos:note "This term is intended to be used with non-literal values as defined in the DCMI Abstract Model (http://dublincore.org/documents/abstract-model/). As of December 2007, the DCMI Usage Board is seeking a way to express this intention with a formal range declaration."@en .

dcterms:isVersionOf a owl:AnnotationProperty ;
    rdfs:label "Is Version Of"@en ;
    rdfs:comment "Changes in version imply substantive changes in content rather than differences in format."@en ;
    rdfs:subPropertyOf dcterms:relation ;
    skos:definition "A related resource of which the described resource is a version, edition, or adaptation."@en ;
    skos:note "This term is intended to be used with non-literal values as defined in the DCMI Abstract Model (http://dublincore.org/documents/abstract-model/). As of December 2007, the DCMI Usage Board is seeking a way to express this intention with a formal range declaration."@en .

dcterms:issued a owl:AnnotationProperty ;
    rdfs:label "Date Issued"@en ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf dcterms:date ;
    skos:definition "Date of formal issuance (e.g., publication) of the resource."@en .

dcterms:license a owl:AnnotationProperty ;
    rdfs:label "License"@en ;
    rdfs:range dcterms:LicenseDocument ;
    rdfs:subPropertyOf dcterms:rights ;
    skos:definition "A legal document giving official permission to do something with the resource."@en .

dcterms:medium a owl:AnnotationProperty ;
    rdfs:label "Medium"@en ;
    rdfs:domain dcterms:PhysicalResource ;
    rdfs:range dcterms:PhysicalMedium ;
    rdfs:subPropertyOf dcterms:format ;
    skos:definition "The material or physical carrier of the resource."@en .

dcterms:modified a owl:AnnotationProperty ;
    rdfs:label "Date Modified"@en ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf dcterms:date ;
    skos:definition "Date on which the resource was changed."@en .

dcterms:provenance a owl:AnnotationProperty ;
    rdfs:label "Provenance"@en ;
    rdfs:comment "The statement may include a description of any changes successive custodians made to the resource."@en ;
    rdfs:subPropertyOf tara-ap:dctermsMetadata ;
    skos:definition "A statement of any changes in ownership and custody of the resource since its creation that are significant for its authenticity, integrity, and interpretation."@en .

dcterms:publisher a owl:AnnotationProperty ;
    rdfs:label "Publisher"@en ;
    rdfs:comment "Examples of a Publisher include a person, an organization, or a service. Typically, the name of a Publisher should be used to indicate the entity."@en ;
    rdfs:range dcterms:Agent ;
    rdfs:subPropertyOf dc:publisher ;
    skos:definition "An entity responsible for making the resource available."@en .

dcterms:references a owl:AnnotationProperty ;
    rdfs:label "References"@en ;
    rdfs:subPropertyOf dcterms:relation ;
    skos:definition "A related resource that is referenced, cited, or otherwise pointed to by the described resource."@en ;
    skos:note "This term is intended to be used with non-literal values as defined in the DCMI Abstract Model (http://dublincore.org/documents/abstract-model/). As of December 2007, the DCMI Usage Board is seeking a way to express this intention with a formal range declaration."@en .

dcterms:replaces a owl:AnnotationProperty ;
    rdfs:label "Replaces"@en ;
    rdfs:subPropertyOf dcterms:relation ;
    skos:definition "A related resource that is supplanted, displaced, or superseded by the described resource."@en ;
    skos:note "This term is intended to be used with non-literal values as defined in the DCMI Abstract Model (http://dublincore.org/documents/abstract-model/). As of December 2007, the DCMI Usage Board is seeking a way to express this intention with a formal range declaration."@en .

dcterms:requires a owl:AnnotationProperty ;
    rdfs:label "Requires"@en ;
    rdfs:subPropertyOf dcterms:relation ;
    skos:definition "A related resource that is required by the described resource to support its function, delivery, or coherence."@en ;
    skos:note "This term is intended to be used with non-literal values as defined in the DCMI Abstract Model (http://dublincore.org/documents/abstract-model/). As of December 2007, the DCMI Usage Board is seeking a way to express this intention with a formal range declaration."@en .

dcterms:rightsHolder a owl:AnnotationProperty ;
    rdfs:label "Rights Holder"@en ;
    rdfs:subPropertyOf tara-ap:dctermsMetadata ;
    skos:definition "A person or organization owning or managing rights over the resource."@en .

dcterms:source a owl:AnnotationProperty ;
    rdfs:label "Source"@en ;
    rdfs:comment "The described resource may be derived from the related resource in whole or in part. Recommended best practice is to identify the related resource by means of a string conforming to a formal identification system."@en ;
    rdfs:subPropertyOf dc:source,
        dcterms:relation ;
    skos:definition "A related resource from which the described resource is derived."@en ;
    skos:note "This term is intended to be used with non-literal values as defined in the DCMI Abstract Model (http://dublincore.org/documents/abstract-model/). As of December 2007, the DCMI Usage Board is seeking a way to express this intention with a formal range declaration."@en .

dcterms:spatial a owl:AnnotationProperty ;
    rdfs:label "Spatial Coverage"@en ;
    rdfs:range dcterms:Location ;
    rdfs:subPropertyOf dcterms:coverage ;
    skos:definition "Spatial characteristics of the resource."@en .

dcterms:subject a owl:AnnotationProperty ;
    rdfs:label "Subject"@en ;
    rdfs:comment "Typically, the subject will be represented using keywords, key phrases, or classification codes. Recommended best practice is to use a controlled vocabulary. To describe the spatial or temporal topic of the resource, use the Coverage element."@en ;
    rdfs:subPropertyOf dc:subject ;
    skos:definition "The topic of the resource."@en ;
    skos:note "This term is intended to be used with non-literal values as defined in the DCMI Abstract Model (http://dublincore.org/documents/abstract-model/). As of December 2007, the DCMI Usage Board is seeking a way to express this intention with a formal range declaration."@en .

dcterms:tableOfContents a owl:AnnotationProperty ;
    rdfs:label "table of contents" ;
    rdfs:subPropertyOf dcterms:description ;
    skos:definition "A list of subunits of the resource." .

dcterms:temporal a owl:AnnotationProperty ;
    rdfs:label "Temporal Coverage"@en ;
    rdfs:range dcterms:PeriodOfTime ;
    rdfs:subPropertyOf dcterms:coverage ;
    skos:definition "Temporal characteristics of the resource."@en .

dcterms:type a owl:AnnotationProperty ;
    rdfs:label "Type"@en ;
    rdfs:comment "Recommended practice is to use a controlled vocabulary such as the DCMI Type Vocabulary [DCMI-TYPE]. To describe the file format, physical medium, or dimensions of the resource, use the property Format."@en ;
    rdfs:subPropertyOf dc:type ;
    skos:definition "The nature or genre of the resource."@en .

dcterms:valid a owl:AnnotationProperty ;
    rdfs:label "Date Valid"@en ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf dcterms:date ;
    skos:definition "Date (often a range) of validity of a resource."@en .

TARA:0674193 a owl:Class ;
    rdfs:label "Pigen" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.",
        "[Additional Synonyms] Acupuncture: A Comprehensive Text. Shanghai College of Traditional Medicine. Translated and edited by J. O'Connor and D. Bensky. Chicago: Eastland Press, 1981. Section II, Ch. 8: Other New and Miscellaneous Points." ;
    tara-ap:hasListedIndications "hepatosplenomegaly",
        "lumbar pain" ;
    tara-ap:hasLocationalDescription "3.5 cun lateral to the lower border of the spinous process of the first lumbar vertebra." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.5-0.8 inch. Moxibustion is applicable." ;
    tara-ap:hasSynonym "EX-B 4",
        "M-BW 16" ;
    rdfs:subClassOf TARA:3535998 .

TARA:0739106 a owl:Class ;
    rdfs:label "Liver Meridian Acupoint" ;
    dcterms:bibliographicCitation "WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. https://iris.who.int/handle/10665/353407" ;
    dcterms:description "An acupuncture point that is located along the Liver Meridian of Foot-Jueyin (LR), which consists of 14 standardized acupoints beginning at LR 1 (Dadun) on the lateral side of the great toe near the corner of the nail, traveling up along the medial aspect of the leg and passing through the genital region and abdomen, and ending at LR 14 (Qimen) on the anterior chest in the sixth intercostal space." ;
    tara-ap:hasSynonym "Acupoint of Liver Meridian",
        "Acupoint of the Liver Meridian",
        "Acupoint of the liver meridian of foot-jueyin",
        "Acupuncture point of the liver meridian",
        "Acupuncture point of the liver meridian of foot-jueyin",
        "LR Acupoint" ;
    tara-ap:isLocatedOnMeridian TARA:5419503 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( TARA:5151019 [ a owl:Restriction ;
                        owl:onProperty tara-op:isLocatedOnMeridian ;
                        owl:someValuesFrom TARA:5419503 ] ) ] .

TARA:0995552 a owl:Class ;
    rdfs:label "Bladder Meridian Acupoint" ;
    dcterms:bibliographicCitation "WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. https://iris.who.int/handle/10665/353407" ;
    dcterms:description "An acupuncture point that is located along the Bladder Meridian of Foot-Taiyang (BL), which consists of 67 standardized acupoints beginning at BL 1 (Jingming) on the face in the depression just superior to the inner canthus of the eye, traveling up over the head, descending down the back in two parallel lines flanking the spine, and continuing along the posterior aspect of the leg, ending at BL 67 (Zhiyin) on the lateral side of the little toe near the corner of the nail." ;
    tara-ap:hasSynonym "Acupoint of Bladder Meridian",
        "Acupoint of the Bladder Meridian",
        "Acupoint of the bladder meridian of foot-taiyang",
        "Acupuncture point of the bladder meridian",
        "Acupuncture point of the bladder meridian of foot-taiyang",
        "Acupuncture point of the urinary bladder meridian",
        "BL Acupoint",
        "UB Acupoint" ;
    tara-ap:isLocatedOnMeridian TARA:7525476 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( TARA:5151019 [ a owl:Restriction ;
                        owl:onProperty tara-op:isLocatedOnMeridian ;
                        owl:someValuesFrom TARA:7525476 ] ) ] .

TARA:1092703 a owl:Class ;
    rdfs:label "Conception Vessel Acupoint" ;
    dcterms:bibliographicCitation "WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. https://iris.who.int/handle/10665/353407" ;
    dcterms:description "An acupuncture point that is located along the Conception Vessel (CV / Ren Mai), one of the eight extraordinary vessels, which consists of 24 standardized acupoints beginning at CV 1 (Huiyin) in the perineum at the midpoint of the perineal region, traveling up along the anterior midline of the body through the abdomen, chest, and neck, and ending at CV 24 (Chengjiang) on the face in the depression at the center of the mentolabial sulcus." ;
    tara-ap:hasSynonym "Acupoint of Conception Vessel",
        "Acupoint of Ren Channel",
        "Acupoint of the Conception Vessel",
        "Acupoint of the Ren channel",
        "Acupouncture point of the Conception Vessel",
        "Acupuncture point of the Ren channel",
        "CV Acupoint",
        "RN Acupoint",
        "Ren Acupoint" ;
    tara-ap:isLocatedOnMeridian TARA:6789717 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( TARA:5151019 [ a owl:Restriction ;
                        owl:onProperty tara-op:isLocatedOnMeridian ;
                        owl:someValuesFrom TARA:6789717 ] ) ] .

TARA:1194553 a owl:Class ;
    rdfs:label "Heart Meridian Acupoint" ;
    dcterms:bibliographicCitation "WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. https://iris.who.int/handle/10665/353407" ;
    dcterms:description "An acupuncture point that is located along the Heart Meridian of Hand-Shaoyin (HT), which consists of 9 standardized acupoints beginning at HT 1 (Jiquan) in the center of the axillary fossa, traveling down the medial aspect of the arm, and ending at HT 9 (Shaochong) on the radial side of the little finger near the corner of the nail." ;
    tara-ap:hasSynonym "Acupoint of Heart Meridian",
        "Acupoint of the Heart Meridian",
        "Acupoint of the heart meridian of hand-shaoyin",
        "Acupuncture point of the heart meridian",
        "Acupuncture point of the heart meridian of hand-shaoyin",
        "HT Acupoint" ;
    tara-ap:isLocatedOnMeridian TARA:9474009 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( TARA:5151019 [ a owl:Restriction ;
                        owl:onProperty tara-op:isLocatedOnMeridian ;
                        owl:someValuesFrom TARA:9474009 ] ) ] .

TARA:1216325 a owl:Class ;
    rdfs:label "Zhongquan" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.",
        "[Additional Synonyms] Acupuncture: A Comprehensive Text. Shanghai College of Traditional Medicine. Translated and edited by J. O'Connor and D. Bensky. Chicago: Eastland Press, 1981. Section II, Ch. 8: Other New and Miscellaneous Points." ;
    tara-ap:hasListedIndications "gastric pain",
        "spitting of blood",
        "stuffy chest" ;
    tara-ap:hasLocationalDescription "On the dorsal crease of the wrist, in the depression on the radial side of the tendon of common extensor muscle of fingers between Yangxi (Ll 5) and Yangchi (TE 4)." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.3-0.5 inch. Moxibustion is applicable." ;
    tara-ap:hasSynonym "EX-UE 3",
        "M-UE 33" ;
    rdfs:subClassOf TARA:3535998 .

TARA:1317363 a owl:Class ;
    rdfs:label "Erbai" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.",
        "[Additional Synonyms] Acupuncture: A Comprehensive Text. Shanghai College of Traditional Medicine. Translated and edited by J. O'Connor and D. Bensky. Chicago: Eastland Press, 1981. Section II, Ch. 8: Other New and Miscellaneous Points." ;
    tara-ap:hasListedIndications "hemorrhoids",
        "prolapse of the rectum" ;
    tara-ap:hasLocationalDescription "On the metacarpal aspect of the forearm, 4 cun above the transverse wrist crease, on the both sides of the tendon of m. flexor carpi radialis, two points on one hand." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.5- 1.0 inch. Moxibustion is applicable." ;
    tara-ap:hasSynonym "EX-UE 2",
        "M-UE 29" ;
    rdfs:subClassOf TARA:3535998 .

TARA:1338884 a owl:Class ;
    rdfs:label "Jiachengjiang" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.",
        "[Additional Synonyms] Acupuncture: A Comprehensive Text. Shanghai College of Traditional Medicine. Translated and edited by J. O'Connor and D. Bensky. Chicago: Eastland Press, 1981. Section II, Ch. 8: Other New and Miscellaneous Points." ;
    tara-ap:hasListedIndications "deviation of the eye",
        "deviation of the mouth",
        "pain in the face",
        "spasm of facial muscle" ;
    tara-ap:hasLocationalDescription "1 cun lateral to Chengjiang (CV 24)." ;
    tara-ap:hasMethodDescription "Puncture obliquely 0.5-1.0 inch.." ;
    tara-ap:hasSynonym "M-HN 18" ;
    rdfs:subClassOf TARA:3535998 .

TARA:1459681 a owl:Class ;
    rdfs:label "Lung Meridian Acupoint" ;
    dcterms:bibliographicCitation "WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. https://iris.who.int/handle/10665/353407" ;
    dcterms:description "An acupuncture point that is located along the Lung Meridian of Hand-Taiyin (LU), which consists of 11 standardized acupoints beginning at LU 1 (Zhongfu) on the upper anterior chest lateral to the infraclavicular fossa, traveling down the anterior-lateral aspect of the arm, and ending at LU 11 (Shaoshang) on the radial side of the thumb near the corner of the nail." ;
    tara-ap:hasSynonym "Acupoint of Lung Meridian",
        "Acupoint of the Lung Meridian",
        "Acupoint of the lung meridian of hand-taiyin",
        "Acupuncture point of the lung meridian",
        "Acupuncture point of the lung meridian of hand-taiyin",
        "LU Acupoint" ;
    tara-ap:isLocatedOnMeridian TARA:9964503 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( TARA:5151019 [ a owl:Restriction ;
                        owl:onProperty tara-op:isLocatedOnMeridian ;
                        owl:someValuesFrom TARA:9964503 ] ) ] .

TARA:1926756 a owl:Class ;
    rdfs:label "Gallbladder Meridian Acupoint" ;
    dcterms:bibliographicCitation "WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. https://iris.who.int/handle/10665/353407" ;
    dcterms:description "An acupuncture point that is located along the Gallbladder Meridian of Foot-Shaoyang (GB), which consists of 44 standardized acupoints beginning at GB 1 (Tongziliao) on the head in the depression lateral to the outer canthus of the eye, zigzagging across the temporal and occipital regions of the head and descending along the lateral side of the neck, trunk, and leg, and ending at GB 44 (Zuqiaoyin) on the lateral side of the fourth toe near the corner of the nail." ;
    tara-ap:hasSynonym "Acupoint of Gallbladder Meridian",
        "Acupoint of the Gallbladder Meridian",
        "Acupoint of the gallbladder meridian of foot-shaoyang",
        "Acupuncture point of the gallbladder meridian",
        "Acupuncture point of the gallbladder meridian of foot-shaoyang",
        "GB Acupoint" ;
    tara-ap:isLocatedOnMeridian TARA:5283975 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( TARA:5151019 [ a owl:Restriction ;
                        owl:onProperty tara-op:isLocatedOnMeridian ;
                        owl:someValuesFrom TARA:5283975 ] ) ] .

TARA:2063814 a owl:Class ;
    rdfs:label "Shixuan" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.",
        "[Additional Synonyms] Acupuncture: A Comprehensive Text. Shanghai College of Traditional Medicine. Translated and edited by J. O'Connor and D. Bensky. Chicago: Eastland Press, 1981. Section II, Ch. 8: Other New and Miscellaneous Points." ;
    tara-ap:hasListedIndications "acute tonsillitis",
        "apoplexy",
        "coma",
        "epilepsy",
        "high fever",
        "infantile convulsion",
        "numbness of the finger tips" ;
    tara-ap:hasLocationalDescription "On the tips of the ten fingers, about 0.1 cun distal to the nails." ;
    tara-ap:hasMethodDescription "Puncture 0.1-0.2 inch superficially, or prick to cause bleeding." ;
    tara-ap:hasSynonym "EX-UE 11",
        "M-UE 49",
        "Shiwang" ;
    rdfs:subClassOf TARA:3535998 .

TARA:2358051 a owl:Class ;
    rdfs:label "Shanglianquan" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.",
        "[Additional Synonyms] Acupuncture: A Comprehensive Text. Shanghai College of Traditional Medicine. Translated and edited by J. O'Connor and D. Bensky. Chicago: Eastland Press, 1981. Section II, Ch. 8: Other New and Miscellaneous Points." ;
    tara-ap:hasListedIndications "alalia",
        "difficulty in swallowing",
        "loss of voice",
        "salivation with stiff tongue",
        "sore throat" ;
    tara-ap:hasLocationalDescription "1 cun below the midpoint of the lower jaw, in the depression between the hyoid bone and the lower border of the jaw." ;
    tara-ap:hasMethodDescription "Puncture obliquely 0.8-1.2 inches toward the tongue root." ;
    tara-ap:hasSynonym "M-HN 21" ;
    rdfs:subClassOf TARA:3535998 .

TARA:2491709 a owl:Class ;
    rdfs:label "Baxie" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.",
        "[Additional Synonyms] Acupuncture: A Comprehensive Text. Shanghai College of Traditional Medicine. Translated and edited by J. O'Connor and D. Bensky. Chicago: Eastland Press, 1981. Section II, Ch. 8: Other New and Miscellaneous Points." ;
    tara-ap:hasListedIndications "contracture of the fingers",
        "excessive heat",
        "finger numbness",
        "redness of the dorsum of the hand",
        "spasm of the fingers",
        "swelling of the dorsum of the hand" ;
    tara-ap:hasLocationalDescription "On the dorsum of the hand, at the junction of the white and red skin of the hand webs, eight in all, making a loose fist to locate the points." ;
    tara-ap:hasMethodDescription "Puncture obliquely 0.3-0.5 inch, or prick to cause bleeding. Moxibustion is applicable." ;
    tara-ap:hasSynonym "EX-UE 9",
        "M-UE 22" ;
    rdfs:subClassOf TARA:3535998 .

TARA:2581598 a owl:Class ;
    rdfs:label "Qianzheng" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.",
        "[Additional Synonyms] Acupuncture: A Comprehensive Text. Shanghai College of Traditional Medicine. Translated and edited by J. O'Connor and D. Bensky. Chicago: Eastland Press, 1981. Section II, Ch. 8: Other New and Miscellaneous Points." ;
    tara-ap:hasListedIndications "deviation of the eye",
        "deviation of the mouth",
        "ulceration on mouth",
        "ulceration on tongue" ;
    tara-ap:hasLocationalDescription "0.5-1.0 cun anterior to the auricular lobe." ;
    tara-ap:hasMethodDescription "Puncture obliquely 0.5- 1.0 inch." ;
    tara-ap:hasSynonym "N-HN 20" ;
    rdfs:subClassOf TARA:3535998 .

TARA:2630570 a owl:Class ;
    rdfs:label "Yaoyan" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.",
        "[Additional Synonyms] Acupuncture: A Comprehensive Text. Shanghai College of Traditional Medicine. Translated and edited by J. O'Connor and D. Bensky. Chicago: Eastland Press, 1981. Section II, Ch. 8: Other New and Miscellaneous Points." ;
    tara-ap:hasListedIndications "frequency of urine",
        "irregular menstruation",
        "lumbar pain" ;
    tara-ap:hasLocationalDescription "About 3.5-4 cun lateral to the lower border of the spinous process of the 4th lumbar vertebra. The point is in the depression appearing in prone position." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.8-1.2 inches. Moxibustion is applicable." ;
    tara-ap:hasSynonym "EX-B 7",
        "M-BW 24" ;
    rdfs:subClassOf TARA:3535998 .

TARA:3135569 a owl:Class ;
    rdfs:label "Yintang" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.",
        "[Additional Synonyms] Acupuncture: A Comprehensive Text. Shanghai College of Traditional Medicine. Translated and edited by J. O'Connor and D. Bensky. Chicago: Eastland Press, 1981. Section II, Ch. 8: Other New and Miscellaneous Points." ;
    tara-ap:hasListedIndications "epistaxis",
        "frontal headache",
        "head heaviness",
        "headache",
        "infantile convulsion",
        "insomnia",
        "rhinorrhea" ;
    tara-ap:hasLocationalDescription "Midway between the medial ends of the two eyebrows." ;
    tara-ap:hasMethodDescription "Puncture subcutaneously 0.3-0.5 inch. Moxibustion is applicable." ;
    tara-ap:hasSynonym "EX-HN 3",
        "M-HN 3",
        "Yingtang" ;
    rdfs:subClassOf TARA:3535998 .

TARA:3145377 a owl:Class ;
    rdfs:label "Dannangxue" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.",
        "[Additional Synonyms] Acupuncture: A Comprehensive Text. Shanghai College of Traditional Medicine. Translated and edited by J. O'Connor and D. Bensky. Chicago: Eastland Press, 1981. Section II, Ch. 8: Other New and Miscellaneous Points." ;
    tara-ap:hasListedIndications "acute cholecystitis",
        "biliary ascariasis",
        "cholelithiasis",
        "chronic cholecystitis",
        "muscular atrophy of the lower extremities",
        "numbness of the lower extremities" ;
    tara-ap:hasLocationalDescription "The tender spot 1-2 cun directly below Yanglingquan (GB 34)." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.8-1.2 inches." ;
    tara-ap:hasSynonym "EX-LE 6",
        "M-LE 23" ;
    rdfs:subClassOf TARA:3535998 .

TARA:3452202 a owl:Class ;
    rdfs:label "Small Intestine Meridian Acupoint" ;
    dcterms:bibliographicCitation "WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. https://iris.who.int/handle/10665/353407" ;
    dcterms:description "An acupuncture point that is located along the Small Intestine Meridian of Hand-Taiyang (SI), which consists of 19 standardized acupoints beginning at SI 1 (Shaoze) on the ulnar side of the little finger near the corner of the nail, traveling up the dorsal-ulnar aspect of the arm, across the scapular region, and ascending along the lateral neck and cheek, and ending at SI 19 (Tinggong) in the depression between the tragus and the mandibular condyloid process." ;
    tara-ap:hasSynonym "Acupoint of Small Intestine Meridian",
        "Acupoint of the Small Intestine Meridian",
        "Acupoint of the small intestine meridian of hand-taiyang",
        "Acupuncture point of the small intestine meridian",
        "Acupuncture point of the small intestine meridian of hand-taiyang",
        "SI Acupoint" ;
    tara-ap:isLocatedOnMeridian TARA:9093316 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( TARA:5151019 [ a owl:Restriction ;
                        owl:onProperty tara-op:isLocatedOnMeridian ;
                        owl:someValuesFrom TARA:9093316 ] ) ] .

TARA:3480360 a owl:Class ;
    rdfs:label "Anmian" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.",
        "[Additional Synonyms] Acupuncture: A Comprehensive Text. Shanghai College of Traditional Medicine. Translated and edited by J. O'Connor and D. Bensky. Chicago: Eastland Press, 1981. Section II, Ch. 8: Other New and Miscellaneous Points." ;
    tara-ap:hasListedIndications "headache",
        "insomnia",
        "mental disorders",
        "palpitation",
        "vertigo" ;
    tara-ap:hasLocationalDescription "Midpoint between Yifeng (TE 17) and Fengchi (GB 20)." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.5-0.8 inch." ;
    tara-ap:hasSynonym "N-HN 54" ;
    rdfs:subClassOf TARA:3535998 .

TARA:3641900 a owl:Class ;
    rdfs:label "Jinjing" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.",
        "[Additional Synonyms] Acupuncture: A Comprehensive Text. Shanghai College of Traditional Medicine. Translated and edited by J. O'Connor and D. Bensky. Chicago: Eastland Press, 1981. Section II, Ch. 8: Other New and Miscellaneous Points." ;
    tara-ap:hasListedIndications "aphasia with stiffness of tongue",
        "swelling of the tongue",
        "vomiting" ;
    tara-ap:hasLocationalDescription "On the veins on both sides of the frenulum of the tongue, Jinjin is on the left, Yuye, on the right." ;
    tara-ap:hasMethodDescription "Prick to cause bleeding." ;
    tara-ap:hasSynonym "EX-HN 12",
        "Jinjin",
        "M-HN 20a" ;
    rdfs:subClassOf TARA:3535998 .

