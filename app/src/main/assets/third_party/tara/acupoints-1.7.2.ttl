TARA:3493245 a owl:Class ;
    rdfs:label "GB 19" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 181. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 9, Acupuncture Points of the Jueyin and Shaoyang Meridians. ISBN 978-7-119-01758-7." ;
    tara-ap:hasChineseLabel "腦(脑,脳)空" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0000033 ;
    tara-ap:hasListedIndications "epilepsy",
        "headache",
        "painful eye",
        "stiffness of the neck",
        "tinnitus",
        "vertigo" ;
    tara-ap:hasLocationalDescription """On the head, at the same level as the superior border of the external occipital protuberance, directly superior to GB 20.
 - Note: GB 19 is at the same level as GV 17 and BL 9.""" ;
    tara-ap:hasMethodDescription "Puncture subcutaneously 0.3-0.5 inch. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Naokong" ;
    tara-ap:hasSpecificReferenceLocation UBERON:0013469 ;
