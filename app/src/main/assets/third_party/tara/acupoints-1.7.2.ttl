UBERON:0010212 a owl:Class ;
    rdfs:label "laryngeal apparatus" ;
    IAO:0000115 "Apparatus located between the lungs and the buccal cavity. This apparatus is composed of a pair of arytenoid cartilages that are supported by the cricoid ring." ;
    IAO:0000116 "check this. See also https://github.com/obophenotype/uberon/wiki/The-axial-skeleton" ;
    OboInOwl:hasDbXref "AAO:0000267",
