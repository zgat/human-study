UBERON:5101463 a owl:Class ;
    rdfs:label "manual digit 1 digitopodial skeleton" ;
    IAO:0000115 "A subdivision of the skeleton of the autopod consisting of the phalanges of manual digit 1 plus the associated metapodial element." ;
    IAO:0000232 "this class represents a series of phalanges plus a metapodial element. In comparative anatomy terminology we would call this a 'digit', but the label 'digit' is sometimes used to exclude metapodials and to include soft tissue. This series of elements is hypothesized to be homologous to radials." ;
    OboInOwl:hasExactSynonym "manual digit I digitopodial skeleton" ;
    OboInOwl:hasRelatedSynonym "manual digit 1",
        "manual digit 1 skeleton" ;
